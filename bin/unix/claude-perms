#!/usr/bin/env bash
# claude-perms: .claude/settings.local.json の permissions を整理するヘルパー
#
# 使い方:
#   claude-perms format [DIR...]    permissions.allow/deny/ask を正規化・ソート・
#                                    重複削除し、allow のうち ~/.claude/settings.json
#                                    （グローバル）のルールで既にカバーされているものを
#                                    削除して書き戻す。整理後に permissions が
#                                    {"allow": []} だけになったら settings.local.json を
#                                    削除し、.claude/ が空になればそれも削除する
#   claude-perms check [DIR...]     整理が必要かどうかだけ確認する（書き換えない）
#   claude-perms candidates [DIR...] グローバルにまだ無い（＝カバーされていない）
#                                    ローカル allow エントリを一覧表示する
#                                    （移管するかどうかの判断はユーザーが行い、
#                                    実際の追加は手動で行う。削除は format が行う）
#   claude-perms format-global      ~/.claude/settings.json （グローバル）自体の
#                                    permissions.allow/deny/ask を正規化・ソート・
#                                    重複削除する。グローバルより上位は無いのでカバー済み
#                                    判定は行わず、permissionsが空になっても他のキー
#                                    （model等）を持つ本体設定ファイルなので削除もしない。
#                                    DIR引数は取らない
#   claude-perms remove <pattern> [DIR...] [--glob] [--apply|-y]
#                                    allow/deny/askからpatternに一致するエントリを探す。
#                                    既定（厳密一致）: pattern・エントリ双方を正規化
#                                    （下記）した上で完全一致するものだけを対象にする
#                                    （例: pattern "run-quiet *" は "Bash(run-quiet:*)"
#                                    には一致するが "Bash(run-quiet make:*)" には一致
#                                    しない）。--glob指定時はpatternをbashのglob
#                                    （*, ?等）としてエントリ文字列全体に対して評価する。
#                                    既定はdry-run（一致内容の表示のみ）。実際に削除
#                                    するには --apply（または -y）を付ける
#   claude-perms remove-global <pattern> [--glob] [--apply|-y]
#                                    removeと同じ判定を ~/.claude/settings.json
#                                    （グローバル）自体に対して行う。DIR引数は取らない
#
# 正規化: Bash/PowerShellルールの末尾が半角スペース+"*"（例: "gh *"）の場合、
# 同義の ":*" 形式（例: "gh:*"）へ書き換える（format/format-global/remove系すべて共通）。
# 参考: https://code.claude.com/docs/en/permissions.md
#   "The `:*` suffix is an equivalent way to write a trailing wildcard"
#
# 禁止エントリ: ~/.claude/claude-perms.json（Claude Code本体は読まない、claude-perms
# 専用の設定）の forbiddenAllow に列挙したエントリは、format/format-globalが
# ローカル・グローバルどちらのallowからも厳密一致（正規化後）で自動削除する。例えば
# "run-quiet:*" のような「何でも実行できてしまう」 blanket allow を、"run-quiet make:*"
# のような個別のスコープ付きallowは残したまま消したい場合に使う（前方一致の
# カバー判定だと "run-quiet make:*" まで巻き込んでしまうため、ここだけ厳密一致にしている）。
# ファイルが無ければ禁止リストなしとして扱う（自動作成しない）。
#   例: {"forbiddenAllow": ["Bash(run-quiet:*)"]}
#
# DIR は複数指定できる（format-global を除く）。省略時はカレントディレクトリ1件のみを対象にする。
# 各 DIR の対象は DIR/.claude/settings.local.json。settings.local.json が無い DIR は
# 通常の状態として無視する（エラーにしない）。--verbose 指定時だけ、無視した旨を表示する。
# settings.local.json 自体が壊れたJSONの場合は、パスと jq のエラーを添えて常に報告し、
# その DIR だけ失敗扱いにして他の DIR の処理は続行する。
#
# claude-perms shell {on|off|status}   cd時の check 自動実行をon/off（既定off）。
#                                       shell/zshrc のシェル関数が提供するサブコマンドで
#                                       このスクリプト本体には実装していない
#                                       （現在のシェルの環境変数を直接操作する必要があるため）。
#
# 「グローバルのルールでカバーされている」の判定
# （Claude Code本体のワイルドカード仕様 https://code.claude.com/docs/en/permissions.md
#   の "Wildcard patterns" に合わせている）:
#   - 完全一致（例: 両方とも "Bash(gh:*)"）
#   - ツール名のみのグローバルルール（例: "Bash"）は同ツールの全ルールを包含
#   - "Tool(prefix:*)" と "Tool(prefix *)"（コロン/半角スペース + *）は同義の
#     単語境界つき前方一致。グローバルの "Bash(gh:*)" や "Bash(gh *)" は
#     ローカルの "Bash(gh api:*)" や "Bash(gh api repo list)" を包含するが、
#     単語境界で判定するため "Bash(ghost:*)" は包含しない
#   - "Tool(prefix*)"（区切りなしの *）は単語境界なしの前方一致。
#     グローバルの "Bash(gh*)" は "Bash(ghost:*)" も包含する
#   上記以外（ドメインの前方一致やパスの glob、先頭・途中に * があるパターンなど）
#   は完全一致でのみ判定し、誤って削除しないよう保守的に扱う。
#
# オプション:
#   -h, --help          ヘルプを表示
#   -v, --verbose        settings.local.json が無い DIR をスキップした旨も表示する
#                         （format/candidates。位置は問わない）
#
# 終了コード（check）: 0=整理済み, 1=未整理（重複・未ソート・未正規化・グローバルで
#                       カバー済み・permissionsが空のいずれか）。複数DIR指定時は
#                       いずれか1件でも該当すれば1。settings.local.json が無いDIRは
#                       エラー扱いしない。format/candidatesも同様で、
#                       settings.local.json が無いDIRはスキップするだけだが、
#                       JSONとして壊れているDIRがあればパスとjqのエラーを報告し、
#                       複数DIRのうち1件でもあれば全体が1。

set -euo pipefail

VERBOSE=false
_args=()
for _a in "$@"; do
  case "${_a}" in
    -v|--verbose) VERBOSE=true ;;
    *) _args+=("${_a}") ;;
  esac
done
if (( ${#_args[@]} > 0 )); then
  set -- "${_args[@]}"
else
  set --
fi
unset _a _args

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
  exit 0
fi

_error() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

_require_jq() {
  command -v jq > /dev/null 2>&1 || _error "jq が見つかりません（brew install jq）"
}

# JSONとして読めるか検証する。壊れている場合はパスとjqのエラーを添えて報告する
# （jq自体のエラーメッセージにはファイルパスが含まれないため、ここで補う）。
_validate_json() {
  local file="$1"
  local err
  if err="$(jq empty "${file}" 2>&1)"; then
    return 0
  fi
  printf 'error: 無効なJSON: %s\n' "${file}" >&2
  printf '  %s\n' "${err}" >&2
  return 1
}

# $1 がシンボリックリンクなら実体パスを解決して返す。そうでなければ$1をそのまま返す。
# mktemp+mvで書き戻す際、リンクパスに直接mvするとリンク自体が実ファイルに置き換わり
# 同期が切れるため（dotfiles管理下の ~/.claude/settings.json 等で発生し得る。
# karabiner.json の atomic rename と同種の問題）、書き込み前に必ず解決してから使う。
_resolve_write_target() {
  local file="$1"
  if [[ -L "${file}" ]]; then
    realpath "${file}"
  else
    printf '%s' "${file}"
  fi
}

_local_settings_file() {
  local dir="${1:-.}"
  printf '%s/.claude/settings.local.json' "${dir%/}"
}

_global_settings_file() {
  printf '%s/.claude/settings.json' "${HOME}"
}

# claude-perms専用の設定ファイル（Claude Code本体は読まない）。
_claude_perms_config_file() {
  printf '%s/.claude/claude-perms.json' "${HOME}"
}

# ~/.claude/claude-perms.json の forbiddenAllow（正規化済み・改行区切り）を
# _FORBIDDEN_ALLOW_LINES にセットする。ファイルが無ければ空文字列のまま0を返す。
# 壊れたJSONの場合はパスとエラーを報告して1を返す。
_load_forbidden_allow() {
  _FORBIDDEN_ALLOW_LINES=""
  local config
  config="$(_claude_perms_config_file)"
  [[ -f "${config}" ]] || return 0
  _validate_json "${config}" || return 1

  local e
  while IFS= read -r e; do
    [[ -n "${e}" ]] || continue
    _FORBIDDEN_ALLOW_LINES="${_FORBIDDEN_ALLOW_LINES}$(_normalize_rule "${e}")"$'\n'
  done < <(jq -r '.forbiddenAllow // [] | .[]' "${config}")
  return 0
}

# 正規化済みエントリ($1)が _FORBIDDEN_ALLOW_LINES に厳密一致するか判定する。
_is_forbidden() {
  local normalized_entry="$1" line
  [[ -n "${_FORBIDDEN_ALLOW_LINES}" ]] || return 1
  while IFS= read -r line; do
    [[ -n "${line}" ]] || continue
    [[ "${line}" == "${normalized_entry}" ]] && return 0
  done <<< "${_FORBIDDEN_ALLOW_LINES}"
  return 1
}

# 複数DIR引数をループして関数 $1 を各DIRに適用する共通ヘルパー。
# DIR省略時は "." 1件のみを対象にする。各DIRの出力（stdout+stderr）はまとめて
# 捕捉し、何か出力したDIRの間だけ空行を挟む。settings.local.json が無いDIRの
# ような無音スキップを挟んでも、空行が積み重ならない。
# いずれか1件でも失敗（非0終了）すれば、全体としても非0を返す。
_run_over_dirs() {
  local fn="$1"
  shift
  local -a dirs=("$@")
  (( ${#dirs[@]} == 0 )) && dirs=(".")

  local dir out rc failed=0 printed_any=false
  for dir in "${dirs[@]}"; do
    if out="$("${fn}" "${dir}" 2>&1)"; then
      rc=0
    else
      rc=$?
    fi
    if [[ -n "${out}" ]]; then
      [[ "${printed_any}" == true ]] && printf '\n'
      printf '%s\n' "${out}"
      printed_any=true
    fi
    (( rc != 0 )) && failed=1
  done
  return "${failed}"
}

# ルール文字列を "Tool(spec)" 形式で分解する。カッコが無ければ spec は空文字列
# （＝そのツールを無制限に許可）として扱う。結果は _RULE_TOOL / _RULE_SPEC に入れる。
_split_rule() {
  local rule="$1"
  if [[ "${rule}" =~ ^([A-Za-z_]+)\((.*)\)$ ]]; then
    _RULE_TOOL="${BASH_REMATCH[1]}"
    _RULE_SPEC="${BASH_REMATCH[2]}"
  else
    _RULE_TOOL="${rule}"
    _RULE_SPEC=""
  fi
}

# spec 末尾の trailing wildcard を剥がしてプレフィックスを取り出す。
# 剥がせた場合は _WILDCARD_PREFIX / _WILDCARD_WORD_BOUNDARY をセットして返り値 0。
# 剥がせない（末尾が wildcard でない）場合は返り値 1。
#   "prefix:*" / "prefix *"（コロン or 半角スペース + *）は単語境界ありの前方一致
#   "prefix*"  （区切りなしの *）は単語境界なしの前方一致（例: "gh*" は "ghost" にも一致）
# 参考: https://code.claude.com/docs/en/permissions.md 「Wildcard patterns」
_strip_wildcard() {
  local spec="$1"
  case "${spec}" in
    *:\*)
      _WILDCARD_PREFIX="${spec%:\*}"
      _WILDCARD_WORD_BOUNDARY=true
      ;;
    *" "\*)
      _WILDCARD_PREFIX="${spec% \*}"
      _WILDCARD_WORD_BOUNDARY=true
      ;;
    *\*)
      _WILDCARD_PREFIX="${spec%\*}"
      _WILDCARD_WORD_BOUNDARY=false
      ;;
    *)
      return 1
      ;;
  esac
  return 0
}

# $1（グローバル側のルール）が $2（ローカル側のルール）を包含するか判定する。
_covers() {
  local global_rule="$1" local_rule="$2"
  [[ "${global_rule}" == "${local_rule}" ]] && return 0

  _split_rule "${global_rule}"
  local g_tool="${_RULE_TOOL}" g_spec="${_RULE_SPEC}"
  _split_rule "${local_rule}"
  local l_tool="${_RULE_TOOL}" l_spec="${_RULE_SPEC}"

  [[ "${g_tool}" == "${l_tool}" ]] || return 1
  [[ -z "${g_spec}" ]] && return 0

  _strip_wildcard "${g_spec}" || return 1
  local g_prefix="${_WILDCARD_PREFIX}" word_boundary="${_WILDCARD_WORD_BOUNDARY}"

  local l_cmd="${l_spec}"
  if _strip_wildcard "${l_spec}"; then
    l_cmd="${_WILDCARD_PREFIX}"
  fi

  if [[ "${word_boundary}" == true ]]; then
    [[ "${l_cmd}" == "${g_prefix}" || "${l_cmd}" == "${g_prefix} "* ]] && return 0
  else
    [[ "${l_cmd}" == "${g_prefix}"* ]] && return 0
  fi
  return 1
}

# "Tool(prefix *)"（末尾が半角スペース+"*"）を "Tool(prefix:*)" へ正規化する。
# Bash/PowerShell以外のツール、または末尾がスペース+"*"でないルールはそのまま返す
# （":*" 形式との同義性はBash/PowerShellのコマンドルールとして文書化されており、
#   Read/Glob等のパスglobには適用しない）。
_normalize_rule() {
  local rule="$1"
  _split_rule "${rule}"
  local tool="${_RULE_TOOL}" spec="${_RULE_SPEC}"
  case "${tool}" in
    Bash|PowerShell) ;;
    *)
      printf '%s' "${rule}"
      return 0
      ;;
  esac
  case "${spec}" in
    *" "\*)
      printf '%s(%s:*)' "${tool}" "${spec% \*}"
      ;;
    *)
      printf '%s' "${rule}"
      ;;
  esac
}

# 標準入力から改行区切りのエントリ（空でもよい）を読み、正規化（_normalize_rule）・
# 重複除去・ソートしてJSON配列文字列を返す。呼び出し側で配列を "${arr[@]}" のまま
# 引数展開すると、要素0件のときbash 3.2（macOS標準）のset -uでunbound variableに
# なるため、あえて標準入力経由にしている。
_normalize_entries_json() {
  local -a normalized=()
  local e
  while IFS= read -r e; do
    [[ -n "${e}" ]] || continue
    normalized+=("$(_normalize_rule "${e}")")
  done
  if (( ${#normalized[@]} == 0 )); then
    printf '[]'
    return 0
  fi
  printf '%s\n' "${normalized[@]}" | jq -R -s 'split("\n") | map(select(length > 0)) | unique'
}

# ローカルの permissions.allow を1行ずつ判定し、
#   KEEP<TAB>entry                 …そのまま残す
#   REMOVED<TAB>entry<TAB>covering …グローバルの covering ルールでカバー済みなので削除
# を標準出力へ出す。
_classify_allow() {
  local local_file="$1" global_file="$2"
  local -a global_allow=()
  if [[ -f "${global_file}" ]]; then
    while IFS= read -r line; do
      [[ -n "${line}" ]] && global_allow+=("${line}")
    done < <(jq -r '.permissions.allow // [] | .[]' "${global_file}")
  fi

  local entry g covering
  while IFS= read -r entry; do
    [[ -n "${entry}" ]] || continue
    covering=""
    if (( ${#global_allow[@]} > 0 )); then
      for g in "${global_allow[@]}"; do
        if _covers "${g}" "${entry}"; then
          covering="${g}"
          break
        fi
      done
    fi
    if [[ -n "${covering}" ]]; then
      printf 'REMOVED\t%s\t%s\n' "${entry}" "${covering}"
    else
      printf 'KEEP\t%s\n' "${entry}"
    fi
  done < <(jq -r '.permissions.allow // [] | .[]' "${local_file}")
}

# file の permissions.allow/deny/ask を正規化（_normalize_rule）・重複除去し、
# global_file（空文字なら比較しない）でカバーされる allow エントリ、および
# ~/.claude/claude-perms.json の forbiddenAllow に厳密一致する allow エントリを
# 除外した結果を次の変数にセットする:
#   _FMT_BEFORE / _FMT_AFTER                          … 整理前後の .permissions（比較用）
#   _FMT_NEW_ALLOW_JSON / _FMT_NEW_DENY_JSON / _FMT_NEW_ASK_JSON … 書き戻す新しい配列
#   _FMT_CLASSIFIED                                    … _classify_allow の生出力（報告用。
#                                                         global_file="" のときは空）
#   _FMT_FORBIDDEN_REMOVED                             … forbiddenAllowで除外した生エントリ
#                                                         （改行区切り、報告用）
# claude-perms.json が壊れている場合は1を返す（呼び出し側は処理を中断すること）。
_compute_format_result() {
  local file="$1" global_file="${2:-}"

  _load_forbidden_allow || return 1

  # 配列ではなく改行区切り文字列で集める（bash 3.2対策。上のコメント参照）。
  local kept_lines="" forbidden_lines=""
  _FMT_CLASSIFIED=""
  if [[ -n "${global_file}" ]]; then
    _FMT_CLASSIFIED="$(_classify_allow "${file}" "${global_file}")"
    if [[ -n "${_FMT_CLASSIFIED}" ]]; then
      local tag entry
      while IFS=$'\t' read -r tag entry _covering; do
        [[ "${tag}" == "KEEP" ]] || continue
        if _is_forbidden "$(_normalize_rule "${entry}")"; then
          forbidden_lines="${forbidden_lines}${entry}"$'\n'
        else
          kept_lines="${kept_lines}${entry}"$'\n'
        fi
      done <<< "${_FMT_CLASSIFIED}"
    fi
  else
    local entry
    while IFS= read -r entry; do
      [[ -n "${entry}" ]] || continue
      if _is_forbidden "$(_normalize_rule "${entry}")"; then
        forbidden_lines="${forbidden_lines}${entry}"$'\n'
      else
        kept_lines="${kept_lines}${entry}"$'\n'
      fi
    done < <(jq -r '.permissions.allow // [] | .[]' "${file}")
  fi
  _FMT_NEW_ALLOW_JSON="$(_normalize_entries_json <<< "${kept_lines}")"
  _FMT_FORBIDDEN_REMOVED="${forbidden_lines}"

  local deny_lines="" d
  while IFS= read -r d; do
    [[ -n "${d}" ]] && deny_lines="${deny_lines}${d}"$'\n'
  done < <(jq -r '.permissions.deny // [] | .[]' "${file}")
  _FMT_NEW_DENY_JSON="$(_normalize_entries_json <<< "${deny_lines}")"

  local ask_lines="" a
  while IFS= read -r a; do
    [[ -n "${a}" ]] && ask_lines="${ask_lines}${a}"$'\n'
  done < <(jq -r '.permissions.ask // [] | .[]' "${file}")
  _FMT_NEW_ASK_JSON="$(_normalize_entries_json <<< "${ask_lines}")"

  _FMT_BEFORE="$(jq -c '.permissions // {}' "${file}")"
  _FMT_AFTER="$(jq -c \
    --argjson new_allow "${_FMT_NEW_ALLOW_JSON}" \
    --argjson new_deny "${_FMT_NEW_DENY_JSON}" \
    --argjson new_ask "${_FMT_NEW_ASK_JSON}" '
    if .permissions and (.permissions | has("allow")) then .permissions.allow = $new_allow else . end
    | if .permissions and (.permissions | has("deny"))  then .permissions.deny  = $new_deny  else . end
    | if .permissions and (.permissions | has("ask"))   then .permissions.ask   = $new_ask   else . end
    | .permissions // {}
  ' "${file}")"
}

# _compute_format_result が計算済みの _FMT_NEW_*_JSON で file を実際に書き換える。
_write_format_result() {
  local file="$1" target tmp
  target="$(_resolve_write_target "${file}")"
  tmp="$(mktemp "${target}.XXXXXX")"
  jq \
    --argjson new_allow "${_FMT_NEW_ALLOW_JSON}" \
    --argjson new_deny "${_FMT_NEW_DENY_JSON}" \
    --argjson new_ask "${_FMT_NEW_ASK_JSON}" '
    if .permissions and (.permissions | has("allow")) then .permissions.allow = $new_allow else . end
    | if .permissions and (.permissions | has("deny"))  then .permissions.deny  = $new_deny  else . end
    | if .permissions and (.permissions | has("ask"))   then .permissions.ask   = $new_ask   else . end
  ' "${target}" > "${tmp}"
  mv "${tmp}" "${target}"
}

# permissions が {"allow": []} だけ（deny/ask無し、他のトップレベルキー無し）になった
# settings.local.json を削除する。削除後、.claude/ に他のファイルが無ければ
# .claude/ ごと削除する。
_is_empty_permissions_only() {
  local file="$1"
  jq -e '
    (keys == ["permissions"])
    and (.permissions | keys == ["allow"])
    and (.permissions.allow == [])
  ' "${file}" > /dev/null 2>&1
}

_prune_if_empty() {
  local file="$1" dir
  [[ -f "${file}" ]] || return 0
  _is_empty_permissions_only "${file}" || return 0

  rm -f "${file}"
  printf '空になったため削除: %s\n' "${file}"

  dir="$(dirname "${file}")"
  if [[ -d "${dir}" ]] && [[ -z "$(find "${dir}" -mindepth 1 -print -quit 2>/dev/null)" ]]; then
    rmdir "${dir}"
    printf '空になったため削除: %s\n' "${dir}"
  fi
}

_format_one() {
  local dir="${1:-.}" file global_file
  file="$(_local_settings_file "${dir}")"
  global_file="$(_global_settings_file)"
  if [[ ! -f "${file}" ]]; then
    [[ "${VERBOSE}" == true ]] && printf 'skip（settings.local.json なし）: %s\n' "${file}"
    return 0
  fi
  _validate_json "${file}" || return 1

  _compute_format_result "${file}" "${global_file}" || return 1

  if [[ "${_FMT_BEFORE}" == "${_FMT_AFTER}" ]]; then
    printf '変更なし: %s\n' "${file}"
  else
    _write_format_result "${file}"
    printf '整理しました: %s\n' "${file}"

    local removed
    removed="$(command grep $'^REMOVED\t' <<< "${_FMT_CLASSIFIED}" | sort -u || true)"
    if [[ -n "${removed}" ]]; then
      printf 'グローバル設定でカバー済みのため削除:\n'
      while IFS=$'\t' read -r _tag entry covering; do
        printf '  %s  (%s でカバー)\n' "${entry}" "${covering}"
      done <<< "${removed}"
    fi
    if [[ -n "${_FMT_FORBIDDEN_REMOVED}" ]]; then
      printf '禁止エントリ（claude-perms.json）のため削除:\n'
      while IFS= read -r entry; do
        [[ -n "${entry}" ]] && printf '  %s\n' "${entry}"
      done <<< "${_FMT_FORBIDDEN_REMOVED}"
    fi
  fi

  _prune_if_empty "${file}"
}

_cmd_format() {
  _run_over_dirs _format_one "$@"
}

_check_one() {
  local dir="${1:-.}" file global_file
  file="$(_local_settings_file "${dir}")"
  global_file="$(_global_settings_file)"

  if [[ ! -d "${dir%/}/.claude" ]]; then
    printf '.claude/ が見つかりません: %s\n' "${dir}" >&2
    return 1
  fi
  if [[ ! -f "${file}" ]]; then
    printf '[.claude] found（settings.local.json なし）\n'
    return 0
  fi
  _validate_json "${file}" || return 1

  _compute_format_result "${file}" "${global_file}" || return 1

  if [[ "${_FMT_BEFORE}" != "${_FMT_AFTER}" ]]; then
    printf '[.claude] found — permissions が未整理です（claude-perms format で整理）\n'
    return 1
  fi
  if _is_empty_permissions_only "${file}"; then
    printf '[.claude] found — permissions が空です（claude-perms format で削除）\n'
    return 1
  fi
  printf '[.claude] found — permissions は整理済みです\n'
  return 0
}

_cmd_check() {
  _run_over_dirs _check_one "$@"
}

_candidates_one() {
  local dir="${1:-.}" local_file global_file
  local_file="$(_local_settings_file "${dir}")"
  global_file="$(_global_settings_file)"
  if [[ ! -f "${local_file}" ]]; then
    [[ "${VERBOSE}" == true ]] && printf 'skip（settings.local.json なし）: %s\n' "${local_file}"
    return 0
  fi
  _validate_json "${local_file}" || return 1

  local classified local_count global_count candidate_count
  classified="$(_classify_allow "${local_file}" "${global_file}")"

  local -a raw_candidates=()
  if [[ -n "${classified}" ]]; then
    while IFS=$'\t' read -r tag entry _covering; do
      [[ "${tag}" == "KEEP" ]] && raw_candidates+=("${entry}")
    done <<< "${classified}"
  fi
  local -a candidates=()
  if (( ${#raw_candidates[@]} > 0 )); then
    while IFS= read -r entry; do
      [[ -n "${entry}" ]] && candidates+=("${entry}")
    done < <(printf '%s\n' "${raw_candidates[@]}" | sort -u)
  fi

  local_count="$(jq '.permissions.allow // [] | unique | length' "${local_file}")"
  if [[ -f "${global_file}" ]]; then
    global_count="$(jq '.permissions.allow // [] | unique | length' "${global_file}")"
  else
    global_count=""
  fi
  candidate_count=${#candidates[@]}

  printf 'ローカル: %s (allow: %s件)\n' "${local_file}" "${local_count}"
  if [[ -f "${global_file}" ]]; then
    printf 'グローバル: %s (allow: %s件)\n' "${global_file}" "${global_count}"
  else
    printf 'グローバル: %s (未作成)\n' "${global_file}"
  fi

  if [[ "${candidate_count}" -eq 0 ]]; then
    printf '移管候補はありません（ローカルのallowは空、またはすべてグローバルのルールでカバー済みです）\n'
    return 0
  fi

  printf '移管候補 (%s件, グローバルのルールで未カバー):\n' "${candidate_count}"
  printf '%s\n' "${candidates[@]}" | sed 's/^/  /'
  printf '\n%s へ手動で追記・整理してください（このコマンドは一覧表示のみで自動追加はしません）\n' "${global_file}"
}

_cmd_candidates() {
  _run_over_dirs _candidates_one "$@"
}

# ~/.claude/settings.json（グローバル）自体のallow/deny/askを正規化・ソート・重複削除
# する。グローバルより上位の設定は無いため「カバー済みだから削除」判定は行わない。
# permissionsが空になっても、他のキー（model等）を持つ本体設定なので削除もしない。
_cmd_format_global() {
  [[ $# -eq 0 ]] || _error "format-global はDIR引数を取りません"

  local file
  file="$(_global_settings_file)"
  if [[ ! -f "${file}" ]]; then
    printf 'error: not found: %s\n' "${file}" >&2
    return 1
  fi
  _validate_json "${file}" || return 1

  _compute_format_result "${file}" "" || return 1

  if [[ "${_FMT_BEFORE}" == "${_FMT_AFTER}" ]]; then
    printf '変更なし: %s\n' "${file}"
    return 0
  fi

  _write_format_result "${file}"
  printf '整理しました: %s\n' "${file}"

  if [[ -n "${_FMT_FORBIDDEN_REMOVED}" ]]; then
    printf '禁止エントリ（claude-perms.json）のため削除:\n'
    local entry
    while IFS= read -r entry; do
      [[ -n "${entry}" ]] && printf '  %s\n' "${entry}"
    done <<< "${_FMT_FORBIDDEN_REMOVED}"
  fi
  return 0
}

# エントリ($1)がパターン($2)に一致するか判定する。
#   glob=true : $2 をbashのglobとしてそのまま解釈する（*, ? 等）。まず生のまま
#     比較し、一致しなければ双方を正規化（_normalize_rule）した上でも比較する。
#     例えば pattern "Bash(command *)" は生の "Bash(command:*)"（正規化済み
#     エントリ）には一致しないが、正規化後の比較で拾える。一方 "Bash(npm run *)"
#     のような広いglob検索で "Bash(npm run test)" を拾う既存の動作は、生のまま
#     の比較で先に一致するため維持される。
#   glob=false（既定）: 双方を正規化（_normalize_rule）した上での厳密一致
_matches_pattern() {
  local entry="$1" pattern="$2" glob="$3"
  if [[ "${glob}" == true ]]; then
    # shellcheck disable=SC2053  # globとして評価するためあえて非クォート
    if [[ "${entry}" == ${pattern} ]]; then
      return 0
    fi
    local norm_entry norm_pattern
    norm_entry="$(_normalize_rule "${entry}")"
    norm_pattern="$(_normalize_rule "${pattern}")"
    # shellcheck disable=SC2053
    [[ "${norm_entry}" == ${norm_pattern} ]]
    return
  fi
  [[ "$(_normalize_rule "${entry}")" == "$(_normalize_rule "${pattern}")" ]]
}

# file 内の allow/deny/ask から _REMOVE_PATTERN（_REMOVE_GLOBの解釈に従う）に
# 一致するエントリを探す。_REMOVE_APPLY=true なら実際に削除して書き戻し、
# false（既定）なら一致内容を表示するだけ（dry-run、書き換えない）。
_remove_from_file() {
  local file="$1"
  local report="" matched_any=false
  local allow_kept="" deny_kept="" ask_kept="" e

  while IFS= read -r e; do
    [[ -n "${e}" ]] || continue
    if _matches_pattern "${e}" "${_REMOVE_PATTERN}" "${_REMOVE_GLOB}"; then
      report="${report}  [allow] ${e}"$'\n'
      matched_any=true
    else
      allow_kept="${allow_kept}${e}"$'\n'
    fi
  done < <(jq -r '.permissions.allow // [] | .[]' "${file}")

  while IFS= read -r e; do
    [[ -n "${e}" ]] || continue
    if _matches_pattern "${e}" "${_REMOVE_PATTERN}" "${_REMOVE_GLOB}"; then
      report="${report}  [deny] ${e}"$'\n'
      matched_any=true
    else
      deny_kept="${deny_kept}${e}"$'\n'
    fi
  done < <(jq -r '.permissions.deny // [] | .[]' "${file}")

  while IFS= read -r e; do
    [[ -n "${e}" ]] || continue
    if _matches_pattern "${e}" "${_REMOVE_PATTERN}" "${_REMOVE_GLOB}"; then
      report="${report}  [ask] ${e}"$'\n'
      matched_any=true
    else
      ask_kept="${ask_kept}${e}"$'\n'
    fi
  done < <(jq -r '.permissions.ask // [] | .[]' "${file}")

  if [[ "${matched_any}" != true ]]; then
    printf '一致なし: %s\n' "${file}"
    return 0
  fi

  if [[ "${_REMOVE_APPLY}" != true ]]; then
    printf '[dry-run] 一致（--apply で削除）: %s\n' "${file}"
    printf '%s' "${report}"
    return 0
  fi

  local new_allow_json new_deny_json new_ask_json
  new_allow_json="$(jq -R -s 'split("\n") | map(select(length > 0))' <<< "${allow_kept}")"
  new_deny_json="$(jq -R -s 'split("\n") | map(select(length > 0))' <<< "${deny_kept}")"
  new_ask_json="$(jq -R -s 'split("\n") | map(select(length > 0))' <<< "${ask_kept}")"

  local target tmp
  target="$(_resolve_write_target "${file}")"
  tmp="$(mktemp "${target}.XXXXXX")"
  jq \
    --argjson new_allow "${new_allow_json}" \
    --argjson new_deny "${new_deny_json}" \
    --argjson new_ask "${new_ask_json}" '
    if .permissions and (.permissions | has("allow")) then .permissions.allow = $new_allow else . end
    | if .permissions and (.permissions | has("deny"))  then .permissions.deny  = $new_deny  else . end
    | if .permissions and (.permissions | has("ask"))   then .permissions.ask   = $new_ask   else . end
  ' "${target}" > "${tmp}"
  mv "${tmp}" "${target}"
  printf '削除しました: %s\n' "${file}"
  printf '%s' "${report}"
}

_remove_one() {
  local dir="${1:-.}" file
  file="$(_local_settings_file "${dir}")"
  if [[ ! -f "${file}" ]]; then
    [[ "${VERBOSE}" == true ]] && printf 'skip（settings.local.json なし）: %s\n' "${file}"
    return 0
  fi
  _validate_json "${file}" || return 1
  _remove_from_file "${file}" || return 1
  if [[ "${_REMOVE_APPLY}" == true ]]; then
    _prune_if_empty "${file}"
  fi
  return 0
}

# claude-perms remove <pattern> [DIR...] [--glob] [--apply|-y]
_cmd_remove() {
  local glob=false apply=false
  local -a rest=()
  local a
  for a in "$@"; do
    case "${a}" in
      --glob) glob=true ;;
      --apply|-y) apply=true ;;
      *) rest+=("${a}") ;;
    esac
  done
  (( ${#rest[@]} > 0 )) || _error "usage: claude-perms remove <pattern> [DIR...] [--glob] [--apply]"

  _REMOVE_PATTERN="${rest[0]}"
  _REMOVE_GLOB="${glob}"
  _REMOVE_APPLY="${apply}"

  set -- "${rest[@]}"
  shift
  _run_over_dirs _remove_one "$@"
}

# claude-perms remove-global <pattern> [--glob] [--apply|-y]
_cmd_remove_global() {
  local glob=false apply=false
  local -a rest=()
  local a
  for a in "$@"; do
    case "${a}" in
      --glob) glob=true ;;
      --apply|-y) apply=true ;;
      *) rest+=("${a}") ;;
    esac
  done
  (( ${#rest[@]} > 0 )) || _error "usage: claude-perms remove-global <pattern> [--glob] [--apply]"
  (( ${#rest[@]} == 1 )) || _error "remove-global はpattern以外の引数（DIR等）を取りません"

  _REMOVE_PATTERN="${rest[0]}"
  _REMOVE_GLOB="${glob}"
  _REMOVE_APPLY="${apply}"

  local file
  file="$(_global_settings_file)"
  if [[ ! -f "${file}" ]]; then
    printf 'error: not found: %s\n' "${file}" >&2
    return 1
  fi
  _validate_json "${file}" || return 1
  _remove_from_file "${file}"
}

_require_jq

command_name="${1:-}"
[[ -n "${command_name}" ]] || _error "usage: claude-perms {format|format-global|check|candidates|remove|remove-global} [DIR...]"
shift

case "${command_name}" in
  format)        _cmd_format "$@" ;;
  format-global) _cmd_format_global "$@" ;;
  check)         _cmd_check "$@" ;;
  candidates)    _cmd_candidates "$@" ;;
  remove)        _cmd_remove "$@" ;;
  remove-global) _cmd_remove_global "$@" ;;
  *) _error "unknown command: ${command_name} (format/format-global/check/candidates/remove/remove-global が使えます)" ;;
esac
