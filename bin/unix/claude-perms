#!/usr/bin/env bash
# claude-perms: .claude/settings.local.json の permissions を整理するヘルパー
#
# 使い方:
#   claude-perms format [DIR...]    permissions.allow/deny/ask を正規化・ソート・
#                                    重複削除し、allow のうち ~/.claude/settings.json
#                                    （グローバル）のルールで既にカバーされているものを
#                                    削除して書き戻す。同じファイル内の他のallow
#                                    エントリに包含されるものも削除する（後述の
#                                    _dedupe_covered_within。例: 同じファイルに
#                                    "Bash(git:*)" と "Bash(git commit:*)" が両方
#                                    あれば後者を削除）。あわせて、残ったBash allowの
#                                    run-quiet修飾版（未追加なら）を自動追加する（後述）。
#                                    整理後に permissions が {"allow": []} だけになったら
#                                    settings.local.json を削除し、.claude/ が空になれば
#                                    それも削除する
#   claude-perms check [DIR...]     整理が必要かどうかだけ確認する（書き換えない）
#   claude-perms candidates [DIR...] [--json]
#                                    グローバルにもDIRに一致するpathRuleにも無い
#                                    （＝カバーされていない）ローカル allow エントリを
#                                    一覧表示する（移管するかどうかの判断はユーザーが行う。
#                                    削除は format または remove --json が行う）。
#                                    候補が0件のDIRは、複数DIR指定時にカバー済みの
#                                    リポジトリまで毎回表示されるノイズを避けるため、
#                                    --verbose指定時以外は無音でスキップする。
#                                    --json指定時は [{"target": DIR, "allow": [...]}...]
#                                    形式のJSON配列を出力する（候補0件のDIRは--verbose
#                                    指定時でも常に省く）。targetはコマンドラインに
#                                    渡したDIRそのもの（未指定なら"."）。このJSONは
#                                    人手で必要なエントリだけへ絞り込んだ上で
#                                    claude-perms remove --json（ローカルからの一括削除）
#                                    へそのまま渡せる（必要なエントリ自体は
#                                    claude-perms.jsonのpathRulesへ手動で追記し、
#                                    claude-perms apply で反映する）
#   claude-perms format-global      ~/.claude/settings.json （グローバル）自体の
#                                    permissions.allow/deny/ask を正規化・ソート・
#                                    重複削除し、残ったBash allowのrun-quiet修飾版を
#                                    自動追加する。グローバルより上位は無いのでカバー済み
#                                    判定は行わず、permissionsが空になっても他のキー
#                                    （model等）を持つ本体設定ファイルなので削除もしない。
#                                    あわせて ~/.claude/claude-perms.json の
#                                    forbiddenAllow・pathRules[].allow も正規化・
#                                    重複削除・ソートする。DIR引数は取らない
#   claude-perms remove <pattern> [DIR...] [--glob] [--apply|-y]
#                                    allow/deny/askからpatternに一致するエントリを探す。
#                                    既定（厳密一致）: pattern・エントリ双方を正規化
#                                    （下記）した上で完全一致するものだけを対象にする
#                                    （例: pattern "run-quiet *" は "Bash(run-quiet:*)"
#                                    には一致するが "Bash(run-quiet make:*)" には一致
#                                    しない）。--glob指定時はpatternをbashのglob
#                                    （*, ?等）としてエントリ文字列全体に対して評価する。
#                                    既定はdry-run（一致内容の表示のみ）。実際に削除
#                                    するには --apply（または -y）を付ける
#   claude-perms remove --json <FILE|-> [--apply|-y]
#                                    candidates --json と同じ形（[{"target": DIR,
#                                    "allow": [...]}...]）のJSONを読み、targetごとの
#                                    settings.local.jsonからallowに列挙したエントリを
#                                    厳密一致（正規化後。globは使わない）で探して削除
#                                    する。FILEに"-"を指定すると標準入力から読む。
#                                    --glob とは併用できない。既定はdry-run、実際に
#                                    削除するには --apply（または -y）を付ける
#   claude-perms remove-global <pattern> [--glob] [--apply|-y]
#                                    removeと同じ判定を ~/.claude/settings.json
#                                    （グローバル）自体に対して行う。DIR引数は取らない
#                                    （--json指定には未対応）
#   claude-perms merge [DIR...]     ~/.claude/claude-perms.json の pathRules（後述）のうち
#                                    DIRの絶対パスがpathGlobに一致するallowエントリを
#                                    DIR/.claude/settings.local.json へ追記し、format と
#                                    同じ正規化・重複削除・グローバルでカバー済み判定・
#                                    禁止エントリ除去・run-quiet修飾版の自動追加（後述）を
#                                    適用する。settings.local.json が無ければ新規作成する。
#                                    一致するpathRuleが無いDIRは何もしない（--verbose指定時
#                                    のみその旨を表示）。pathRuleを外した後に「過去にmergeで
#                                    追加され今は対象外になったエントリ」を自動削除はしない
#                                    （必要ならclaude-perms removeで手動削除する）。
#                                    dots brew/npm/pipx/dock/shortcuts の sync（システム
#                                    実態→管理ファイルへ書き写す方向）とは向きが逆
#                                    （declared→ローカル）なので、他コマンドの sync とは
#                                    異なる merge という名前にしている
#   claude-perms apply [DIR...]     mergeと同じくDIRの絶対パスに一致するpathRuleの
#                                    allowをDIR/.claude/settings.local.jsonへ書き込む
#                                    が、mergeが「追記（既存に無いものを足すだけ）」
#                                    なのに対し、applyは「置き換え（既存のallowを
#                                    pathRuleの内容そのもので上書きする）」。典型的な
#                                    移管フロー: candidates（--json）でローカル限定の
#                                    allowを確認する→必要なものだけclaude-perms.jsonの
#                                    pathRulesへ手動で追記する→applyを実行すると、
#                                    そのDIRのallowはpathRuleの内容だけになり、
#                                    昇格しなかった残りは自動的に消える。merge同様、
#                                    一致するpathRuleが無いDIRは何もしない
#                                    （settings.local.jsonを空にするような暴走はしない）。
#                                    書き込み後はformatと同じ正規化（グローバルカバー
#                                    判定・禁止エントリ除去・run-quiet修飾版の自動追加）
#                                    を適用する。merge同様dry-run（--apply/-y）は無く、
#                                    常に直接書き込む
#
# 正規化: Bash/PowerShellルールの末尾が半角スペース+"*"（例: "gh *"）の場合、
# 同義の ":*" 形式（例: "gh:*"）へ書き換える（format/format-global/remove系すべて共通）。
# 参考: https://code.claude.com/docs/en/permissions.md
#   "The `:*` suffix is an equivalent way to write a trailing wildcard"
#
# 禁止エントリ: ~/.claude/claude-perms.json（Claude Code本体は読まない、claude-perms
# 専用の設定）の forbiddenAllow に列挙したエントリは、format/format-globalが
# ローカル・グローバルどちらのallowからも厳密一致（正規化後）で自動削除する。例えば
# "run-quiet:*" のような「何でも実行できてしまう」 blanket allow を、"run-quiet make:*"
# のような個別のスコープ付きallowは残したまま消したい場合に使う（前方一致の
# カバー判定だと "run-quiet make:*" まで巻き込んでしまうため、ここだけ厳密一致にしている）。
# ファイルが無ければ禁止リストなしとして扱う（自動作成しない）。
#   例: {"forbiddenAllow": ["Bash(run-quiet:*)"]}
#
# pathパターンによる一括allow配布: ~/.claude/claude-perms.json の pathRules に
# {"pathGlob": <bashのglob、または同globの配列。先頭の "~" はHOMEに展開>,
#  "allow": [<allowエントリ...>]}
# を列挙すると、claude-perms merge が「DIRの絶対パスがpathGlobのいずれかに一致する」
# pathRuleのallowをそのDIRのsettings.local.jsonへ追記する（applyなら置き換える）。
# 用途: 自分名義の
# リポジトリ群など特定のパス配下でだけ広く許可したいが、真にグローバル
# （全リポジトリ無条件）にするには広すぎるルールを、都度手動コピーせず一括配布
# したい場合。pathGlobを配列にすると、同じallowを複数の無関係なパスパターン
# （別ホスト配下・別ownerのリポジトリ群等）へまとめて配布でき、allowが同じ
# 複数のpathRuleエントリへ重複させる必要がない。
#   例（単一）: {"pathRules": [{"pathGlob": "~/src/github.com/y-marui/*", "allow": ["Bash(npm:*)"]}]}
#   例（配列）: {"pathRules": [{"pathGlob": ["~/src/github.com/y-marui/*", "~/work/*"], "allow": ["Bash(npm:*)"]}]}
# pathGlob（配列の場合は各要素）はDIRの絶対パス全体に対するbash globとして評価する
# 単純なパターンマッチで、ディレクトリ階層の意味は理解しない。複数のpathRuleが
# 一致した場合、および1つのpathRule内でpathGlobの複数要素が一致した場合も、
# allowを全て合成する。ファイルが無ければpathRuleなしとして扱う（自動作成しない）。
#
# run-quiet修飾版の自動追加: format/format-global/merge/applyは、残ったBash allowエントリの
# うち単語境界付き末尾wildcard（"cmd:*" 等）を持つものについて、まだ無ければ
# "Bash(run-quiet cmd:*)" を実エントリとして自動追加する。"Bash(cmd:*) を許可していれば
# run-quiet cmd も許可されているとみなしたい"というポリシーのため。run-quietは出力を
# 抑制するだけの薄いラッパーで実体は同じコマンドだが、Claude Code自体はコマンド文字列を
# 見て許可判定するため、run-quiet版を許可するには実際にそのエントリ自体が必要になる
# （pathRules・グローバルの定義側では素のコマンドだけ書けば足り、二重に書く必要はない）。
#
# 同一ファイル内カバーの重複排除: format/format-globalは、グローバル判定と別に、
# 同じファイル（settings.local.json/settings.json/pathRuleのallow配列それぞれ）の
# 中で他のallowエントリに包含されるエントリも削除する（例: 同じファイルに
# "Bash(git:*)" と "Bash(git commit:*)" が両方あれば、後者は前者に包含されるため
# 削除する）。包含関係の判定は下記「カバーされている」の判定と同じ厳密ルールを
# 使う（lenient判定は使わない）。カバーする側のエントリが同じファイル内に残る
# ことを条件に判定するため、他ファイル（グローバルやpathRule）が実際に持っている
# かどうかに依存せず安全（merge/apply実行時はpathRule由来のエントリが先に同じ
# ファイルへ実体化されているため、この時点でカバー関係が成立する）。
#
# DIR は複数指定できる（format-global を除く）。省略時はカレントディレクトリ1件のみを対象にする。
# 各 DIR の対象は DIR/.claude/settings.local.json。settings.local.json が無い DIR は
# 通常の状態として無視する（エラーにしない）。--verbose 指定時だけ、無視した旨を表示する。
# settings.local.json 自体が壊れたJSONの場合は、パスと jq のエラーを添えて常に報告し、
# その DIR だけ失敗扱いにして他の DIR の処理は続行する。
#
# claude-perms shell {on|off|status}   cd時の check 自動実行をon/off（既定off）。
#                                       shell/zshrc のシェル関数が提供するサブコマンドで
#                                       このスクリプト本体には実装していない
#                                       （現在のシェルの環境変数を直接操作する必要があるため）。
#
# 「グローバルのルールでカバーされている」の判定
# （Claude Code本体のワイルドカード仕様 https://code.claude.com/docs/en/permissions.md
#   の "Wildcard patterns" に合わせている）:
#   - 完全一致（例: 両方とも "Bash(gh:*)"）
#   - ツール名のみのグローバルルール（例: "Bash"）は同ツールの全ルールを包含
#   - "Tool(prefix:*)" と "Tool(prefix *)"（コロン/半角スペース + *）は同義の
#     単語境界つき前方一致。グローバルの "Bash(gh:*)" や "Bash(gh *)" は
#     ローカルの "Bash(gh api:*)" や "Bash(gh api repo list)" を包含するが、
#     単語境界で判定するため "Bash(ghost:*)" は包含しない
#   - "Tool(prefix*)"（区切りなしの *）は単語境界なしの前方一致。
#     グローバルの "Bash(gh*)" は "Bash(ghost:*)" も包含する
#   上記以外（ドメインの前方一致やパスの glob、先頭・途中に * があるパターンなど）
#   は完全一致でのみ判定し、誤って削除しないよう保守的に扱う。
# candidatesの「pathRuleでカバー済みなので除外」判定だけは、上記に加えて
# run-quietでラップされたBashコマンドも素のコマンドの許可でカバー済みとみなす
# （lenient判定）。format/format-globalの実削除にはこのlenient判定を使わない
# （run-quiet版の実エントリが無いと実際の許可を失うため）。
#
# オプション:
#   -h, --help          ヘルプを表示
#   -v, --verbose        settings.local.json が無い DIR をスキップした旨も表示する
#                         （format/candidates。位置は問わない）
#
# 終了コード（check）: 0=整理済み, 1=未整理（重複・未ソート・未正規化・グローバルで
#                       カバー済み・permissionsが空のいずれか）。複数DIR指定時は
#                       いずれか1件でも該当すれば1。settings.local.json が無いDIRは
#                       エラー扱いしない。format/candidatesも同様で、
#                       settings.local.json が無いDIRはスキップするだけだが、
#                       JSONとして壊れているDIRがあればパスとjqのエラーを報告し、
#                       複数DIRのうち1件でもあれば全体が1。

set -euo pipefail

VERBOSE=false
_args=()
for _a in "$@"; do
  case "${_a}" in
    -v|--verbose) VERBOSE=true ;;
    *) _args+=("${_a}") ;;
  esac
done
if (( ${#_args[@]} > 0 )); then
  set -- "${_args[@]}"
else
  set --
fi
unset _a _args

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
  exit 0
fi

_error() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

_require_jq() {
  command -v jq > /dev/null 2>&1 || _error "jq が見つかりません（brew install jq）"
}

# JSONとして読めるか検証する。壊れている場合はパスとjqのエラーを添えて報告する
# （jq自体のエラーメッセージにはファイルパスが含まれないため、ここで補う）。
_validate_json() {
  local file="$1"
  local err
  if err="$(jq empty "${file}" 2>&1)"; then
    return 0
  fi
  printf 'error: 無効なJSON: %s\n' "${file}" >&2
  printf '  %s\n' "${err}" >&2
  return 1
}

# $1 がシンボリックリンクなら実体パスを解決して返す。そうでなければ$1をそのまま返す。
# mktemp+mvで書き戻す際、リンクパスに直接mvするとリンク自体が実ファイルに置き換わり
# 同期が切れるため（dotfiles管理下の ~/.claude/settings.json 等で発生し得る。
# karabiner.json の atomic rename と同種の問題）、書き込み前に必ず解決してから使う。
_resolve_write_target() {
  local file="$1"
  if [[ -L "${file}" ]]; then
    realpath "${file}"
  else
    printf '%s' "${file}"
  fi
}

_local_settings_file() {
  local dir="${1:-.}"
  printf '%s/.claude/settings.local.json' "${dir%/}"
}

_global_settings_file() {
  printf '%s/.claude/settings.json' "${HOME}"
}

# claude-perms専用の設定ファイル（Claude Code本体は読まない）。
_claude_perms_config_file() {
  printf '%s/.claude/claude-perms.json' "${HOME}"
}

# ~/.claude/claude-perms.json の forbiddenAllow（正規化済み・改行区切り）を
# _FORBIDDEN_ALLOW_LINES にセットする。ファイルが無ければ空文字列のまま0を返す。
# 壊れたJSONの場合はパスとエラーを報告して1を返す。
_load_forbidden_allow() {
  _FORBIDDEN_ALLOW_LINES=""
  local config
  config="$(_claude_perms_config_file)"
  [[ -f "${config}" ]] || return 0
  _validate_json "${config}" || return 1

  local e
  while IFS= read -r e; do
    [[ -n "${e}" ]] || continue
    _FORBIDDEN_ALLOW_LINES="${_FORBIDDEN_ALLOW_LINES}$(_normalize_rule "${e}")"$'\n'
  done < <(jq -r '.forbiddenAllow // [] | .[]' "${config}")
  return 0
}

# 正規化済みエントリ($1)が _FORBIDDEN_ALLOW_LINES に厳密一致するか判定する。
_is_forbidden() {
  local normalized_entry="$1" line
  [[ -n "${_FORBIDDEN_ALLOW_LINES}" ]] || return 1
  while IFS= read -r line; do
    [[ -n "${line}" ]] || continue
    [[ "${line}" == "${normalized_entry}" ]] && return 0
  done <<< "${_FORBIDDEN_ALLOW_LINES}"
  return 1
}

# 複数DIR引数をループして関数 $1 を各DIRに適用する共通ヘルパー。
# DIR省略時は "." 1件のみを対象にする。各DIRの出力（stdout+stderr）はまとめて
# 捕捉し、何か出力したDIRの間だけ空行を挟む。settings.local.json が無いDIRの
# ような無音スキップを挟んでも、空行が積み重ならない。
# いずれか1件でも失敗（非0終了）すれば、全体としても非0を返す。
_run_over_dirs() {
  local fn="$1"
  shift
  local -a dirs=("$@")
  (( ${#dirs[@]} == 0 )) && dirs=(".")

  local dir out rc failed=0 printed_any=false
  for dir in "${dirs[@]}"; do
    if out="$("${fn}" "${dir}" 2>&1)"; then
      rc=0
    else
      rc=$?
    fi
    if [[ -n "${out}" ]]; then
      [[ "${printed_any}" == true ]] && printf '\n'
      printf '%s\n' "${out}"
      printed_any=true
    fi
    (( rc != 0 )) && failed=1
  done
  return "${failed}"
}

# ルール文字列を "Tool(spec)" 形式で分解する。カッコが無ければ spec は空文字列
# （＝そのツールを無制限に許可）として扱う。結果は _RULE_TOOL / _RULE_SPEC に入れる。
_split_rule() {
  local rule="$1"
  if [[ "${rule}" =~ ^([A-Za-z_]+)\((.*)\)$ ]]; then
    _RULE_TOOL="${BASH_REMATCH[1]}"
    _RULE_SPEC="${BASH_REMATCH[2]}"
  else
    _RULE_TOOL="${rule}"
    _RULE_SPEC=""
  fi
}

# spec 末尾の trailing wildcard を剥がしてプレフィックスを取り出す。
# 剥がせた場合は _WILDCARD_PREFIX / _WILDCARD_WORD_BOUNDARY をセットして返り値 0。
# 剥がせない（末尾が wildcard でない）場合は返り値 1。
#   "prefix:*" / "prefix *"（コロン or 半角スペース + *）は単語境界ありの前方一致
#   "prefix*"  （区切りなしの *）は単語境界なしの前方一致（例: "gh*" は "ghost" にも一致）
# 参考: https://code.claude.com/docs/en/permissions.md 「Wildcard patterns」
_strip_wildcard() {
  local spec="$1"
  case "${spec}" in
    *:\*)
      _WILDCARD_PREFIX="${spec%:\*}"
      _WILDCARD_WORD_BOUNDARY=true
      ;;
    *" "\*)
      _WILDCARD_PREFIX="${spec% \*}"
      _WILDCARD_WORD_BOUNDARY=true
      ;;
    *\*)
      _WILDCARD_PREFIX="${spec%\*}"
      _WILDCARD_WORD_BOUNDARY=false
      ;;
    *)
      return 1
      ;;
  esac
  return 0
}

# $1（グローバル/pathRule側のルール）が $2（ローカル側のルール）を包含するか判定する
# 共通実装。$3=true のときだけ、run-quietでラップされたBashコマンドを素のコマンドの
# 許可でカバー済みとみなす追加判定を行う（lenient。candidatesの「除外」判定専用。
# run-quietは出力を抑制するだけの薄いラッパーで実体は同じコマンドのため）。
# lenient判定はformatの実削除には使わない: 実際にClaude Codeへ許可を与えるのは
# settings.local.json/settings.jsonの文字列そのものであり、"Bash(cmd:*)" は
# "run-quiet cmd ..." という起動文字列には一致しないため、削除すると実際の許可を
# 失う。run-quiet版の実エントリは _expand_run_quiet_lines がformat時に自動補完する。
_covers_impl() {
  local global_rule="$1" local_rule="$2" lenient="$3"
  [[ "${global_rule}" == "${local_rule}" ]] && return 0

  _split_rule "${global_rule}"
  local g_tool="${_RULE_TOOL}" g_spec="${_RULE_SPEC}"
  _split_rule "${local_rule}"
  local l_tool="${_RULE_TOOL}" l_spec="${_RULE_SPEC}"

  [[ "${g_tool}" == "${l_tool}" ]] || return 1
  [[ -z "${g_spec}" ]] && return 0

  _strip_wildcard "${g_spec}" || return 1
  local g_prefix="${_WILDCARD_PREFIX}" word_boundary="${_WILDCARD_WORD_BOUNDARY}"

  local l_cmd="${l_spec}"
  if _strip_wildcard "${l_spec}"; then
    l_cmd="${_WILDCARD_PREFIX}"
  fi

  _covers_match_cmd "${l_cmd}" "${g_prefix}" "${word_boundary}" && return 0

  if [[ "${lenient}" == true && "${g_tool}" == "Bash" && "${l_cmd}" == "run-quiet "* ]]; then
    _covers_match_cmd "${l_cmd#run-quiet }" "${g_prefix}" "${word_boundary}" && return 0
  fi
  return 1
}

_covers_match_cmd() {
  local l_cmd="$1" g_prefix="$2" word_boundary="$3"
  if [[ "${word_boundary}" == true ]]; then
    [[ "${l_cmd}" == "${g_prefix}" || "${l_cmd}" == "${g_prefix} "* ]] && return 0
  else
    [[ "${l_cmd}" == "${g_prefix}"* ]] && return 0
  fi
  return 1
}

_covers() { _covers_impl "$1" "$2" false; }
_covers_lenient() { _covers_impl "$1" "$2" true; }

# "Tool(prefix *)"（末尾が半角スペース+"*"）を "Tool(prefix:*)" へ正規化する。
# Bash/PowerShell以外のツール、または末尾がスペース+"*"でないルールはそのまま返す
# （":*" 形式との同義性はBash/PowerShellのコマンドルールとして文書化されており、
#   Read/Glob等のパスglobには適用しない）。
_normalize_rule() {
  local rule="$1"
  _split_rule "${rule}"
  local tool="${_RULE_TOOL}" spec="${_RULE_SPEC}"
  case "${tool}" in
    Bash|PowerShell) ;;
    *)
      printf '%s' "${rule}"
      return 0
      ;;
  esac
  case "${spec}" in
    *" "\*)
      printf '%s(%s:*)' "${tool}" "${spec% \*}"
      ;;
    *)
      printf '%s' "${rule}"
      ;;
  esac
}

# 標準入力から改行区切りのエントリ（空でもよい）を読み、正規化（_normalize_rule）・
# 重複除去・ソートしてJSON配列文字列を返す。呼び出し側で配列を "${arr[@]}" のまま
# 引数展開すると、要素0件のときbash 3.2（macOS標準）のset -uでunbound variableに
# なるため、あえて標準入力経由にしている。
_normalize_entries_json() {
  local -a normalized=()
  local e
  while IFS= read -r e; do
    [[ -n "${e}" ]] || continue
    normalized+=("$(_normalize_rule "${e}")")
  done
  if (( ${#normalized[@]} == 0 )); then
    printf '[]'
    return 0
  fi
  printf '%s\n' "${normalized[@]}" | jq -R -s 'split("\n") | map(select(length > 0)) | unique'
}

# Bashルール($1)が単語境界付き末尾wildcard（":*" または " *"）を持ち、
# コマンドが "run-quiet " で始まっていなければ、run-quiet修飾版のルール文字列
# （正規化済み":*"形式）を返す。対象外（Bash以外のツール・wildcard無し・
# 既にrun-quiet修飾済み）なら何も出力せず1を返す。
# "Bash(cmd:*) を許可していれば run-quiet cmd:* も許可されているとみなしたい"
# というユーザー方針により、format/format-global/merge/applyが実エントリとして自動追加する
# （run-quietは出力を抑制するだけの薄いラッパーで実体は同じコマンドのため）。
_run_quiet_variant() {
  local rule="$1"
  _split_rule "${rule}"
  [[ "${_RULE_TOOL}" == "Bash" ]] || return 1
  _strip_wildcard "${_RULE_SPEC}" || return 1
  [[ "${_WILDCARD_WORD_BOUNDARY}" == true ]] || return 1
  local prefix="${_WILDCARD_PREFIX}"
  [[ "${prefix}" == "run-quiet" || "${prefix}" == "run-quiet "* ]] && return 1
  printf 'Bash(run-quiet %s:*)' "${prefix}"
}

# lines（改行区切り）の各エントリについて _run_quiet_variant で導出できる
# run-quiet修飾版を、まだ含まれていなければ追加した結果を返す。呼び出し側は
# 結果をコマンド置換（サブシェル）経由で受け取るため、追加分の報告はここでは
# 行わず、呼び出し側で lines との差分から求めること。
_expand_run_quiet_lines() {
  local lines="$1" line variant
  local result="${lines}"
  while IFS= read -r line; do
    [[ -n "${line}" ]] || continue
    variant="$(_run_quiet_variant "${line}")" || continue
    [[ -n "${variant}" ]] || continue
    command grep -qxF "${variant}" <<< "${lines}" && continue
    result="${result}"$'\n'"${variant}"
  done <<< "${lines}"
  printf '%s' "${result}"
}

# lines（改行区切り）から、同じ集合内の他のエントリに包含される（_covers）エントリを
# 除いた結果を返す。例えば同じファイル内に "Bash(git:*)" と "Bash(git commit:*)" が
# 両方あれば、後者は前者に包含されるため除く（前者は残るので実際の許可は失われない）。
# 判定は厳密版の _covers を使う（グローバル/pathRuleに関わらず、削除後もカバーする
# エントリ自体がこの同じ集合内に残っていることだけを根拠にするため安全）。
_dedupe_covered_within() {
  local lines="$1"
  local -a arr=()
  local line
  while IFS= read -r line; do
    [[ -n "${line}" ]] && arr+=("${line}")
  done <<< "${lines}"

  if (( ${#arr[@]} > 0 )); then
    local i j covered
    for (( i = 0; i < ${#arr[@]}; i++ )); do
      [[ -n "${arr[i]}" ]] || continue
      covered=false
      for (( j = 0; j < ${#arr[@]}; j++ )); do
        (( i == j )) && continue
        [[ -n "${arr[j]}" ]] || continue
        if [[ "${arr[i]}" != "${arr[j]}" ]] && _covers "${arr[j]}" "${arr[i]}"; then
          covered=true
          break
        fi
      done
      [[ "${covered}" == true ]] && arr[i]=""
    done
  fi

  local out="" a
  if (( ${#arr[@]} > 0 )); then
    for a in "${arr[@]}"; do
      [[ -n "${a}" ]] && out="${out}${a}"$'\n'
    done
  fi
  printf '%s' "${out}"
}

# ローカルの permissions.allow を1行ずつ判定し、
#   KEEP<TAB>entry                 …そのまま残す
#   REMOVED<TAB>entry<TAB>covering …グローバルの covering ルールでカバー済みなので削除
# を標準出力へ出す。
_classify_allow() {
  local local_file="$1" global_file="$2"
  local -a global_allow=()
  if [[ -f "${global_file}" ]]; then
    while IFS= read -r line; do
      [[ -n "${line}" ]] && global_allow+=("${line}")
    done < <(jq -r '.permissions.allow // [] | .[]' "${global_file}")
  fi

  local entry g covering
  while IFS= read -r entry; do
    [[ -n "${entry}" ]] || continue
    covering=""
    if (( ${#global_allow[@]} > 0 )); then
      for g in "${global_allow[@]}"; do
        if _covers "${g}" "${entry}"; then
          covering="${g}"
          break
        fi
      done
    fi
    if [[ -n "${covering}" ]]; then
      printf 'REMOVED\t%s\t%s\n' "${entry}" "${covering}"
    else
      printf 'KEEP\t%s\n' "${entry}"
    fi
  done < <(jq -r '.permissions.allow // [] | .[]' "${local_file}")
}

# file の permissions.allow/deny/ask を正規化（_normalize_rule）・重複除去し、
# global_file（空文字なら比較しない）でカバーされる allow エントリ、および
# ~/.claude/claude-perms.json の forbiddenAllow に厳密一致する allow エントリを
# 除外した結果を次の変数にセットする:
#   _FMT_BEFORE / _FMT_AFTER                          … 整理前後の .permissions（比較用）
#   _FMT_NEW_ALLOW_JSON / _FMT_NEW_DENY_JSON / _FMT_NEW_ASK_JSON … 書き戻す新しい配列
#   _FMT_CLASSIFIED                                    … _classify_allow の生出力（報告用。
#                                                         global_file="" のときは空）
#   _FMT_FORBIDDEN_REMOVED                             … forbiddenAllowで除外した生エントリ
#                                                         （改行区切り、報告用）
#   _FMT_RUN_QUIET_ADDED                               … run-quiet修飾版として自動追加した
#                                                         エントリ（改行区切り、報告用）
#   _FMT_SELF_COVERED_REMOVED                          … 同じファイル内の他のallowエントリに
#                                                         包含されるため除外したエントリ
#                                                         （改行区切り、報告用）
# claude-perms.json が壊れている場合は1を返す（呼び出し側は処理を中断すること）。
_compute_format_result() {
  local file="$1" global_file="${2:-}"

  _load_forbidden_allow || return 1

  # 配列ではなく改行区切り文字列で集める（bash 3.2対策。上のコメント参照）。
  local kept_lines="" forbidden_lines=""
  _FMT_CLASSIFIED=""
  if [[ -n "${global_file}" ]]; then
    _FMT_CLASSIFIED="$(_classify_allow "${file}" "${global_file}")"
    if [[ -n "${_FMT_CLASSIFIED}" ]]; then
      local tag entry
      while IFS=$'\t' read -r tag entry _covering; do
        [[ "${tag}" == "KEEP" ]] || continue
        if _is_forbidden "$(_normalize_rule "${entry}")"; then
          forbidden_lines="${forbidden_lines}${entry}"$'\n'
        else
          kept_lines="${kept_lines}${entry}"$'\n'
        fi
      done <<< "${_FMT_CLASSIFIED}"
    fi
  else
    local entry
    while IFS= read -r entry; do
      [[ -n "${entry}" ]] || continue
      if _is_forbidden "$(_normalize_rule "${entry}")"; then
        forbidden_lines="${forbidden_lines}${entry}"$'\n'
      else
        kept_lines="${kept_lines}${entry}"$'\n'
      fi
    done < <(jq -r '.permissions.allow // [] | .[]' "${file}")
  fi
  local kept_lines_before_expand="${kept_lines}"
  kept_lines="$(_expand_run_quiet_lines "${kept_lines}")"
  _FMT_RUN_QUIET_ADDED=""
  local expanded_line
  while IFS= read -r expanded_line; do
    [[ -n "${expanded_line}" ]] || continue
    command grep -qxF "${expanded_line}" <<< "${kept_lines_before_expand}" && continue
    _FMT_RUN_QUIET_ADDED="${_FMT_RUN_QUIET_ADDED}${expanded_line}"$'\n'
  done <<< "${kept_lines}"

  local kept_lines_before_dedup="${kept_lines}"
  kept_lines="$(_dedupe_covered_within "${kept_lines}")"
  _FMT_SELF_COVERED_REMOVED=""
  local dedup_line
  while IFS= read -r dedup_line; do
    [[ -n "${dedup_line}" ]] || continue
    command grep -qxF "${dedup_line}" <<< "${kept_lines}" && continue
    _FMT_SELF_COVERED_REMOVED="${_FMT_SELF_COVERED_REMOVED}${dedup_line}"$'\n'
  done <<< "${kept_lines_before_dedup}"

  _FMT_NEW_ALLOW_JSON="$(_normalize_entries_json <<< "${kept_lines}")"
  _FMT_FORBIDDEN_REMOVED="${forbidden_lines}"

  local deny_lines="" d
  while IFS= read -r d; do
    [[ -n "${d}" ]] && deny_lines="${deny_lines}${d}"$'\n'
  done < <(jq -r '.permissions.deny // [] | .[]' "${file}")
  _FMT_NEW_DENY_JSON="$(_normalize_entries_json <<< "${deny_lines}")"

  local ask_lines="" a
  while IFS= read -r a; do
    [[ -n "${a}" ]] && ask_lines="${ask_lines}${a}"$'\n'
  done < <(jq -r '.permissions.ask // [] | .[]' "${file}")
  _FMT_NEW_ASK_JSON="$(_normalize_entries_json <<< "${ask_lines}")"

  _FMT_BEFORE="$(jq -c '.permissions // {}' "${file}")"
  _FMT_AFTER="$(jq -c \
    --argjson new_allow "${_FMT_NEW_ALLOW_JSON}" \
    --argjson new_deny "${_FMT_NEW_DENY_JSON}" \
    --argjson new_ask "${_FMT_NEW_ASK_JSON}" '
    if .permissions and (.permissions | has("allow")) then .permissions.allow = $new_allow else . end
    | if .permissions and (.permissions | has("deny"))  then .permissions.deny  = $new_deny  else . end
    | if .permissions and (.permissions | has("ask"))   then .permissions.ask   = $new_ask   else . end
    | .permissions // {}
  ' "${file}")"
}

# _compute_format_result が計算済みの _FMT_NEW_*_JSON で file を実際に書き換える。
_write_format_result() {
  local file="$1" target tmp
  target="$(_resolve_write_target "${file}")"
  tmp="$(mktemp "${target}.XXXXXX")"
  jq \
    --argjson new_allow "${_FMT_NEW_ALLOW_JSON}" \
    --argjson new_deny "${_FMT_NEW_DENY_JSON}" \
    --argjson new_ask "${_FMT_NEW_ASK_JSON}" '
    if .permissions and (.permissions | has("allow")) then .permissions.allow = $new_allow else . end
    | if .permissions and (.permissions | has("deny"))  then .permissions.deny  = $new_deny  else . end
    | if .permissions and (.permissions | has("ask"))   then .permissions.ask   = $new_ask   else . end
  ' "${target}" > "${tmp}"
  mv "${tmp}" "${target}"
}

# permissions が {"allow": []} だけ（deny/ask無し、他のトップレベルキー無し）になった
# settings.local.json を削除する。削除後、.claude/ に他のファイルが無ければ
# .claude/ ごと削除する。
_is_empty_permissions_only() {
  local file="$1"
  jq -e '
    (keys == ["permissions"])
    and (.permissions | keys == ["allow"])
    and (.permissions.allow == [])
  ' "${file}" > /dev/null 2>&1
}

_prune_if_empty() {
  local file="$1" dir
  [[ -f "${file}" ]] || return 0
  _is_empty_permissions_only "${file}" || return 0

  rm -f "${file}"
  printf '空になったため削除: %s\n' "${file}"

  dir="$(dirname "${file}")"
  if [[ -d "${dir}" ]] && [[ -z "$(find "${dir}" -mindepth 1 -print -quit 2>/dev/null)" ]]; then
    rmdir "${dir}"
    printf '空になったため削除: %s\n' "${dir}"
  fi
}

_format_one() {
  local dir="${1:-.}" file global_file
  file="$(_local_settings_file "${dir}")"
  global_file="$(_global_settings_file)"
  if [[ ! -f "${file}" ]]; then
    [[ "${VERBOSE}" == true ]] && printf 'skip（settings.local.json なし）: %s\n' "${file}"
    return 0
  fi
  _validate_json "${file}" || return 1

  _compute_format_result "${file}" "${global_file}" || return 1

  if [[ "${_FMT_BEFORE}" == "${_FMT_AFTER}" ]]; then
    printf '変更なし: %s\n' "${file}"
  else
    _write_format_result "${file}"
    printf '整理しました: %s\n' "${file}"

    local removed
    removed="$(command grep $'^REMOVED\t' <<< "${_FMT_CLASSIFIED}" | sort -u || true)"
    if [[ -n "${removed}" ]]; then
      printf 'グローバル設定でカバー済みのため削除:\n'
      while IFS=$'\t' read -r _tag entry covering; do
        printf '  %s  (%s でカバー)\n' "${entry}" "${covering}"
      done <<< "${removed}"
    fi
    if [[ -n "${_FMT_FORBIDDEN_REMOVED}" ]]; then
      printf '禁止エントリ（claude-perms.json）のため削除:\n'
      while IFS= read -r entry; do
        [[ -n "${entry}" ]] && printf '  %s\n' "${entry}"
      done <<< "${_FMT_FORBIDDEN_REMOVED}"
    fi
    if [[ -n "${_FMT_RUN_QUIET_ADDED}" ]]; then
      printf 'run-quiet修飾版を自動追加:\n'
      while IFS= read -r entry; do
        [[ -n "${entry}" ]] && printf '  %s\n' "${entry}"
      done <<< "${_FMT_RUN_QUIET_ADDED}"
    fi
    if [[ -n "${_FMT_SELF_COVERED_REMOVED}" ]]; then
      printf '同じファイル内の他のallowエントリでカバー済みのため削除:\n'
      while IFS= read -r entry; do
        [[ -n "${entry}" ]] && printf '  %s\n' "${entry}"
      done <<< "${_FMT_SELF_COVERED_REMOVED}"
    fi
  fi

  _prune_if_empty "${file}"
}

_cmd_format() {
  _run_over_dirs _format_one "$@"
}

_check_one() {
  local dir="${1:-.}" file global_file
  file="$(_local_settings_file "${dir}")"
  global_file="$(_global_settings_file)"

  if [[ ! -d "${dir%/}/.claude" ]]; then
    printf '.claude/ が見つかりません: %s\n' "${dir}" >&2
    return 1
  fi
  if [[ ! -f "${file}" ]]; then
    printf '[.claude] found（settings.local.json なし）\n'
    return 0
  fi
  _validate_json "${file}" || return 1

  _compute_format_result "${file}" "${global_file}" || return 1

  if [[ "${_FMT_BEFORE}" != "${_FMT_AFTER}" ]]; then
    printf '[.claude] found — permissions が未整理です（claude-perms format で整理）\n'
    return 1
  fi
  if _is_empty_permissions_only "${file}"; then
    printf '[.claude] found — permissions が空です（claude-perms format で削除）\n'
    return 1
  fi
  printf '[.claude] found — permissions は整理済みです\n'
  return 0
}

_cmd_check() {
  _run_over_dirs _check_one "$@"
}

# dir($1)の移管候補（グローバルのルール・pathRuleいずれでも未カバーのローカルallow）を
# 計算する。結果は次の変数にセットする:
#   _CAND_SKIP        … true ならsettings.local.jsonが無い（候補計算自体を行っていない）
#   _CAND_LOCAL_FILE / _CAND_GLOBAL_FILE       … 対象ファイルパス
#   _CAND_LOCAL_COUNT / _CAND_GLOBAL_COUNT     … allowの件数（_CAND_GLOBAL_COUNTは
#                                                 グローバル未作成なら空文字列）
#   _CAND_ENTRIES                              … 候補エントリ（ソート済み・重複除去済み・
#                                                 改行区切り。0件なら空文字列）
# settings.local.jsonが壊れたJSON、またはclaude-perms.json破損によりpathRule判定に
# 失敗した場合は1を返す（呼び出し側はこれを候補0件と混同しないこと）。
_compute_candidates() {
  local dir="${1:-.}"
  _CAND_SKIP=false
  _CAND_LOCAL_FILE="$(_local_settings_file "${dir}")"
  _CAND_GLOBAL_FILE="$(_global_settings_file)"
  if [[ ! -f "${_CAND_LOCAL_FILE}" ]]; then
    _CAND_SKIP=true
    return 0
  fi
  _validate_json "${_CAND_LOCAL_FILE}" || return 1
  local abs_dir
  abs_dir="$(realpath "${dir}")"

  local classified
  classified="$(_classify_allow "${_CAND_LOCAL_FILE}" "${_CAND_GLOBAL_FILE}")"

  local -a raw_candidates=()
  if [[ -n "${classified}" ]]; then
    local tag entry _covering pr_rc
    while IFS=$'\t' read -r tag entry _covering; do
      [[ "${tag}" == "KEEP" ]] || continue
      if _covered_by_path_rule "${entry}" "${abs_dir}"; then
        pr_rc=0
      else
        pr_rc=$?
      fi
      # pr_rc: 0=pathRuleでカバー済み（候補から除外）、1=未カバー（候補に残す）、
      # 2=判定失敗（claude-perms.json破損等）。2を1と混同して静かに成功扱いに
      # しないよう、ここでエラーとして伝播する。
      if (( pr_rc == 2 )); then
        return 1
      elif (( pr_rc == 0 )); then
        continue
      fi
      raw_candidates+=("${entry}")
    done <<< "${classified}"
  fi

  _CAND_ENTRIES=""
  if (( ${#raw_candidates[@]} > 0 )); then
    local entry
    while IFS= read -r entry; do
      [[ -n "${entry}" ]] && _CAND_ENTRIES="${_CAND_ENTRIES}${entry}"$'\n'
    done < <(printf '%s\n' "${raw_candidates[@]}" | sort -u)
  fi

  _CAND_LOCAL_COUNT="$(jq '.permissions.allow // [] | unique | length' "${_CAND_LOCAL_FILE}")"
  if [[ -f "${_CAND_GLOBAL_FILE}" ]]; then
    _CAND_GLOBAL_COUNT="$(jq '.permissions.allow // [] | unique | length' "${_CAND_GLOBAL_FILE}")"
  else
    _CAND_GLOBAL_COUNT=""
  fi
  return 0
}

_candidates_one() {
  local dir="${1:-.}"
  _compute_candidates "${dir}" || return 1
  if [[ "${_CAND_SKIP}" == true ]]; then
    [[ "${VERBOSE}" == true ]] && printf 'skip（settings.local.json なし）: %s\n' "${_CAND_LOCAL_FILE}"
    return 0
  fi

  local -a candidates=()
  local entry
  while IFS= read -r entry; do
    [[ -n "${entry}" ]] && candidates+=("${entry}")
  done <<< "${_CAND_ENTRIES}"
  local candidate_count=${#candidates[@]}

  # 候補が無いDIRは、複数DIR指定時にカバー済みのリポジトリまで毎回表示されて
  # ノイズになるため、--verbose指定時以外は無音でスキップする。
  if [[ "${candidate_count}" -eq 0 && "${VERBOSE}" != true ]]; then
    return 0
  fi

  printf 'ローカル: %s (allow: %s件)\n' "${_CAND_LOCAL_FILE}" "${_CAND_LOCAL_COUNT}"
  if [[ -f "${_CAND_GLOBAL_FILE}" ]]; then
    printf 'グローバル: %s (allow: %s件)\n' "${_CAND_GLOBAL_FILE}" "${_CAND_GLOBAL_COUNT}"
  else
    printf 'グローバル: %s (未作成)\n' "${_CAND_GLOBAL_FILE}"
  fi

  if [[ "${candidate_count}" -eq 0 ]]; then
    printf '移管候補はありません（ローカルのallowは空、またはすべてグローバルのルール・DIRに一致するpathRuleでカバー済みです）\n'
    return 0
  fi

  printf '移管候補 (%s件, グローバルのルール・pathRuleいずれでも未カバー):\n' "${candidate_count}"
  printf '%s\n' "${candidates[@]}" | sed 's/^/  /'
  printf '\n%s へ手動で追記・整理してください（このコマンドは一覧表示のみで自動追加はしません）\n' "${_CAND_GLOBAL_FILE}"
}

# dir($1)の候補を {"target": DIR, "allow": [...]} のコンパクトなJSON1行として出力する
# （claude-perms remove --json / apply へそのまま渡せる形）。settings.local.jsonが
# 無いDIR、または候補0件のDIRは（--verbose指定時であっても）何も出力しない
# ノイズを避けるため機械可読モードでは常にスキップする）。
_candidates_one_json() {
  local dir="${1:-.}"
  _compute_candidates "${dir}" || return 1
  [[ "${_CAND_SKIP}" == true ]] && return 0

  local -a candidates=()
  local entry
  while IFS= read -r entry; do
    [[ -n "${entry}" ]] && candidates+=("${entry}")
  done <<< "${_CAND_ENTRIES}"
  (( ${#candidates[@]} > 0 )) || return 0

  local allow_json
  allow_json="$(printf '%s\n' "${candidates[@]}" | jq -R -s 'split("\n") | map(select(length > 0))')"
  jq -cn --arg target "${dir}" --argjson allow "${allow_json}" '{target: $target, allow: $allow}'
}

# _run_over_dirs と同様、複数DIRをループしてJSONオブジェクト（1行1件）を集め、
# 全体を1つのJSON配列に整形して出力する（--jsonモード専用の集約ヘルパー）。
_run_over_dirs_json() {
  local fn="$1"
  shift
  local -a dirs=("$@")
  (( ${#dirs[@]} == 0 )) && dirs=(".")

  local dir out rc failed=0
  local -a json_objs=()
  for dir in "${dirs[@]}"; do
    if out="$("${fn}" "${dir}")"; then
      rc=0
    else
      rc=$?
    fi
    [[ -n "${out}" ]] && json_objs+=("${out}")
    (( rc != 0 )) && failed=1
  done

  if (( ${#json_objs[@]} == 0 )); then
    printf '[]\n'
  else
    printf '%s\n' "${json_objs[@]}" | jq -s '.'
  fi
  return "${failed}"
}

# claude-perms candidates [DIR...] [--json]
_cmd_candidates() {
  local json=false
  local -a rest=()
  local a
  for a in "$@"; do
    case "${a}" in
      --json) json=true ;;
      *) rest+=("${a}") ;;
    esac
  done
  if (( ${#rest[@]} > 0 )); then
    set -- "${rest[@]}"
  else
    set --
  fi

  if [[ "${json}" == true ]]; then
    _run_over_dirs_json _candidates_one_json "$@"
  else
    _run_over_dirs _candidates_one "$@"
  fi
}

# ~/.claude/claude-perms.json の forbiddenAllow と pathRules[].allow を
# 正規化（_normalize_rule）・重複削除・ソートし、pathRules自体もpathGlobでソートして
# 書き戻す。pathRules[].allowは同一ルール内の他エントリに包含されるものも
# _dedupe_covered_withinで除く（例: "Bash(git:*)" があれば同じallow内の
# "Bash(git commit:*)" は不要）。forbiddenAllowは厳密一致専用の設計
# （前方一致の判定コメント参照）のためこの重複排除は適用しない。ファイルが無ければ
# 何もしない（0を返す）。run-quiet自動補完（_expand_run_quiet_lines）はここでは
# 行わない: pathRulesはmerge/apply時にのみ実体化されるソース定義であり、run-quiet版の
# 実エントリはmerge/applyの仕上げのformatが都度補完するため。
_format_claude_perms_config() {
  local config
  config="$(_claude_perms_config_file)"
  [[ -f "${config}" ]] || return 0
  _validate_json "${config}" || return 1

  local before
  before="$(jq -c '{forbiddenAllow: (.forbiddenAllow // []), pathRules: (.pathRules // [])}' "${config}")"

  local forbidden_lines="" e
  while IFS= read -r e; do
    [[ -n "${e}" ]] && forbidden_lines="${forbidden_lines}${e}"$'\n'
  done < <(jq -r '.forbiddenAllow // [] | .[]' "${config}")
  local new_forbidden_json
  new_forbidden_json="$(_normalize_entries_json <<< "${forbidden_lines}")"

  local rule_count idx new_rules_json='[]'
  rule_count="$(jq '.pathRules // [] | length' "${config}")"
  for (( idx = 0; idx < rule_count; idx++ )); do
    # pathGlobは単一文字列・配列いずれも許容する。ここではformatが行う正規化
    # （順序・重複）の対象にせず、指定された形をそのまま保持する。
    local glob_json allow_lines a new_allow_json rule_json
    glob_json="$(jq -c ".pathRules[${idx}].pathGlob" "${config}")"
    allow_lines=""
    while IFS= read -r a; do
      [[ -n "${a}" ]] && allow_lines="${allow_lines}${a}"$'\n'
    done < <(jq -r ".pathRules[${idx}].allow // [] | .[]" "${config}")
    allow_lines="$(_dedupe_covered_within "${allow_lines}")"
    new_allow_json="$(_normalize_entries_json <<< "${allow_lines}")"
    rule_json="$(jq -cn --argjson glob "${glob_json}" --argjson allow "${new_allow_json}" '{pathGlob: $glob, allow: $allow}')"
    new_rules_json="$(jq -c --argjson rule "${rule_json}" '. + [$rule]' <<< "${new_rules_json}")"
  done
  # 配列pathGlobは先頭要素をソートキーにする（型混在のsort_byだと文字列と配列が
  # 型で分かれてしまい直感的でないため）。
  new_rules_json="$(jq -c 'sort_by(if (.pathGlob | type) == "array" then .pathGlob[0] else .pathGlob end)' <<< "${new_rules_json}")"

  local new_doc
  new_doc="$(jq --argjson forbidden "${new_forbidden_json}" --argjson rules "${new_rules_json}" \
    '.forbiddenAllow = $forbidden | .pathRules = $rules' "${config}")"

  local after
  after="$(jq -c '{forbiddenAllow: (.forbiddenAllow // []), pathRules: (.pathRules // [])}' <<< "${new_doc}")"

  if [[ "${before}" == "${after}" ]]; then
    printf '変更なし: %s\n' "${config}"
    return 0
  fi

  local target tmp
  target="$(_resolve_write_target "${config}")"
  tmp="$(mktemp "${target}.XXXXXX")"
  printf '%s\n' "${new_doc}" > "${tmp}"
  mv "${tmp}" "${target}"
  printf '整理しました: %s\n' "${config}"
}

# ~/.claude/settings.json（グローバル）自体のallow/deny/askを正規化・ソート・重複削除
# する。グローバルより上位の設定は無いため「カバー済みだから削除」判定は行わない。
# permissionsが空になっても、他のキー（model等）を持つ本体設定なので削除もしない。
# あわせて ~/.claude/claude-perms.json（forbiddenAllow・pathRules[].allow）も
# 正規化・重複削除・ソートする（_format_claude_perms_config）。
_cmd_format_global() {
  [[ $# -eq 0 ]] || _error "format-global はDIR引数を取りません"

  local file
  file="$(_global_settings_file)"
  if [[ ! -f "${file}" ]]; then
    printf 'error: not found: %s\n' "${file}" >&2
    return 1
  fi
  _validate_json "${file}" || return 1

  _compute_format_result "${file}" "" || return 1

  if [[ "${_FMT_BEFORE}" == "${_FMT_AFTER}" ]]; then
    printf '変更なし: %s\n' "${file}"
  else
    _write_format_result "${file}"
    printf '整理しました: %s\n' "${file}"

    if [[ -n "${_FMT_FORBIDDEN_REMOVED}" ]]; then
      printf '禁止エントリ（claude-perms.json）のため削除:\n'
      local entry
      while IFS= read -r entry; do
        [[ -n "${entry}" ]] && printf '  %s\n' "${entry}"
      done <<< "${_FMT_FORBIDDEN_REMOVED}"
    fi
    if [[ -n "${_FMT_RUN_QUIET_ADDED}" ]]; then
      printf 'run-quiet修飾版を自動追加:\n'
      local entry
      while IFS= read -r entry; do
        [[ -n "${entry}" ]] && printf '  %s\n' "${entry}"
      done <<< "${_FMT_RUN_QUIET_ADDED}"
    fi
    if [[ -n "${_FMT_SELF_COVERED_REMOVED}" ]]; then
      printf '同じファイル内の他のallowエントリでカバー済みのため削除:\n'
      local entry
      while IFS= read -r entry; do
        [[ -n "${entry}" ]] && printf '  %s\n' "${entry}"
      done <<< "${_FMT_SELF_COVERED_REMOVED}"
    fi
  fi

  _format_claude_perms_config
}

# エントリ($1)がパターン($2)に一致するか判定する。
#   glob=true : $2 をbashのglobとしてそのまま解釈する（*, ? 等）。まず生のまま
#     比較し、一致しなければ双方を正規化（_normalize_rule）した上でも比較する。
#     例えば pattern "Bash(command *)" は生の "Bash(command:*)"（正規化済み
#     エントリ）には一致しないが、正規化後の比較で拾える。一方 "Bash(npm run *)"
#     のような広いglob検索で "Bash(npm run test)" を拾う既存の動作は、生のまま
#     の比較で先に一致するため維持される。
#   glob=false（既定）: 双方を正規化（_normalize_rule）した上での厳密一致
_matches_pattern() {
  local entry="$1" pattern="$2" glob="$3"
  if [[ "${glob}" == true ]]; then
    # shellcheck disable=SC2053  # globとして評価するためあえて非クォート
    if [[ "${entry}" == ${pattern} ]]; then
      return 0
    fi
    local norm_entry norm_pattern
    norm_entry="$(_normalize_rule "${entry}")"
    norm_pattern="$(_normalize_rule "${pattern}")"
    # shellcheck disable=SC2053
    [[ "${norm_entry}" == ${norm_pattern} ]]
    return
  fi
  [[ "$(_normalize_rule "${entry}")" == "$(_normalize_rule "${pattern}")" ]]
}

# エントリ($1)が_REMOVE_PATTERN/_REMOVE_GLOBに一致するか判定する
# （claude-perms remove/remove-global専用のマッチャー。_REMOVE_MATCH_FNへセットして使う）。
_pattern_match_entry() {
  _matches_pattern "$1" "${_REMOVE_PATTERN}" "${_REMOVE_GLOB}"
}

# エントリ($1)の正規化後の値が_REMOVE_JSON_SET（正規化済み・改行区切り）に厳密一致するか
# 判定する（claude-perms remove --json専用のマッチャー。_REMOVE_MATCH_FNへセットして使う）。
_json_set_match_entry() {
  local norm_e
  norm_e="$(_normalize_rule "$1")"
  [[ -n "${_REMOVE_JSON_SET:-}" ]] || return 1
  command grep -qxF "${norm_e}" <<< "${_REMOVE_JSON_SET}"
}

# file 内の allow/deny/ask から _REMOVE_MATCH_FN（引数1つ・エントリ文字列を取り、
# 一致すれば0を返す関数名。remove系コマンドが呼び出し前に設定する）に一致する
# エントリを探す。_REMOVE_APPLY=true なら実際に削除して書き戻し、false（既定）
# なら一致内容を表示するだけ（dry-run、書き換えない）。
_remove_from_file() {
  local file="$1"
  local report="" matched_any=false
  local allow_kept="" deny_kept="" ask_kept="" e

  while IFS= read -r e; do
    [[ -n "${e}" ]] || continue
    if "${_REMOVE_MATCH_FN}" "${e}"; then
      report="${report}  [allow] ${e}"$'\n'
      matched_any=true
    else
      allow_kept="${allow_kept}${e}"$'\n'
    fi
  done < <(jq -r '.permissions.allow // [] | .[]' "${file}")

  while IFS= read -r e; do
    [[ -n "${e}" ]] || continue
    if "${_REMOVE_MATCH_FN}" "${e}"; then
      report="${report}  [deny] ${e}"$'\n'
      matched_any=true
    else
      deny_kept="${deny_kept}${e}"$'\n'
    fi
  done < <(jq -r '.permissions.deny // [] | .[]' "${file}")

  while IFS= read -r e; do
    [[ -n "${e}" ]] || continue
    if "${_REMOVE_MATCH_FN}" "${e}"; then
      report="${report}  [ask] ${e}"$'\n'
      matched_any=true
    else
      ask_kept="${ask_kept}${e}"$'\n'
    fi
  done < <(jq -r '.permissions.ask // [] | .[]' "${file}")

  if [[ "${matched_any}" != true ]]; then
    printf '一致なし: %s\n' "${file}"
    return 0
  fi

  if [[ "${_REMOVE_APPLY}" != true ]]; then
    printf '[dry-run] 一致（--apply で削除）: %s\n' "${file}"
    printf '%s' "${report}"
    return 0
  fi

  local new_allow_json new_deny_json new_ask_json
  new_allow_json="$(jq -R -s 'split("\n") | map(select(length > 0))' <<< "${allow_kept}")"
  new_deny_json="$(jq -R -s 'split("\n") | map(select(length > 0))' <<< "${deny_kept}")"
  new_ask_json="$(jq -R -s 'split("\n") | map(select(length > 0))' <<< "${ask_kept}")"

  local target tmp
  target="$(_resolve_write_target "${file}")"
  tmp="$(mktemp "${target}.XXXXXX")"
  jq \
    --argjson new_allow "${new_allow_json}" \
    --argjson new_deny "${new_deny_json}" \
    --argjson new_ask "${new_ask_json}" '
    if .permissions and (.permissions | has("allow")) then .permissions.allow = $new_allow else . end
    | if .permissions and (.permissions | has("deny"))  then .permissions.deny  = $new_deny  else . end
    | if .permissions and (.permissions | has("ask"))   then .permissions.ask   = $new_ask   else . end
  ' "${target}" > "${tmp}"
  mv "${tmp}" "${target}"
  printf '削除しました: %s\n' "${file}"
  printf '%s' "${report}"
}

_remove_one() {
  local dir="${1:-.}" file
  file="$(_local_settings_file "${dir}")"
  if [[ ! -f "${file}" ]]; then
    [[ "${VERBOSE}" == true ]] && printf 'skip（settings.local.json なし）: %s\n' "${file}"
    return 0
  fi
  _validate_json "${file}" || return 1
  _remove_from_file "${file}" || return 1
  if [[ "${_REMOVE_APPLY}" == true ]]; then
    _prune_if_empty "${file}"
  fi
  return 0
}

# JSON入力（candidates --json と同じ形: [{"target":DIR,"allow":[...]},...]）の
# 1件（idx番目）を処理する。対象targetのsettings.local.jsonから、allowに列挙された
# エントリを厳密一致（正規化後）でallow/deny/askから探し、_REMOVE_APPLYに従って
# 削除・報告する（_remove_one をそのまま再利用。_REMOVE_JSON_SETをこの件用に
# セットしてから呼ぶ）。
_remove_json_one() {
  local content="$1" idx="$2"
  local target
  target="$(jq -r ".[${idx}].target" <<< "${content}")"
  if [[ -z "${target}" || "${target}" == "null" ]]; then
    printf 'error: JSON[%s].target が指定されていません\n' "${idx}" >&2
    return 1
  fi

  _REMOVE_JSON_SET=""
  local a
  while IFS= read -r a; do
    [[ -n "${a}" ]] && _REMOVE_JSON_SET="${_REMOVE_JSON_SET}$(_normalize_rule "${a}")"$'\n'
  done < <(jq -r ".[${idx}].allow // [] | .[]" <<< "${content}")

  _remove_one "${target}"
}

# claude-perms remove --json <FILE|-> [--apply|-y]
# candidates --json の出力（[{"target":DIR,"allow":[...]},...]）をそのまま渡すと、
# targetごとのsettings.local.jsonからallowに列挙されたエントリを厳密一致
# （正規化後、glob展開はしない）で探して削除する。FILEに"-"を指定すると標準入力
# から読む。既定はdry-run、--apply/-yで実際に削除する。
_cmd_remove_json() {
  local apply=false
  local -a rest=()
  local a
  for a in "$@"; do
    case "${a}" in
      --apply|-y) apply=true ;;
      *) rest+=("${a}") ;;
    esac
  done
  (( ${#rest[@]} > 0 )) || _error "usage: claude-perms remove --json <FILE|-> [--apply]"
  (( ${#rest[@]} == 1 )) || _error "remove --json はFILE以外の引数（DIR等）を取りません"

  local src="${rest[0]}" content
  if [[ "${src}" == "-" ]]; then
    content="$(cat)"
  else
    [[ -f "${src}" ]] || _error "JSONファイルが見つかりません: ${src}"
    content="$(cat "${src}")"
  fi
  local err
  if ! err="$(jq empty <<< "${content}" 2>&1)"; then
    printf 'error: 無効なJSON: %s\n' "${src}" >&2
    printf '  %s\n' "${err}" >&2
    return 1
  fi

  _REMOVE_APPLY="${apply}"
  _REMOVE_MATCH_FN=_json_set_match_entry

  local count idx failed=0 printed_any=false out rc
  count="$(jq 'length' <<< "${content}")"
  for (( idx = 0; idx < count; idx++ )); do
    if out="$(_remove_json_one "${content}" "${idx}" 2>&1)"; then
      rc=0
    else
      rc=$?
    fi
    if [[ -n "${out}" ]]; then
      [[ "${printed_any}" == true ]] && printf '\n'
      printf '%s\n' "${out}"
      printed_any=true
    fi
    (( rc != 0 )) && failed=1
  done
  return "${failed}"
}

# claude-perms remove <pattern> [DIR...] [--glob] [--apply|-y]
# claude-perms remove --json <FILE|-> [--apply|-y]
_cmd_remove() {
  local glob=false apply=false json=false
  local -a rest=()
  local a
  for a in "$@"; do
    case "${a}" in
      --glob) glob=true ;;
      --apply|-y) apply=true ;;
      --json) json=true ;;
      *) rest+=("${a}") ;;
    esac
  done

  if [[ "${json}" == true ]]; then
    [[ "${glob}" == true ]] && _error "--json と --glob は同時に指定できません"
    if (( ${#rest[@]} > 0 )); then
      set -- "${rest[@]}"
    else
      set --
    fi
    [[ "${apply}" == true ]] && set -- "$@" --apply
    _cmd_remove_json "$@"
    return
  fi

  (( ${#rest[@]} > 0 )) || _error "usage: claude-perms remove <pattern> [DIR...] [--glob] [--apply]"

  _REMOVE_PATTERN="${rest[0]}"
  _REMOVE_GLOB="${glob}"
  _REMOVE_APPLY="${apply}"
  _REMOVE_MATCH_FN=_pattern_match_entry

  set -- "${rest[@]}"
  shift
  _run_over_dirs _remove_one "$@"
}

# claude-perms remove-global <pattern> [--glob] [--apply|-y]
_cmd_remove_global() {
  local glob=false apply=false
  local -a rest=()
  local a
  for a in "$@"; do
    case "${a}" in
      --glob) glob=true ;;
      --apply|-y) apply=true ;;
      *) rest+=("${a}") ;;
    esac
  done
  (( ${#rest[@]} > 0 )) || _error "usage: claude-perms remove-global <pattern> [--glob] [--apply]"
  (( ${#rest[@]} == 1 )) || _error "remove-global はpattern以外の引数（DIR等）を取りません"

  _REMOVE_PATTERN="${rest[0]}"
  _REMOVE_GLOB="${glob}"
  _REMOVE_APPLY="${apply}"
  _REMOVE_MATCH_FN=_pattern_match_entry

  local file
  file="$(_global_settings_file)"
  if [[ ! -f "${file}" ]]; then
    printf 'error: not found: %s\n' "${file}" >&2
    return 1
  fi
  _validate_json "${file}" || return 1
  _remove_from_file "${file}"
}

# ~/.claude/claude-perms.json の pathRules を "glob<TAB>allow(JSON配列文字列)" の
# 改行区切りで返す。ファイルが無ければ何も出力しない（0を返す）。壊れたJSONの場合は
# パスとエラーを報告して1を返す。
_path_rules_tsv() {
  local config
  config="$(_claude_perms_config_file)"
  [[ -f "${config}" ]] || return 0
  _validate_json "${config}" || return 1
  jq -r '
    .pathRules // [] | .[] | . as $r
    | ($r.pathGlob | if type == "array" then . else [.] end)[]
    | [., ($r.allow // [] | tojson)] | @tsv
  ' "${config}"
}

# abs_dir($1)に一致するpathRuleのallowエントリ（生文字列）を改行区切りで返す。
# 一致なし・claude-perms.jsonが無ければ空文字列。壊れたJSONの場合は1を返す。
_matched_path_rule_allow() {
  local abs_dir="$1" rules_tsv
  rules_tsv="$(_path_rules_tsv)" || return 1
  [[ -n "${rules_tsv}" ]] || return 0

  local glob allow_json a
  while IFS=$'\t' read -r glob allow_json; do
    [[ -n "${glob}" ]] || continue
    glob="${glob/#\~/${HOME}}"
    # shellcheck disable=SC2053  # globとして評価するためあえて非クォート
    if [[ "${abs_dir}" == ${glob} ]]; then
      while IFS= read -r a; do
        [[ -n "${a}" ]] && printf '%s\n' "${a}"
      done < <(jq -r '.[]' <<< "${allow_json}")
    fi
  done <<< "${rules_tsv}"
}

# entry($1)がabs_dir($2)に一致するpathRuleのallowでカバーされるか判定する
# （_covers_lenient使用。run-quiet修飾版もカバー済み扱いにする）。
# candidatesが「pathRuleで意図的にスコープ済みのエントリ」を除外するために使う。
# 終了コードは3値: 0=カバー済み、1=未カバー（正常）、2=判定失敗
# （~/.claude/claude-perms.json が壊れたJSON等）。呼び出し側は2を「未カバー」と
# 混同せず、エラーとして伝播すること。
_covered_by_path_rule() {
  local entry="$1" abs_dir="$2" tsv
  tsv="$(_matched_path_rule_allow "${abs_dir}")" || return 2
  [[ -n "${tsv}" ]] || return 1
  local pr
  while IFS= read -r pr; do
    [[ -n "${pr}" ]] || continue
    _covers_lenient "${pr}" "${entry}" && return 0
  done <<< "${tsv}"
  return 1
}

# DIRの絶対パスに一致するpathRuleのallowをDIR/.claude/settings.local.jsonへ追記し、
# format と同じ正規化（正規化・重複削除・グローバルカバー判定・禁止エントリ除去・
# run-quiet修飾版の自動補完）を適用する。
_merge_one() {
  local dir="${1:-.}" abs_dir matched_tsv file
  [[ -d "${dir}" ]] || _error "ディレクトリが見つかりません: ${dir}"
  abs_dir="$(realpath "${dir}")"
  matched_tsv="$(_matched_path_rule_allow "${abs_dir}")" || return 1

  local -a matched_allow=()
  if [[ -n "${matched_tsv}" ]]; then
    local a
    while IFS= read -r a; do
      [[ -n "${a}" ]] && matched_allow+=("${a}")
    done <<< "${matched_tsv}"
  fi

  if (( ${#matched_allow[@]} == 0 )); then
    [[ "${VERBOSE}" == true ]] && printf 'skip（一致するpathRuleなし）: %s\n' "${abs_dir}"
    return 0
  fi

  file="$(_local_settings_file "${dir}")"
  if [[ ! -f "${file}" ]]; then
    mkdir -p "$(dirname "${file}")"
    printf '{"permissions": {"allow": []}}\n' > "${file}"
  else
    _validate_json "${file}" || return 1
  fi

  local target tmp new_allow_json
  target="$(_resolve_write_target "${file}")"
  new_allow_json="$(printf '%s\n' "${matched_allow[@]}" | jq -R -s 'split("\n") | map(select(length > 0))')"
  tmp="$(mktemp "${target}.XXXXXX")"
  jq --argjson add "${new_allow_json}" '
    .permissions //= {}
    | .permissions.allow = ((.permissions.allow // []) + $add | unique)
  ' "${target}" > "${tmp}"
  mv "${tmp}" "${target}"

  printf 'pathRuleを反映: %s\n' "${file}"
  printf '%s\n' "${matched_allow[@]}" | sort -u | sed 's/^/  /'

  _format_one "${dir}"
}

# claude-perms merge [DIR...]
_cmd_merge() {
  _run_over_dirs _merge_one "$@"
}

# DIRの絶対パスに一致するpathRuleのallowで、DIR/.claude/settings.local.json の
# permissions.allow を置き換え、format と同じ正規化（正規化・重複削除・グローバル
# カバー判定・禁止エントリ除去・run-quiet修飾版の自動補完）を適用する。merge
# （追記）に対し、apply は置き換え（＝pathRuleに無いローカル限定のallowは
# 消える）。一致するpathRuleが無いDIRはmergeと同様に何もしない（settings.local.json
# を空にするような操作はしない）。
_apply_one() {
  local dir="${1:-.}" abs_dir matched_tsv file
  [[ -d "${dir}" ]] || _error "ディレクトリが見つかりません: ${dir}"
  abs_dir="$(realpath "${dir}")"
  matched_tsv="$(_matched_path_rule_allow "${abs_dir}")" || return 1

  local -a matched_allow=()
  if [[ -n "${matched_tsv}" ]]; then
    local a
    while IFS= read -r a; do
      [[ -n "${a}" ]] && matched_allow+=("${a}")
    done <<< "${matched_tsv}"
  fi

  if (( ${#matched_allow[@]} == 0 )); then
    [[ "${VERBOSE}" == true ]] && printf 'skip（一致するpathRuleなし）: %s\n' "${abs_dir}"
    return 0
  fi

  file="$(_local_settings_file "${dir}")"
  if [[ ! -f "${file}" ]]; then
    mkdir -p "$(dirname "${file}")"
    printf '{"permissions": {"allow": []}}\n' > "${file}"
  else
    _validate_json "${file}" || return 1
  fi

  local target tmp new_allow_json
  target="$(_resolve_write_target "${file}")"
  new_allow_json="$(printf '%s\n' "${matched_allow[@]}" | jq -R -s 'split("\n") | map(select(length > 0)) | unique')"
  tmp="$(mktemp "${target}.XXXXXX")"
  jq --argjson replace "${new_allow_json}" '
    .permissions //= {}
    | .permissions.allow = $replace
  ' "${target}" > "${tmp}"
  mv "${tmp}" "${target}"

  printf 'pathRuleで置き換え: %s\n' "${file}"
  printf '%s\n' "${matched_allow[@]}" | sort -u | sed 's/^/  /'

  _format_one "${dir}"
}

# claude-perms apply [DIR...]
_cmd_apply() {
  _run_over_dirs _apply_one "$@"
}

_require_jq

command_name="${1:-}"
[[ -n "${command_name}" ]] || _error "usage: claude-perms {format|format-global|check|candidates|remove|remove-global|merge|apply} [DIR...]"
shift

case "${command_name}" in
  format)        _cmd_format "$@" ;;
  format-global) _cmd_format_global "$@" ;;
  check)         _cmd_check "$@" ;;
  candidates)    _cmd_candidates "$@" ;;
  remove)        _cmd_remove "$@" ;;
  remove-global) _cmd_remove_global "$@" ;;
  merge)         _cmd_merge "$@" ;;
  apply)         _cmd_apply "$@" ;;
  *) _error "unknown command: ${command_name} (format/format-global/check/candidates/remove/remove-global/merge/apply が使えます)" ;;
esac
