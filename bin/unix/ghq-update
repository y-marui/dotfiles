#!/usr/bin/env bash
# ghq-update: ghq 管理リポジトリを更新する
#
# 使い方:
#   ghq-update [options]
#
# オプション:
#   --all           sync 対象を「keep-up-to-date=true」から
#                   「keep-up-to-date=true ∪ .venv/node_modules が存在する」に拡張する
#   --pull-all      fetch + pull 対象を全リポジトリに拡張する（sync 対象には影響しない）
#   --sync-only     fetch + pull をスキップし、sync 対象への処理（uv sync --upgrade /
#                   npm update && npm run build --if-present）のみ実行する
#                   （事前に ghq-pull 等で pull 済みであることが前提）
#   --pull-only     fetch + pull のみ実行し、sync 対象への処理をスキップする
#                   （--sync-only と同時指定は不可）
#   --no-auto-pr    uv sync --upgrade / npm update でロックファイルのみ更新された場合の
#                   自動 PR 作成を無効化し、従来通り working tree に dirty な差分を残す
#   -f, --filter PATTERN  リポジトリパスが正規表現 PATTERN にマッチするものだけを対象にする
#   -h, --help      ヘルプを表示
#
# 動作:
#   sync 対象（uv/npm 共通）:
#     - デフォルト: keep-up-to-date=true のリポジトリ
#     - --all:      上記 ∪ .venv または node_modules が存在するリポジトリ
#     - .venv が存在する場合: uv sync --upgrade を実行する
#       （pyproject.toml/uv.lock はあるが .venv が無い場合は warning を出し
#         uv sync のみスキップする。uv 設定自体が無ければ何もしない）
#     - node_modules が存在する場合: npm update && npm run build --if-present を実行する
#       （package.json はあるが node_modules が無い場合は warning を出し
#         npm 処理のみスキップする。install 済みでなければ自動 install はしない。
#         package.json 自体が無ければ何もしない）
#     - pull は通常通り行う
#   fetch + pull 対象（pull 対象）:
#     - デフォルト: sync 対象と同じ
#     - --pull-all: 全リポジトリに拡張する（旧 --all 相当。--all と併用すると
#       「全リポジトリ pull + sync 対象を sync」というフル動作になる）
#     - --sync-only 指定時は pull 自体を行わず、sync 対象にのみ処理する
#   共通:
#     - dotfiles・dev-charter は他より先に処理する（ghq-status の基準バージョン等、
#       他リポジトリの処理より先に最新化しておきたいため）
#     - upstream という名前の remote があれば、fetch/pull の前に `gh repo sync` で
#       upstream のデフォルトブランチを origin・ローカル双方へ fast-forward 反映する
#       （diverge していれば警告のみ。gh 未インストール・未認証ならスキップ）
#     - pull は各リポジトリで git-pull-all を実行する（ghq-pull と同じ手順。fetch は
#       detached HEAD でも実行し、現在のブランチ以外のローカルブランチも fast-forward 同期する）
#     - detached HEAD・upstream ブランチ未設定の場合は、依存更新（uv/npm）をスキップする
#     - uv.lock/package-lock.json のみ dirty な場合は一時的に stash して pull し、
#       pull 後に復元する（復元時にコンフリクトした場合は stash を残したまま失敗として扱う）
#     - それら以外にも dirty な変更がある場合は、依存更新をスキップする
#     - 失敗（fetch・pull・stash 復元・uv sync・npm update/build の失敗）したリポジトリは
#       [failed] を表示し、そのリポジトリの依存更新は行わず、処理は続行して、最後に
#       終了コード1で終了する（スキップ・警告は終了コード0）
#   auto-pr（デフォルト有効。--no-auto-pr で無効化）:
#     - uv sync --upgrade / npm update の結果、対応するロックファイル（uv.lock /
#       package-lock.json）のみが dirty な場合、専用ブランチ（chore/uv-lock-update /
#       chore/npm-lock-update）にコミットして force push し、gh で PR を作成する
#     - PR先は通常 origin（自分の fork）。upstream という名前の remote があり、
#       かつその owner/repo が bin/ghq-upstream-pr-allow に列挙されたパターンに
#       一致する場合のみ、upstream（fork元）へ PR を作成する
#     - 既に同名ブランチで open な PR があれば push だけでその PR に反映される
#     - gh 未インストール・未認証、またはロックファイル以外にも dirty な変更がある場合は
#       スキップし、従来通り working tree に差分を残す

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=bin/unix/_ghq-lib.sh
source "${SCRIPT_DIR}/_ghq-lib.sh"

ALL=false
PULL_ALL=false
SYNC_ONLY=false
PULL_ONLY=false
AUTO_PR=true
FILTER=''
FAILED=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --all)          ALL=true; shift ;;
    --pull-all)     PULL_ALL=true; shift ;;
    --sync-only) SYNC_ONLY=true; shift ;;
    --pull-only)    PULL_ONLY=true; shift ;;
    --no-auto-pr)   AUTO_PR=false; shift ;;
    -f|--filter)
      [[ $# -lt 2 ]] && { echo "error: --filter requires an argument" >&2; exit 1; }
      FILTER="$2"; shift 2 ;;
    -h|--help)      sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *)              echo "error: unknown option: $1" >&2; exit 1 ;;
  esac
done

if [[ "$PULL_ONLY" == true ]] && [[ "$SYNC_ONLY" == true ]]; then
  echo "error: --pull-only と --sync-only は同時に指定できません" >&2
  exit 1
fi

if ! command -v ghq >/dev/null 2>&1; then
  echo "error: 'ghq' が見つかりません。" >&2
  exit 1
fi

while IFS= read -r f; do
  kutd="$(git -C "$f" config --bool local.keep-up-to-date 2>/dev/null)" || kutd=''
  has_venv=false
  [[ -d "$f/.venv" ]] && has_venv=true
  has_node_modules=false
  [[ -d "$f/node_modules" ]] && has_node_modules=true

  in_sync_target=false
  [[ "$kutd" == true || ( "$ALL" == true && ( "$has_venv" == true || "$has_node_modules" == true ) ) ]] && in_sync_target=true

  in_visit_set=false
  [[ "$in_sync_target" == true || "$PULL_ALL" == true ]] && in_visit_set=true

  [[ "$in_visit_set" == true ]] || continue

  echo ""
  echo "==> $f"

  detached=false
  base_branch="$(git -C "$f" symbolic-ref --short HEAD 2>/dev/null)" || detached=true

  if [[ "$SYNC_ONLY" == false ]]; then
    if ! _ghq_pull_repo "$f"; then
      FAILED=$((FAILED + 1))
      continue
    fi
  fi

  if [[ "$detached" == true ]]; then
    echo "  [skip] detached HEAD"
    continue
  fi
  if [[ "$SYNC_ONLY" == false ]]; then
    if [[ "$_GHQ_PULL_DIRTY" == true ]]; then
      echo "  [skip] dirty working tree"
      continue
    fi
    git -C "$f" rev-parse "@{u}" &>/dev/null || { echo "  [skip] no upstream"; continue; }
  fi

  if [[ "$in_sync_target" == true ]] && [[ "$PULL_ONLY" == false ]]; then
    if [[ "$has_venv" == true ]]; then
      if ! (cd "$f" && uv sync --upgrade); then
        echo "  [failed] uv sync --upgrade" >&2
        FAILED=$((FAILED + 1))
      elif [[ "$AUTO_PR" == true ]]; then
        _ghq_auto_pr_lockfile "$f" "$base_branch" uv.lock "$_GHQ_UV_LOCK_PR_BRANCH" \
          "chore: update uv.lock" \
          "uv sync --upgrade により生成された uv.lock の更新です（ghq-update の自動 PR 機能）。"
      fi
    else
      has_uv_project=false
      { [[ -f "$f/pyproject.toml" ]] || [[ -f "$f/uv.lock" ]]; } && has_uv_project=true
      if [[ "$has_uv_project" == true ]]; then
        echo "  [warn] keep-up-to-date=true ですが .venv が見つかりません（uv 設定はあるので uv sync 未実行の可能性があります。uv sync をスキップします）" >&2
      fi
    fi

    if [[ "$has_node_modules" == true ]]; then
      if ! (cd "$f" && npm update && npm run build --if-present); then
        echo "  [failed] npm update / build" >&2
        FAILED=$((FAILED + 1))
      elif [[ "$AUTO_PR" == true ]]; then
        _ghq_auto_pr_lockfile "$f" "$base_branch" package-lock.json "$_GHQ_NPM_LOCK_PR_BRANCH" \
          "chore: update package-lock.json" \
          "npm update により生成された package-lock.json の更新です（ghq-update の自動 PR 機能）。"
      fi
    else
      has_npm_project=false
      [[ -f "$f/package.json" ]] && has_npm_project=true
      if [[ "$has_npm_project" == true ]]; then
        echo "  [warn] keep-up-to-date=true ですが node_modules が見つかりません（npm install 未実行の可能性があります。npm update/build をスキップします）" >&2
      fi
    fi
  fi
done < <(_ghq_ordered_list "$FILTER")

[[ "$FAILED" -eq 0 ]] || exit 1
