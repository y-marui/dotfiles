#!/usr/bin/env bash
# 自作アプリを一括インストールするスクリプト
# デフォルト（上書きモード）:
#   同バージョン（DMG のタイムスタンプが同じ）はスキップ
#   1. 起動中のアプリを終了
#   2. DMG からインストール（既存 .app を上書き）
#   3. アプリを起動してウィジェット拡張を登録
#   4. ウィジェット編集画面を開く
# --force / -f フラグ（強制インストールモード）:
#   バージョンチェックをスキップして常にインストール
# --reinstall / -r フラグ（再インストールモード）:
#   同バージョン（DMG のタイムスタンプが同じ）はスキップ
#   1. 起動中のアプリを終了・既存の .app を削除
#   2. ウィジェットキャッシュをクリア
#   3. DMG からインストール
#   4. アプリを起動してウィジェット拡張を登録
#   5. ウィジェット編集画面を開く
# --uninstall / -u フラグ（アンインストールモード）:
#   引数指定時: 指定アプリを削除
#   引数なし: このスクリプトでインストールしたアプリをすべて削除
# --no-gui フラグ（GUI 操作なしモード）:
#   アプリの終了・ウィジェットキャッシュのクリア・起動・ウィジェット編集画面の表示を省く
#   （ssh 越し・ログインしていない Mac 向け）。ウィジェット拡張は、そのアプリを
#   次に起動したときに登録される。他のモードと組み合わせられる
# --migrate-old / --no-migrate-old フラグ（移行期間の措置。既定は ON）:
#   旧い置き場（/Applications 直下）に残っている同じ自作アプリを、インストール時に削除する／しない。
#   削除するのは、新しい置き場に同名のアプリがまだなく、App Store 版でなく、バンドル ID が
#   同じときだけ。新旧の両方にあるときは削除せず知らせる。環境変数
#   INSTALL_MY_APPS_MIGRATE_OLD=0 でも切れる。全 Mac の移行が済んだら既定を OFF にする
#   （ロジックは残す）
# 環境変数 INSTALL_MY_APPS_SWIFT_DIR / INSTALL_MY_APPS_TAURI_DIR:
#   種類ごとの入れ先を変える（/Applications 直下に入れたいときは /Applications を指定）
# -h, --help フラグ:
#   このヘルプを表示
#
# インストール先: Swift のアプリは /Applications/My Swift、Tauri のアプリは /Applications/My Tauri
# （App Store 版と同名でも衝突しないよう、/Applications 直下とは分ける）。
# 種類は DMG の置き場で決まる: iCloud の Build/Swift/*.dmg と Build/Tauri/*.dmg。
# 移行前の Build 直下の DMG は Swift として扱う（Build/Swift へ移すこと）。

set -euo pipefail

# テストでは環境変数で一時ディレクトリに差し替える（実環境の /Applications には触れない）
readonly BUILD_DIR="${INSTALL_MY_APPS_BUILD_DIR:-$HOME/Library/Mobile Documents/com~apple~CloudDocs/Build}"
readonly APPS_ROOT="${INSTALL_MY_APPS_APPS_ROOT:-/Applications}"
# 入れ先は種類ごとに環境変数で変えられる。/Applications 直下に入れたいときは
# INSTALL_MY_APPS_SWIFT_DIR=/Applications のように指定する（旧い置き場の整理は、入れ先と同じなので行わない）
readonly SWIFT_APPS_DIR="${INSTALL_MY_APPS_SWIFT_DIR:-$APPS_ROOT/My Swift}"
readonly TAURI_APPS_DIR="${INSTALL_MY_APPS_TAURI_DIR:-$APPS_ROOT/My Tauri}"

# 移行期間の措置（旧い置き場の自作アプリの削除）の既定。全 Mac の移行が済んだら 0 にする。
readonly MIGRATE_OLD_DEFAULT="${INSTALL_MY_APPS_MIGRATE_OLD:-1}"

installed_apps=()
installed_paths=()
both_exist=" "
dmg_files=()

# DMG の置き場から種類を決める: Build/Tauri は Tauri、それ以外（Build/Swift と、
# 移行前の Build 直下）は Swift
kind_of_dmg() {
    case "$(dirname "$1")" in
        "$BUILD_DIR/Tauri") echo tauri ;;
        *) echo swift ;;
    esac
}

apps_dir_of_dmg() {
    case "$(kind_of_dmg "$1")" in
        tauri) echo "$TAURI_APPS_DIR" ;;
        *) echo "$SWIFT_APPS_DIR" ;;
    esac
}

# DMG を dmg_files に集める。同じ名前が Build/Swift か Build/Tauri にもある Build 直下の DMG は使わない
collect_dmgs() {
    local dir dmg name
    for dir in "$BUILD_DIR/Swift" "$BUILD_DIR/Tauri"; do
        for dmg in "$dir"/*.dmg; do
            [[ -f "$dmg" ]] && dmg_files+=("$dmg")
        done
    done
    for dmg in "$BUILD_DIR"/*.dmg; do
        [[ -f "$dmg" ]] || continue
        name=$(basename "$dmg")
        [[ -f "$BUILD_DIR/Swift/$name" || -f "$BUILD_DIR/Tauri/$name" ]] && continue
        dmg_files+=("$dmg")
    done
}

# アプリ名から DMG を探す（Swift → Tauri → 移行前の Build 直下の順）
find_dmg() {
    local name="$1" dir
    for dir in "$BUILD_DIR/Swift" "$BUILD_DIR/Tauri" "$BUILD_DIR"; do
        if [[ -f "$dir/$name.dmg" ]]; then
            echo "$dir/$name.dmg"
            return 0
        fi
    done
    return 1
}

bundle_id_of() {
    /usr/libexec/PlistBuddy -c "Print :CFBundleIdentifier" "$1/Contents/Info.plist" 2>/dev/null || true
}

# 移行期間の措置: /Applications 直下に残っている旧い自作アプリを削除する。
# 削除するのは、(1) この実行の前から新旧の両方にあったのではなく、(2) App Store 版でなく、
# (3) バンドル ID がインストールするアプリと同じときだけ。両方にあったときは削除せず知らせる。
migrate_legacy_app() {
    local name="$1" app_in_dmg="$2" new_app="$3"
    $migrate_old || return 0
    local legacy="$APPS_ROOT/${name}.app"
    [[ -d "$legacy" ]] || return 0
    # 入れ先が旧い置き場そのもの（環境変数で /Applications 直下を指定した）なら整理しない
    [[ "$legacy" == "$new_app" ]] && return 0

    if [[ "$both_exist" == *" $name "* ]]; then
        echo "  注意: 新旧の両方にあるため、旧い場所は削除しません: $legacy"
        return 0
    fi
    if [[ -d "$legacy/Contents/_MASReceipt" ]]; then
        echo "  注意: App Store 版のため、旧い場所は削除しません: $legacy"
        return 0
    fi
    local legacy_id new_id
    legacy_id=$(bundle_id_of "$legacy")
    new_id=$(bundle_id_of "$app_in_dmg")
    if [[ -z "$new_id" || "$legacy_id" != "$new_id" ]]; then
        echo "  注意: バンドル ID が違うため、旧い場所は削除しません: $legacy"
        return 0
    fi
    quit_app "$name" "$legacy"
    echo "  旧い場所を削除: $legacy"
    rm -rf "$legacy"
}

# この実行の前の状態で、新旧の両方に同名のアプリがあるものを控える（再インストールで
# 新しい置き場のアプリを消す前に確認するため）
note_both_exist() {
    local dmg="$1" name
    name=$(basename "$dmg" .dmg)
    if [[ -d "$APPS_ROOT/${name}.app" && -d "$(apps_dir_of_dmg "$dmg")/${name}.app" ]]; then
        both_exist+="$name "
    fi
}

check_icloud_sync() {
    local dir="$1"

    echo ""
    echo "==> iCloud 同期を確認..."

    # フォルダごとダウンロードをトリガー
    brctl download "$dir" 2>/dev/null || true

    # .dmg.icloud プレースホルダが消えるまで待機（最大60秒）
    local waited=0
    while (( waited < 60 )); do
        local remaining=0
        for f in "$dir"/.*.dmg.icloud; do
            [[ -f "$f" ]] && (( remaining++ ))
        done
        (( remaining == 0 )) && break
        sleep 1
        (( waited++ ))
    done

    if (( waited >= 60 )); then
        echo "  警告: ダウンロードがタイムアウトしました（60秒）。続行します..." >&2
    elif (( waited > 0 )); then
        echo "  ダウンロード完了（${waited}秒）"
    fi
}


quit_app() {
    local name="$1"
    local app_path="$2"

    $no_gui && return 0

    # AppleScript で終了要求
    if osascript -e "tell application \"$name\" to running" 2>/dev/null | grep -q true; then
        echo "  終了中: $name"
        osascript -e "tell application \"$name\" to quit" 2>/dev/null || true
        # 最大 5 秒待機
        local i=0
        while (( i < 10 )); do
            osascript -e "tell application \"$name\" to running" 2>/dev/null | grep -q true || break
            sleep 0.5
            i=$(( i + 1 ))
        done
    fi

    # 残留プロセスを強制終了
    pkill -f "$app_path" 2>/dev/null || true
    sleep 0.3
}

# DMG 内のアプリと Applications 内のアプリのタイムスタンプが同じか判定
is_dmg_same_version() {
    local dmg="$1"
    local mount_point
    mount_point=$(hdiutil attach "$dmg" -nobrowse -readonly -noverify 2>/dev/null \
        | grep '/Volumes/' | sed 's/.*\t//')
    [[ -z "$mount_point" ]] && return 1

    local app_in_dmg
    app_in_dmg=$(find "$mount_point" -maxdepth 2 -name "*.app" | head -1)
    if [[ -z "$app_in_dmg" ]]; then
        hdiutil detach "$mount_point" -quiet 2>/dev/null || true
        return 1
    fi

    local installed_app
    installed_app="$(apps_dir_of_dmg "$dmg")/$(basename "$app_in_dmg")"
    local same=1
    if [[ -d "$installed_app" ]]; then
        local dmg_mtime installed_mtime
        dmg_mtime=$(stat -f %m "$app_in_dmg")
        installed_mtime=$(stat -f %m "$installed_app")
        [[ "$dmg_mtime" == "$installed_mtime" ]] && same=0
    fi

    hdiutil detach "$mount_point" -quiet 2>/dev/null || true
    return $same
}

remove_app() {
    local dmg="$1"
    local app_name
    app_name=$(basename "$dmg" .dmg)
    local app_path
    app_path="$(apps_dir_of_dmg "$dmg")/${app_name}.app"

    echo ""
    echo "==> $app_name を削除"
    quit_app "$app_name" "$app_path"

    if [[ -d "$app_path" ]]; then
        echo "  削除: $app_path"
        rm -rf "$app_path"
    else
        echo "  スキップ: $app_path が見つかりません"
    fi
}

uninstall_app() {
    local app_name="$1"
    local dir app_path found=false

    echo ""
    echo "==> $app_name をアンインストール"
    for dir in "$SWIFT_APPS_DIR" "$TAURI_APPS_DIR"; do
        app_path="$dir/${app_name}.app"
        if [[ -d "$app_path" ]]; then
            found=true
            quit_app "$app_name" "$app_path"
            echo "  削除: $app_path"
            rm -rf "$app_path"
        fi
    done
    if ! $found; then
        echo "  スキップ: $SWIFT_APPS_DIR と $TAURI_APPS_DIR に ${app_name}.app が見つかりません"
    fi
    # 旧い置き場のアプリは、他の（App Store 版などの）同名アプリかもしれないので、ここでは消さない
    if [[ -d "$APPS_ROOT/${app_name}.app" ]]; then
        echo "  注意: 旧い置き場に残っています（削除しません）: $APPS_ROOT/${app_name}.app"
    fi
}

clear_widget_cache() {
    $no_gui && return 0
    echo ""
    echo "==> ウィジェットキャッシュをクリア..."
    killall NotificationCenter 2>/dev/null || true
    killall widgetextensionhost 2>/dev/null || true
    sleep 1
}

install_dmg() {
    local dmg="$1"
    local app_name
    app_name=$(basename "$dmg" .dmg)

    # タブ区切りの最終フィールド（スペース含むボリューム名に対応）
    local mount_point
    mount_point=$(hdiutil attach "$dmg" -nobrowse -readonly -noverify 2>/dev/null \
        | grep '/Volumes/' | sed 's/.*\t//')

    if [[ -z "$mount_point" ]]; then
        echo ""
        echo "  エラー: マウントに失敗しました ($dmg)" >&2
        return 1
    fi

    local app_in_dmg
    app_in_dmg=$(find "$mount_point" -maxdepth 2 -name "*.app" | head -1)

    if [[ -z "$app_in_dmg" ]]; then
        echo ""
        echo "  警告: .app が見つかりませんでした ($dmg)" >&2
        hdiutil detach "$mount_point" -quiet 2>/dev/null || true
        return 0
    fi

    local installed_name
    installed_name=$(basename "$app_in_dmg" .app)
    local apps_dir
    apps_dir=$(apps_dir_of_dmg "$dmg")
    local installed_app="$apps_dir/${installed_name}.app"

    # インストール済み .app の更新日時と DMG 内 .app の更新日時を比較
    if ! $force && [[ -d "$installed_app" ]]; then
        local dmg_mtime installed_mtime
        dmg_mtime=$(stat -f %m "$app_in_dmg")
        installed_mtime=$(stat -f %m "$installed_app")
        if [[ "$dmg_mtime" == "$installed_mtime" ]]; then
            echo ""
            echo "==> $installed_name — スキップ（インストール済みと同じバージョン）"
            hdiutil detach "$mount_point" -quiet 2>/dev/null || true
            return 0
        fi
    fi

    echo ""
    echo "==> $installed_name をインストール"
    quit_app "$installed_name" "$installed_app"
    migrate_legacy_app "$installed_name" "$app_in_dmg" "$installed_app"
    echo "  インストール中...（${apps_dir}）"
    if ! mkdir -p "$apps_dir"; then
        echo "  エラー: フォルダを作れませんでした: $apps_dir" >&2
        hdiutil detach "$mount_point" -quiet 2>/dev/null || true
        return 1
    fi
    cp -Rp "$app_in_dmg" "$apps_dir/"
    installed_apps+=("$installed_name")
    installed_paths+=("$installed_app")

    hdiutil detach "$mount_point" -quiet 2>/dev/null || true
}

relaunch_apps() {
    echo ""
    echo "==> アプリを起動してウィジェット拡張を登録..."
    local i
    for i in "${!installed_apps[@]}"; do
        echo "  起動: ${installed_apps[$i]}"
        open "${installed_paths[$i]}" 2>/dev/null || echo "  警告: 起動できませんでした: ${installed_apps[$i]}"
    done
    # ウィジェット拡張が登録されるまで待機
    sleep 3
}

_try_open_widget_with_python() {
    python3 - <<'PYEOF'
import subprocess, time, sys

try:
    import Quartz
except ImportError:
    sys.exit(1)

subprocess.run(['osascript', '-e', 'tell application "Finder" to activate'], check=False)
time.sleep(0.6)

display = Quartz.CGMainDisplayID()
x = Quartz.CGDisplayPixelsWide(display) // 2
y = Quartz.CGDisplayPixelsHigh(display) // 2

for etype in (Quartz.kCGEventRightMouseDown, Quartz.kCGEventRightMouseUp):
    e = Quartz.CGEventCreateMouseEvent(None, etype, (x, y), Quartz.kCGMouseButtonRight)
    Quartz.CGEventPost(Quartz.kCGHIDEventTap, e)
    time.sleep(0.05)

time.sleep(0.8)

for item in ['ウィジェットを編集…', 'Edit Widgets…',
             'ウィジェットを編集...', 'Edit Widgets...']:
    r = subprocess.run(
        ['osascript', '-e',
         f'tell application "System Events" to tell process "Finder" to click menu item "{item}" of menu 1'],
        capture_output=True
    )
    if r.returncode == 0:
        break
PYEOF
}

open_widget_editor() {
    echo ""
    echo "==> ウィジェット編集画面を開きます..."

    if ! _try_open_widget_with_python 2>/dev/null; then
        osascript -e 'tell application "Finder" to activate' 2>/dev/null || true
        echo "  (デスクトップを右クリック →「ウィジェットを編集...」を選択してください)"
    fi
}

# ── メイン処理 ──────────────────────────────────────

reinstall=false
force=false
uninstall=false
no_gui=false
case "$MIGRATE_OLD_DEFAULT" in
    0|false|no|off) migrate_old=false ;;
    *) migrate_old=true ;;
esac

# オプション解析
args=()
for arg in "$@"; do
    case "$arg" in
        --reinstall|-r) reinstall=true ;;
        --force|-f)     force=true ;;
        --uninstall|-u) uninstall=true ;;
        --no-gui)       no_gui=true ;;
        --migrate-old)    migrate_old=true ;;
        --no-migrate-old) migrate_old=false ;;
        --help|-h)      sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        -*) echo "不明なオプション: $arg" >&2; exit 1 ;;
        *) args+=("$arg") ;;
    esac
done

if $uninstall && $reinstall; then
    echo "エラー: --uninstall と --reinstall は同時に指定できません" >&2
    exit 1
fi

# ── アンインストールモード ───────────────────────────
if $uninstall; then
    app_names=()
    if (( ${#args[@]} > 0 )); then
        app_names=("${args[@]}")
    else
        # 引数なし: Build の DMG に対応するアプリをアンインストール
        collect_dmgs
        for dmg in "${dmg_files[@]+"${dmg_files[@]}"}"; do
            app_names+=("$(basename "$dmg" .dmg)")
        done
    fi

    if (( ${#app_names[@]} == 0 )); then
        echo "アンインストール対象が見つかりませんでした。"
        exit 1
    fi

    for app_name in "${app_names[@]}"; do
        uninstall_app "$app_name"
    done

    echo ""
    joined=$(IFS=', '; echo "${app_names[*]}")
    echo "完了! アンインストール済み: $joined"
    exit 0
fi

check_icloud_sync "$BUILD_DIR"
for kind_dir in "$BUILD_DIR/Swift" "$BUILD_DIR/Tauri"; do
    [[ -d "$kind_dir" ]] && check_icloud_sync "$kind_dir"
done

echo "Build フォルダ: $BUILD_DIR"
echo "インストール先: ${SWIFT_APPS_DIR}（Swift）、${TAURI_APPS_DIR}（Tauri）"
if $migrate_old; then
    echo "旧い置き場の整理: ON（移行期間の措置。--no-migrate-old で切れます）"
fi
if $reinstall; then
    echo "モード: 再インストール（削除してからインストール）"
elif $force; then
    echo "モード: 強制インストール（バージョンチェックをスキップ）"
else
    echo "モード: 上書きインストール（同バージョンはスキップ）"
fi

dmg_files=()
if (( ${#args[@]} > 0 )); then
    for app_name in "${args[@]}"; do
        if dmg=$(find_dmg "$app_name"); then
            dmg_files+=("$dmg")
        else
            echo "警告: ${app_name}.dmg が見つかりません" >&2
        fi
    done
else
    collect_dmgs
fi

# 移行前の Build 直下の DMG は Swift として扱う（置き場を直すよう知らせる）
for dmg in "${dmg_files[@]+"${dmg_files[@]}"}"; do
    if [[ "$(dirname "$dmg")" == "$BUILD_DIR" ]]; then
        echo "注意: Build 直下の DMG は Swift として扱います。Build/Swift へ移してください: $(basename "$dmg")" >&2
    fi
done

if (( ${#dmg_files[@]} == 0 )); then
    echo ""
    echo "DMG ファイルが見つかりませんでした。"
    exit 1
fi

for dmg in "${dmg_files[@]}"; do
    note_both_exist "$dmg"
done

if $reinstall; then
    # 同バージョンの DMG は削除前に除外
    to_reinstall=()
    for dmg in "${dmg_files[@]}"; do
        if ! $force && is_dmg_same_version "$dmg"; then
            echo ""
            echo "==> $(basename "$dmg" .dmg) — スキップ（インストール済みと同じバージョン）"
        else
            to_reinstall+=("$dmg")
        fi
    done
    dmg_files=("${to_reinstall[@]+"${to_reinstall[@]}"}")

    if (( ${#dmg_files[@]} > 0 )); then
        # フェーズ 1: 対象アプリを終了・削除
        for dmg in "${dmg_files[@]}"; do
            remove_app "$dmg"
        done

        # フェーズ 2: ウィジェットキャッシュをクリア
        clear_widget_cache
    fi
fi

# フェーズ 3: 全アプリをインストール（quit は install_dmg 内で実行）
if (( ${#dmg_files[@]} > 0 )); then
    for dmg in "${dmg_files[@]}"; do
        install_dmg "$dmg"
    done
fi

if (( ${#installed_apps[@]} == 0 )); then
    echo ""
    echo "すべてのアプリは最新版がインストール済みです。"
    exit 0
fi

if $no_gui; then
    echo ""
    echo "注意: --no-gui のため、アプリの起動とウィジェット拡張の登録は行っていません。"
    echo "  ウィジェットを使う場合は、このMacで該当アプリを一度起動してください。"
else
    # フェーズ 4: アプリを起動してウィジェット拡張を登録
    relaunch_apps

    # フェーズ 5: ウィジェット編集画面を開く
    open_widget_editor
fi

echo ""
joined=$(IFS=', '; echo "${installed_apps[*]}")
echo "完了! インストール済み: $joined"
