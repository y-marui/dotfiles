#!/usr/bin/env bash
# my-hosts: 複数のホストでghq-pull / ghq-update / ghq-sweep / ghq-status / install-my-appsを順に実行する
# （実行元はmacOS専用。対象にはmacOSに加え、OpenSSHサーバー+pwshログインシェルのWindowsも宣言できる）
#
# 使い方:
#   my-hosts [status|pull|sweep|update|apps] [options] [-- install-my-appsへの引数]
#
# サブコマンド（各サブコマンドは対応する ghq-* を実行し、続けて ghq-status を実行する。省略時は sweep）:
#   status              ghq-status のみ
#   pull                ghq-pull → ghq-status
#   sweep               ghq-sweep → ghq-status（ghq-sweep は全ローカルブランチの pull も行う）
#   update              ghq-pull → ghq-update --sync-only → ghq-status
#                       （全リポジトリを pull したうえで、依存更新・自動 PR を行う）
#   apps                install-my-apps のみ（ghq-status は実行しない）。リモートでは --no-gui を付ける
#                       （終了・起動・ウィジェット編集画面を省く）。実行元自身は通常どおり GUI 付き。
#                       -- 以降は install-my-apps にそのまま渡す（例: my-hosts apps -- -f MyApp）。
#                       -f/--filter とは併用できない。Windows は install-my-apps が macOS 専用の
#                       ため実行せず、結果表に skip と出して失敗には数えない
#
# オプション:
#   --no-status         ghq-status を実行しない（status サブコマンドとは併用不可。apps では無視）
#   -f, --filter PATTERN  リポジトリパスが正規表現 PATTERN にマッチするものだけを対象にする
#                       （各 ghq-* の -f にそのまま渡す）
#   -H, --host NAME     宣言済みの対象のうち、指定したホストだけを対象にする（複数回可）
#   --from NAME         実行元の名前を明示する（既定: scutil --get LocalHostName）
#   --no-local          実行元自身を処理しない
#   -a, --all           ghq-status に -a を渡し、異常のないリポジトリも表示する
#   -j, --jobs N        同時に処理するホスト数（既定: 全ホスト同時。1で逐次）
#   -v, --verbose       成功したステップの出力も表示する
#   --no-progress       進捗表示を出さない（標準エラー出力が端末のときだけ表示される）
#   -n, --dry-run       実行内容だけを表示し、何も実行しない（sshも実行しない）
#   -h, --help          ヘルプを表示
#
# 動作:
#   - ステップはサブコマンドで決まり、ホスト内では逐次に実行する
#   - ホスト間は並列に処理する（実行元自身を含む）。表示と結果表は宣言順
#     （実行元自身→宣言順のリモートホスト）にまとめて出す
#   - 対象は dotfiles-private の hosts/hosts で実行元ごとに宣言する。書式は1行1件:
#       <実行元>: <ホスト> <ホスト> ...
#     左側は実行元の名前（LocalHostName と大文字小文字を区別せず照合する）、
#     右側は ssh のホスト名。# 以降はコメント。hosts.local（端末固有の追加分）も読む。
#     Windows のホストには <ホスト>:windows と書く。pull / sweep / update は GitHub 認証が
#     未対応、apps は macOS 専用のため実行せず、結果表に skip と出して失敗には数えない
#     （status は実行する。GitHub 認証の対応後は WINDOWS_SKIP_STEPS から pull 等を外すだけで有効化できる）
#   - リモートでは ssh <host> ghq-pull などを直接呼ぶ（my-hosts は再帰しない）。
#     BatchMode で接続し、ConnectTimeout は5秒とする。ポスト量子鍵交換の警告など
#     弱い暗号の警告は WarnWeakCrypto=no で抑止する（OpenSSH 10.1以降。古いクライアントでは無効）。引数は zsh/bash/pwsh のどれでも
#     解釈が同じになるよう、シングルクォートで渡す（' を含む値は使えない）
#   - 接続不能・認証失敗・コマンド失敗は失敗として扱い、残りのホストの処理は続行する。
#     接続できなかったホストの残りのステップは skip として表示する
#   - 既定では成功したステップの出力を省略し、失敗したステップと status の出力だけを表示する。
#     全出力は ~/.cache/dots/hosts/<host>.log に残る
#   - 標準エラー出力が端末のときは、ホストごとの進捗（ステップの状態）を1行ずつ更新表示する。
#     完了後に進捗を消し、宣言順の出力と結果表を出す
#   - 成功したステップでも [skip ...] [warn] [conflict] [failed] のタグ行と
#     warning: で始まる行（git-pull-all・git-sweep の警告）は表示し、
#     結果表では ok! と表示する（終了コードには影響しない）
#   - 最後にホスト × ステップの結果表を出し、失敗が1つでもあれば終了コード1で終了する
#
# 環境変数:
#   DOTFILES_PRIVATE_DIR   dotfiles-private の場所（既定: <dotfiles>-private）
#   MY_HOSTS_LOG_DIR      ログの保存先（既定: ${XDG_CACHE_HOME:-~/.cache}/dots/hosts）
#   MY_HOSTS_SSH          ssh コマンド（テスト用。既定: ssh）

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
DOTFILES_DIR="$(cd "${SCRIPT_DIR}/../.." && pwd -P)"
PRIVATE_DIR="${DOTFILES_PRIVATE_DIR:-${DOTFILES_DIR}-private}"
SSH_CMD="${MY_HOSTS_SSH:-ssh}"
LOG_DIR="${MY_HOSTS_LOG_DIR:-${XDG_CACHE_HOME:-${HOME}/.cache}/dots/hosts}"

SUBCOMMAND=sweep
DO_STATUS=1
FILTER=''
DO_LOCAL=1
STATUS_ALL=0
VERBOSE=0
DRY_RUN=0
JOBS=0
PROGRESS=auto
FROM=''
HOST_FILTER=()
APPS_ARGS=()

die() { echo "error: $*" >&2; exit 1; }

if [[ $# -gt 0 ]]; then
  case "$1" in
    status|pull|sweep|update|apps) SUBCOMMAND="$1"; shift ;;
  esac
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    --no-status) DO_STATUS=0; shift ;;
    -f|--filter)
      [[ $# -lt 2 ]] && die "$1 requires an argument"
      FILTER="$2"; shift 2 ;;
    --no-local)  DO_LOCAL=0; shift ;;
    -a|--all)    STATUS_ALL=1; shift ;;
    -v|--verbose) VERBOSE=1; shift ;;
    -n|--dry-run) DRY_RUN=1; shift ;;
    --no-progress) PROGRESS=off; shift ;;
    -j|--jobs)
      [[ $# -lt 2 ]] && die "$1 requires an argument"
      [[ "$2" =~ ^[1-9][0-9]*$ ]] || die "$1 には1以上の整数を指定してください: $2"
      JOBS="$2"; shift 2 ;;
    -H|--host)
      [[ $# -lt 2 ]] && die "$1 requires an argument"
      HOST_FILTER+=("$2"); shift 2 ;;
    --from)
      [[ $# -lt 2 ]] && die "--from requires an argument"
      FROM="$2"; shift 2 ;;
    --) shift; APPS_ARGS=("$@"); break ;;
    -h|--help) sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) die "unknown option: $1" ;;
  esac
done

# 引数に ' を含むとシェルごとにエスケープが異なるため、事前に弾く
SQ="'"
for v in "$FILTER" ${APPS_ARGS[@]+"${APPS_ARGS[@]}"}; do
  [[ "$v" != *"$SQ"* ]] || die "シングルクォート（'）を含む引数は渡せません: ${v}"
done

# sq VALUE -> zsh/bash/pwsh のどれでも同じ1語になる表記。
# 安全な文字だけなら素のまま（-f 等のオプションをpwshが文字列扱いしないため）、それ以外はシングルクォートで囲む
sq() {
  if [[ "$1" =~ ^[A-Za-z0-9._/=:,@%+-]+$ ]]; then printf '%s' "$1"; else printf "'%s'" "$1"; fi
}

lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }
trim() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

# 実行元の名前を決める
ME="$FROM"
if [[ -z "$ME" ]]; then
  ME="$(scutil --get LocalHostName 2>/dev/null || true)"
fi
[[ -n "$ME" ]] || die "実行元の名前を判定できません。--from NAME で指定してください。"
ME_LC="$(lower "$ME")"

if [[ ${#APPS_ARGS[@]} -gt 0 && "$SUBCOMMAND" != apps ]]; then
  die "-- 以降の引数は apps サブコマンドでだけ使えます。"
fi
if [[ "$SUBCOMMAND" == apps && -n "$FILTER" ]]; then
  die "apps サブコマンドは -f/--filter と併用できません。"
fi

DECL_FILE="${PRIVATE_DIR}/hosts/hosts"
[[ -f "$DECL_FILE" ]] || die "宣言ファイルがありません: ${DECL_FILE}（雛形: templates/dotfiles-private/hosts/hosts.example）"

TARGETS=()
WINDOWS_HOSTS=()
MATCHED=0

# Windows 対象で実行しないステップ。sshd 経由のセッションでは GitHub への署名ができず
# fetch 系が失敗する。対応時期は未定。実装（step_command）は残してあり、解消したらここを空にする
# apps は install-my-apps が macOS 専用で Windows 側はスタブのため、呼ばずに最初から skip する
WINDOWS_SKIP_STEPS=(pull update sweep apps)

# skip_reason STEP: Windows でステップを skip する理由
skip_reason() {
  if [[ "$1" == apps ]]; then
    echo "install-my-apps は macOS 専用のため Windows では実行しません"
  else
    echo "Windows では GitHub 認証が未対応のため実行しません（対応時期は未定）"
  fi
}

is_windows() {
  local h
  for h in ${WINDOWS_HOSTS[@]+"${WINDOWS_HOSTS[@]}"}; do
    [[ "$h" == "$1" ]] && return 0
  done
  return 1
}

# skips_step HOST STEP: そのホストでステップを実行せず skip 扱いにするなら 0
skips_step() {
  local s
  is_windows "$1" || return 1
  for s in ${WINDOWS_SKIP_STEPS[@]+"${WINDOWS_SKIP_STEPS[@]}"}; do
    [[ "$s" == "$2" ]] && return 0
  done
  return 1
}

add_target() {
  local t="$1" existing
  if [[ "$t" == *:windows ]]; then
    t="${t%:windows}"
    is_windows "$t" || WINDOWS_HOSTS+=("$t")
  fi
  [[ "$t" =~ ^[A-Za-z0-9._@][A-Za-z0-9._@-]*$ ]] || die "不正なホスト名です: ${t}"
  # "local" は実行元自身を表す内部名。同名のsshホストは区別できないため使えない
  [[ "$(lower "$t")" != local ]] || die "'local' はホスト名として使えません（実行元自身を表す予約名）: ${t}"
  for existing in ${TARGETS[@]+"${TARGETS[@]}"}; do
    [[ "$existing" == "$t" ]] && return 0
  done
  TARGETS+=("$t")
}

parse_decl() {
  local file="$1" line src rest word
  local words=()
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="$(trim "${line%%#*}")"
    [[ -z "$line" ]] && continue
    [[ "$line" == *:* ]] || die "書式が不正です（'<実行元>: <ホスト>...' が必要）: ${file}: ${line}"
    src="$(trim "${line%%:*}")"
    rest="${line#*:}"
    [[ -n "$src" ]] || die "実行元が空です: ${file}: ${line}"
    [[ "$(lower "$src")" == "$ME_LC" ]] || continue
    MATCHED=1
    words=()
    read -r -a words <<< "$rest" || true
    for word in ${words[@]+"${words[@]}"}; do
      add_target "$word"
    done
  done < "$file"
}

parse_decl "$DECL_FILE"
[[ -f "${DECL_FILE}.local" ]] && parse_decl "${DECL_FILE}.local"
[[ "$MATCHED" == 1 ]] || die "実行元 '${ME}' が ${DECL_FILE} に宣言されていません。--from NAME で指定できます。"

if [[ ${#HOST_FILTER[@]} -gt 0 ]]; then
  picked=()
  for h in "${HOST_FILTER[@]}"; do
    found=0
    for t in ${TARGETS[@]+"${TARGETS[@]}"}; do
      [[ "$t" == "$h" ]] && found=1
    done
    [[ "$found" == 1 ]] || die "宣言にないホストです: ${h}（実行元 ${ME} の対象: ${TARGETS[*]:-なし}）"
  done
  for t in ${TARGETS[@]+"${TARGETS[@]}"}; do
    for h in "${HOST_FILTER[@]}"; do
      if [[ "$t" == "$h" ]]; then
        picked+=("$t")
        break
      fi
    done
  done
  TARGETS=("${picked[@]}")
fi

STEPS=()
case "$SUBCOMMAND" in
  status) STEPS=(status) ;;
  pull)   STEPS=(pull) ;;
  sweep)  STEPS=(sweep) ;;
  update) STEPS=(pull update) ;;
  apps)   STEPS=(apps) ;;
esac
if [[ "$SUBCOMMAND" == status ]]; then
  [[ "$DO_STATUS" == 1 ]] || die "status サブコマンドは --no-status と併用できません。"
elif [[ "$SUBCOMMAND" == apps ]]; then
  : # apps はリポジトリ状態を変えないため status を付けない
elif [[ "$DO_STATUS" == 1 ]]; then
  STEPS+=(status)
fi

HOSTS=()
[[ "$DO_LOCAL" == 1 ]] && HOSTS+=("local")
for t in ${TARGETS[@]+"${TARGETS[@]}"}; do HOSTS+=("$t"); done
[[ ${#HOSTS[@]} -gt 0 ]] || die "対象のホストがありません。"

# step_command STEP HOST -> 実行するコマンド行（シェルでそのまま評価できる形）。
# -f や apps の引数は ssh 先のシェル（zsh/bash/pwsh）でも評価されるため、sq でクォートして渡す。
step_command() {
  local cmd f='' a
  [[ -n "$FILTER" ]] && f=" -f $(sq "$FILTER")"
  case "$1" in
    apps)
      cmd="install-my-apps"
      # リモートはログインしているとは限らないため GUI 操作を省く
      [[ "$2" == "local" ]] || cmd+=" --no-gui"
      for a in ${APPS_ARGS[@]+"${APPS_ARGS[@]}"}; do cmd+=" $(sq "$a")"; done ;;
    pull)   cmd="ghq-pull${f}" ;;
    update) cmd="ghq-update --sync-only${f}" ;;
    sweep)  cmd="ghq-sweep${f}" ;;
    status)
      cmd="ghq-status"
      [[ "$STATUS_ALL" == 1 ]] && cmd+=" -a"
      cmd+="$f" ;;
  esac
  printf '%s' "$cmd"
}

host_label() {
  if [[ "$1" == "local" ]]; then echo "${ME} (local)"; else echo "$1"; fi
}

if [[ "$DRY_RUN" == 1 ]]; then
  for host in "${HOSTS[@]}"; do
    echo ""
    echo "==> $(host_label "$host")"
    for step in "${STEPS[@]}"; do
      cmd="$(step_command "$step" "$host")"
      if skips_step "$host" "$step"; then
        echo "  would skip: ${step}（$(skip_reason "$step")）"
      elif [[ "$host" == "local" ]]; then
        echo "  would run: ${cmd}"
      else
        echo "  would run: ${SSH_CMD} -o BatchMode=yes -o ConnectTimeout=5 -o WarnWeakCrypto=no ${host} ${cmd}"
      fi
    done
  done
  exit 0
fi

mkdir -p "$LOG_DIR"
WORK_DIR="$(mktemp -d)"
cleanup() {
  local pids
  pids="$(jobs -p 2>/dev/null || true)"
  # shellcheck disable=SC2086  # PID のリストを単語分割して渡す
  [[ -n "$pids" ]] && kill $pids 2>/dev/null || true
  [[ "${SHOW_PROGRESS:-0}" == 1 ]] && printf '\033[?25h' >&2
  rm -rf "$WORK_DIR"
}
trap cleanup EXIT
trap 'exit 130' INT TERM

# run_step HOST STEP OUTFILE -> 終了コードを返す。出力は OUTFILE に入る
run_step() {
  local host="$1" step="$2" out="$3" cmd rc=0
  cmd="$(step_command "$step" "$host")"
  if [[ "$host" == "local" ]]; then
    bash -c "$cmd" > "$out" 2>&1 || rc=$?
  else
    "$SSH_CMD" -o BatchMode=yes -o ConnectTimeout=5 -o WarnWeakCrypto=no "$host" "$cmd" > "$out" 2>&1 || rc=$?
  fi
  return "$rc"
}

indent() { sed 's/^/    /'; }

# スキップ・警告のタグ行を、直前の "==> リポジトリ" 見出し付きで抜き出す
tagged_lines() {
  awk '/^==> /{h=$0; printed=0; next}
    /^[[:space:]]*(\[(skip|warn|conflict|failed)[] ]|warning:)/{ if (!printed) { print h; printed=1 } print }'
}

# process_host IDX HOST: 1ホスト分のステップを順に実行する。
# 表示は標準出力へ、セル（結果表の行）と失敗数は $WORK_DIR/IDX.{cells,failed} へ書く
process_host() {
  local idx="$1" host="$2" step rc log log_name failed=0 unreachable=0
  local cells=()
  local tmp="${WORK_DIR}/${idx}.tmp"
  echo "" > "${WORK_DIR}/${idx}.state"
  echo ""
  echo "==> $(host_label "$host")"
  log_name="$host"
  [[ "$host" == "local" ]] && log_name="${ME}"
  log="${LOG_DIR}/${log_name}.log"
  : > "$log"
  for step in "${STEPS[@]}"; do
    if [[ "$unreachable" == 1 ]]; then
      cells+=("skip")
      echo "${cells[*]}" > "${WORK_DIR}/${idx}.state"
      continue
    fi
    if skips_step "$host" "$step"; then
      cells+=("skip")
      echo "${cells[*]}" > "${WORK_DIR}/${idx}.state"
      echo "  [skip] ${step}: $(skip_reason "$step")"
      echo "--- ${step} (skipped: windows)" >> "$log"
      continue
    fi
    rc=0
    run_step "$host" "$step" "$tmp" || rc=$?
    {
      echo "--- ${step} (exit ${rc})"
      cat "$tmp"
    } >> "$log"
    if [[ "$rc" -eq 64 && "$step" == apps ]]; then
      # install-my-apps が未対応のホスト（Windows）。失敗ではなく skip として扱う
      cells+=("skip")
      echo "${cells[*]}" > "${WORK_DIR}/${idx}.state"
      echo "  [skip] ${step}: このホストでは未対応です（exit 64）"
    elif [[ "$rc" -eq 0 ]]; then
      # ghq-pull / ghq-sweep 等はスキップや警告を [skip ...] 等のタグ行で出し、終了コードは0のまま。
      # 成功扱いで出力を隠すと見落とすため、タグ行（と直前のリポジトリ見出し）は必ず表示する
      warn_lines=""
      [[ "$step" != "status" ]] && warn_lines="$(tagged_lines < "$tmp")"
      if [[ -n "$warn_lines" ]]; then
        cells+=("ok!")
      else
        cells+=("ok")
      fi
      echo "${cells[*]}" > "${WORK_DIR}/${idx}.state"
      if [[ -n "$warn_lines" ]]; then
        echo "  [ok] ${step}（スキップ・警告あり）"
        if [[ "$VERBOSE" != 1 ]]; then printf '%s\n' "$warn_lines" | indent; fi
      else
        echo "  [ok] ${step}"
      fi
      if [[ "$VERBOSE" == 1 || ( "$step" == "status" && -s "$tmp" ) ]]; then indent < "$tmp"; fi
    else
      failed=$((failed + 1))
      if [[ "$host" != "local" && "$rc" -eq 255 ]]; then
        cells+=("ssh")
        echo "${cells[*]}" > "${WORK_DIR}/${idx}.state"
        unreachable=1
        echo "  [FAIL] ${step}: ssh接続に失敗しました（残りのステップはskip）"
      else
        cells+=("FAIL")
        echo "${cells[*]}" > "${WORK_DIR}/${idx}.state"
        echo "  [FAIL] ${step} (exit ${rc})"
      fi
      indent < "$tmp"
    fi
  done
  echo "${cells[*]}" > "${WORK_DIR}/${idx}.cells"
  echo "$failed" > "${WORK_DIR}/${idx}.failed"
}

# 進捗表示（標準エラー出力が端末のときだけ）
SHOW_PROGRESS=0
if [[ "$PROGRESS" == auto && -t 2 ]]; then SHOW_PROGRESS=1; fi
SPIN=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
SPIN_N=0
STARTED=0
DRAWN=0

render_progress() {
  [[ "$SHOW_PROGRESS" == 1 ]] || return 0
  local i h label st step n j mark line
  local done_cells=()
  if [[ "$DRAWN" == 1 ]]; then printf '\033[%dA' "${#HOSTS[@]}" >&2; fi
  SPIN_N=$(( (SPIN_N + 1) % ${#SPIN[@]} ))
  i=0
  for h in "${HOSTS[@]}"; do
    label="$(host_label "$h")"
    done_cells=()
    if [[ -f "${WORK_DIR}/${i}.state" ]]; then
      st="$(cat "${WORK_DIR}/${i}.state")"
      [[ -n "$st" ]] && read -r -a done_cells <<< "$st"
    fi
    n=${#done_cells[@]}
    line="$(printf '%-24s' "$label")"
    j=0
    for step in "${STEPS[@]}"; do
      if [[ "$i" -ge "$STARTED" ]]; then
        mark="待機"
      elif [[ "$j" -lt "$n" ]]; then
        mark="${done_cells[$j]}"
      elif [[ "$j" -eq "$n" && ! -f "${WORK_DIR}/${i}.failed" ]]; then
        mark="${SPIN[$SPIN_N]}"
      else
        mark="-"
      fi
      line+="$(printf '%-14s' "${step}:${mark}")"
      j=$((j + 1))
    done
    printf '\r\033[K%s\n' "$line" >&2
    i=$((i + 1))
  done
  DRAWN=1
}

clear_progress() {
  [[ "$DRAWN" == 1 ]] || return 0
  printf '\033[%dA' "${#HOSTS[@]}" >&2
  local k
  for ((k = 0; k < ${#HOSTS[@]}; k++)); do printf '\r\033[K\n' >&2; done
  printf '\033[%dA' "${#HOSTS[@]}" >&2
  DRAWN=0
}

if [[ "$SHOW_PROGRESS" == 1 ]]; then printf '\033[?25l' >&2; fi

# ホストは並列に処理する（ステップの順序はホスト内で固定）。表示は宣言順にまとめて出す
PIDS=()
idx=0
for host in "${HOSTS[@]}"; do
  if [[ "$JOBS" -gt 0 ]]; then
    while [[ "$(jobs -r | wc -l | tr -d ' ')" -ge "$JOBS" ]]; do
      render_progress
      sleep 0.2
    done
  fi
  process_host "$idx" "$host" > "${WORK_DIR}/${idx}.out" 2>&1 &
  PIDS+=("$!")
  idx=$((idx + 1))
  STARTED=$idx
done

while [[ "$(jobs -r | wc -l | tr -d ' ')" -gt 0 ]]; do
  render_progress
  sleep 0.2
done
render_progress
clear_progress
if [[ "$SHOW_PROGRESS" == 1 ]]; then printf '\033[?25h' >&2; fi

ROWS=()
FAILED=0
idx=0
for host in "${HOSTS[@]}"; do
  wait "${PIDS[$idx]}" || true
  cat "${WORK_DIR}/${idx}.out"
  row_cells="$(cat "${WORK_DIR}/${idx}.cells" 2>/dev/null || true)"
  n="$(cat "${WORK_DIR}/${idx}.failed" 2>/dev/null || echo 1)"
  if [[ -z "$row_cells" ]]; then
    # 想定外の中断。結果が残っていないホストは失敗として扱う
    row_cells="FAIL"
    n=1
  fi
  FAILED=$((FAILED + n))
  ROWS+=("${host}|${row_cells}")
  idx=$((idx + 1))
done

echo ""
echo "== summary =="
header="$(printf '%-24s' 'HOST')"
for step in "${STEPS[@]}"; do header+="$(printf '%-8s' "$step")"; done
echo "$header"
for row in "${ROWS[@]}"; do
  host="${row%%|*}"
  line="$(printf '%-24s' "$(host_label "$host")")"
  cells=()
  read -r -a cells <<< "${row#*|}"
  for cell in "${cells[@]}"; do line+="$(printf '%-8s' "$cell")"; done
  echo "$line"
done
echo ""
if [[ "${ROWS[*]}" == *"ok!"* ]]; then
  echo "ok! = 成功したがスキップ・警告あり（上の出力か -v、ログで確認）"
fi
echo "ログ: ${LOG_DIR}/"

if [[ "$FAILED" -gt 0 ]]; then
  printf '失敗: %d ステップ\n' "$FAILED" >&2
  exit 1
fi
