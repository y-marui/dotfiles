# dots check（非verbose）の結果（output・status）を check-summary/check-state/
# check-digest へ原子的に書き込む。macos/dots-check-monitor.sh がLaunchAgent
# 経由で書いていたキャッシュを、`dots check`を直接実行した場合にも同じように
# 更新するためのもの（手動でdots ...コマンドを実行して警告を解消した後も
# シェル起動時の表示 shell/zshrc が古い警告のまま残ってしまう問題への対応）。
# --verboseの詳細出力はこの一覧形式に合わないため対象外（変更なし）。
_check_write_cache() {
  local output="$1" status="$2" state summary digest tmp
  if [[ "${status}" -eq 0 ]]; then
    state="clean"
    summary=""
  else
    state="warning"
    summary="${output}"
  fi

  mkdir -p "${DOTS_CHECK_CACHE_DIR}"
  chmod 700 "${DOTS_CHECK_CACHE_DIR}"
  # macOSはshasum、Raspberry Pi（coreutils）はsha256sumを使う。
  if command -v shasum >/dev/null 2>&1; then
    digest="$(printf '%s\n%s' "${state}" "${summary}" | shasum -a 256 | awk '{print $1}')"
  else
    digest="$(printf '%s\n%s' "${state}" "${summary}" | sha256sum | awk '{print $1}')"
  fi

  tmp="$(mktemp "${DOTS_CHECK_SUMMARY_FILE}.XXXXXX")"
  if [[ -n "${summary}" ]]; then
    printf '%s\n' "${summary}" > "${tmp}"
  else
    : > "${tmp}"
  fi
  mv "${tmp}" "${DOTS_CHECK_SUMMARY_FILE}"
  printf '%s\n' "${state}" > "${DOTS_CHECK_STATE_FILE}"
  printf '%s\n' "${digest}" > "${DOTS_CHECK_DIGEST_FILE}"
}

_check() {
  local verbose=false

  while (( $# > 0 )); do
    case "$1" in
      --verbose) verbose=true ;;
      -h|--help)
        printf 'Usage: dots check [--verbose]\n'
        return 0
        ;;
      *) _error "unknown check option: $1" ;;
    esac
    shift
  done

  if [[ "${verbose}" == true ]]; then
    _check_verbose
  else
    local output rc
    output="$(_check_summary 2>&1)" && rc=0 || rc=$?
    _check_write_cache "${output}" "${rc}"
    [[ -n "${output}" ]] && printf '%s\n' "${output}"
    return "${rc}"
  fi
}

command_name="${1:-help}"
shift || true
exit_code_requested=false

case "${command_name}" in
  brew|dock|shortcuts|npm|pipx|ghq|ai|claude|codex|copilot)
    gate=0
    _dots_gate "${command_name}" "$@" || gate=$?
    case "${gate}" in
      10|11) exit 0 ;;  # N/A または help は表示済み
    esac
    # --exit-code（diff で差分があれば終了コード1）は各ハンドラへ渡さず、ここで扱う
    if [[ "${1:-}" == diff ]]; then
      filtered=()
      for arg in "$@"; do
        if [[ "${arg}" == --exit-code ]]; then
          exit_code_requested=true
        else
          filtered+=("${arg}")
        fi
      done
      set -- "${filtered[@]}"
    fi
    ;;
esac

case "${command_name}" in
  status) _status "$@" ;;
  update) _update "$@" ;;
  brew) _brew "$@" ;;
  dock) _dock "$@" ;;
  shortcuts) _shortcuts "$@" ;;
  npm|pipx) _package_file "${command_name}" "$@" ;;
  ghq) _ghq "$@" ;;
  ai) _ai "$@" ;;
  claude|codex) _ai_agent "${command_name}" "$@" ;;
  copilot) _copilot "$@" ;;
  verbs) _require_no_args "$@"; _dots_print_verb_matrix ;;
  check) _check "$@" ;;
  commit) _commit "$@" ;;
  push) _push "$@" ;;
  help|-h|--help) _require_no_args "$@"; _usage ;;
  *) _error "unknown command: ${command_name}" ;;
esac

# diff --exit-code: 差分があれば終了コード1（既定の diff は差分があっても0）
[[ "${exit_code_requested}" == false || "${DOTS_DIFF_FOUND}" == 0 ]] || exit 1
