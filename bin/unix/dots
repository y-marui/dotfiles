#!/usr/bin/env bash
set -euo pipefail

_resolve_dotfiles_dir() {
  local source_path source_dir link_target
  source_path="${BASH_SOURCE[0]}"

  while [[ -L "${source_path}" ]]; do
    source_dir="$(cd -P "$(dirname "${source_path}")" && pwd)"
    link_target="$(readlink "${source_path}")"
    if [[ "${link_target}" == /* ]]; then
      source_path="${link_target}"
    else
      source_path="${source_dir}/${link_target}"
    fi
  done

  source_dir="$(cd -P "$(dirname "${source_path}")" && pwd)"
  # source_dir は <dotfiles>/bin/unix なので、リポジトリルートへは二階層上がる
  cd "${source_dir}/../.." && pwd -P
}

DOTFILES_DIR="$(_resolve_dotfiles_dir)"
PRIVATE_DIR="${DOTFILES_DIR%-private}-private"
export DOTFILES_DIR

# shellcheck source=bin/unix/_dots-verbs.sh
source "${DOTFILES_DIR}/bin/unix/_dots-verbs.sh"

# dots check（非verbose）の結果キャッシュ。macos/dots-check-monitor.sh（LaunchAgent
# 経由）と共有するパスで、DOTS_CHECK_CACHE_DIRで上書きできる（テスト用途）。
DOTS_CHECK_CACHE_DIR="${DOTS_CHECK_CACHE_DIR:-${XDG_CACHE_HOME:-${HOME}/.cache}/dots}"
DOTS_CHECK_SUMMARY_FILE="${DOTS_CHECK_CACHE_DIR}/check-summary"
DOTS_CHECK_STATE_FILE="${DOTS_CHECK_CACHE_DIR}/check-state"
DOTS_CHECK_DIGEST_FILE="${DOTS_CHECK_CACHE_DIR}/check-digest"

_usage() {
  cat <<'USAGE_HEAD'
Usage:
  dots status [--no-fetch]
  dots update
USAGE_HEAD
  _dots_all_domains_help
  cat <<'USAGE_TAIL'
  dots check [--verbose]
  dots commit
  dots push [--no-fetch]
  dots verbs
  dots help

Commands:
  status  dotfiles / dotfiles-privateの未コミット・未push・未pullを確認
  update  dotfilesを更新・再リンク後、OS別の更新を実行
  brew    Homebrewパッケージ設定を操作
  dock    Dock・Finderサイドバー設定を操作
  shortcuts  macOSのアプリケーションショートカット設定を操作
  npm     npmグローバルパッケージ設定を操作
  pipx    pipxパッケージ設定を操作
  ghq     ghq-update の更新対象（local.keep-up-to-date）を dotfiles-private の宣言で管理
  ai      Claude Code・Codex の MCP・plugin・skill を一括管理
  claude  Claude Code の MCP・plugin・skill を宣言的に管理
  codex   Codex の MCP・plugin・skill を宣言的に管理
  copilot GitHub Copilot CLI の user scope MCP を宣言的に管理
  check   シンボリックリンク・dotfiles状態・パッケージ管理・全 AI Agent の差分を一括検査
          （デフォルトは差分がある項目のみ1行で表示。--verbose で詳細表示）
  commit  sync系コマンドが書き換えたファイルのみの変更を自動検知してcommit
          （対象外ファイルが混在する場合は何もコミットせず、手動commitを促す）
  push    未pushのcommitが全て dots commit によるファイルだけならpush、
          対象外ファイルを含むcommitが混じっていれば手動pushを促す
  verbs   ドメイン×動詞の対応表（実装済み・対象外・未実装）をTSVで出力

動詞（apply / diff / sync / merge / prune / cache）の意味は docs/specification.md、
どのコマンドが実装しているかは README.md の動詞表を参照する。
`dots <domain> help` でそのドメインの実装状況を表示する。
「N/A」は意図的に存在しない動詞（終了コード0）、「未実装」は実装予定の動詞（エラー）。

Options:
  --no-prune          apply で削除（prune）を行わず、追加・更新のみ行う
  --dry-run           何も変更せず、実行した場合の変更予定だけを表示する
  --yes               宣言側の項目を削除する sync に必要（削除がなければ不要）
  --backup-dir DIR    削除・上書きの前に退避するディレクトリ
  各動詞が受け付ける共通オプションはドメインごとに決まっており、受け付けないものはエラーになる。
  ドメイン固有: brew apply --full、{ai|claude|codex} --mcp-only|--plugin-only|--skill-only、
  copilot --mcp-only。
USAGE_TAIL
}

_error() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

_require_no_args() {
  (( $# == 0 )) || _error "unexpected argument: $1"
}

_status_repo() {
  local name="$1" repo_dir="$2" fetch="$3"
  local fetch_failed=false branch changes upstream counts ahead behind

  printf '%s\n' "${name}"
  printf '  path: %s\n' "${repo_dir}"

  if [[ ! -d "${repo_dir}/.git" ]]; then
    printf '  status: not found\n\n'
    return 1
  fi

  if [[ "${fetch}" == true ]]; then
    if ! git -C "${repo_dir}" fetch --quiet --prune; then
      printf '  fetch: failed (cached remote state follows)\n'
      fetch_failed=true
    fi
  fi

  branch="$(git -C "${repo_dir}" branch --show-current 2>/dev/null || true)"
  [[ -n "${branch}" ]] || branch="(detached HEAD)"
  printf '  branch: %s\n' "${branch}"

  if ! changes="$(git -C "${repo_dir}" status --short)"; then
    printf '  status: git status failed\n\n'
    return 1
  fi
  if [[ -n "${changes}" ]]; then
    printf '  working tree:\n'
    while IFS= read -r line; do
      printf '    %s\n' "${line}"
    done <<< "${changes}"
  else
    printf '  working tree: clean\n'
  fi

  if ! upstream="$(git -C "${repo_dir}" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null)"; then
    printf '  remote: no upstream\n\n'
    return 1
  fi

  if ! counts="$(git -C "${repo_dir}" rev-list --left-right --count "HEAD...${upstream}")"; then
    printf '  remote: comparison failed (%s)\n\n' "${upstream}"
    return 1
  fi
  read -r ahead behind <<< "${counts}"
  if [[ ! "${ahead}" =~ ^[0-9]+$ || ! "${behind}" =~ ^[0-9]+$ ]]; then
    printf '  remote: invalid comparison result (%s)\n\n' "${upstream}"
    return 1
  fi
  case "${ahead}:${behind}" in
    0:0) printf '  remote: up to date (%s)\n' "${upstream}" ;;
    0:*) printf '  remote: %s commit(s) to pull (%s)\n' "${behind}" "${upstream}" ;;
    *:0) printf '  remote: %s commit(s) to push (%s)\n' "${ahead}" "${upstream}" ;;
    *)   printf '  remote: diverged; %s to push, %s to pull (%s)\n' "${ahead}" "${behind}" "${upstream}" ;;
  esac
  printf '\n'

  if [[ -n "${changes}" || "${ahead}" -gt 0 || "${behind}" -gt 0 || "${fetch_failed}" == true ]]; then
    return 1
  fi
  return 0
}

_status() {
  local fetch=true result=0

  while (( $# > 0 )); do
    case "$1" in
      --no-fetch) fetch=false ;;
      -h|--help)
        printf 'Usage: dots status [--no-fetch]\n'
        return 0
        ;;
      *) _error "unknown status option: $1" ;;
    esac
    shift
  done

  _status_repo "dotfiles" "${DOTFILES_DIR}" "${fetch}" || result=1
  _status_repo "dotfiles-private" "${PRIVATE_DIR}" "${fetch}" || result=1
  return "${result}"
}

# dots commit / dots push が「システムの実態を機械的に書き写しただけ」と
# みなすファイル一覧。ここに載っているファイルだけで構成された変更・commit
# であれば自動commit・自動pushの対象にする。判断・記述内容を伴う変更（AI宣言
# ファイルの手編集や Brewfile-pin の一時pin宣言等）はここに含めない。
_commit_targets_dotfiles() {
  cat <<'EOF'
macos/Brewfile
macos/Brewfile.local
npm/npmfile
pipx/pipxfile
EOF
}

_commit_targets_private() {
  cat <<'EOF'
macos/dockfile
macos/keyboard-shortcuts.plist
ghq/keep-up-to-date
EOF
}

_commit_label_for_file() {
  case "$1" in
    macos/Brewfile|macos/Brewfile.local) printf 'Brewfile' ;;
    npm/npmfile) printf 'npmfile' ;;
    pipx/pipxfile) printf 'pipxfile' ;;
    macos/dockfile) printf 'dockfile' ;;
    macos/keyboard-shortcuts.plist) printf 'アプリケーションショートカット' ;;
    ghq/keep-up-to-date) printf 'ghq keep-up-to-date' ;;
    *) printf '%s' "$1" ;;
  esac
}

_path_in_list() {
  local path="$1" list="$2" line
  while IFS= read -r line; do
    [[ -n "${line}" && "${path}" == "${line}" ]] && return 0
  done <<< "${list}"
  return 1
}

_commit_repo() {
  local label="$1" repo_dir="$2" targets="$3"
  [[ -d "${repo_dir}/.git" ]] || return 0

  local status_lines
  status_lines="$(git -C "${repo_dir}" status --porcelain)"
  if [[ -z "${status_lines}" ]]; then
    printf '%s: 変更なし\n' "${label}"
    return 0
  fi

  local matched=() blocked=() line path
  while IFS= read -r line; do
    [[ -n "${line}" ]] || continue
    path="${line:3}"
    [[ "${path}" == *' -> '* ]] && path="${path##*' -> '}"
    if _path_in_list "${path}" "${targets}"; then
      matched+=("${path}")
    else
      blocked+=("${path}")
    fi
  done <<< "${status_lines}"

  if (( ${#blocked[@]} > 0 )); then
    printf '%s: 自動commit対象外の変更があるためスキップ（手動でcommitしてください）\n' "${label}"
    printf '    %s\n' "${blocked[@]}"
    return 1
  fi

  local labels="" f lbl
  for f in "${matched[@]}"; do
    lbl="$(_commit_label_for_file "${f}")"
    case " ${labels} " in
      *" ${lbl} "*) ;;
      *) labels="${labels} ${lbl}" ;;
    esac
  done
  labels="${labels# }"
  local joined="${labels// /・}"

  git -C "${repo_dir}" add -- "${matched[@]}"

  local body
  body="$(printf -- '- %s\n' "${matched[@]}")"
  git -C "${repo_dir}" commit -m "chore: ${joined}を実態に同期" -m "${body}"
  printf '%s: commit しました (chore: %sを実態に同期)\n' "${label}" "${joined}"
}

_commit() {
  _require_no_args "$@"
  local result=0
  _commit_repo "dotfiles" "${DOTFILES_DIR}" "$(_commit_targets_dotfiles)" || result=1
  _commit_repo "dotfiles-private" "${PRIVATE_DIR}" "$(_commit_targets_private)" || result=1
  return "${result}"
}

_push_repo() {
  local label="$1" repo_dir="$2" targets="$3" fetch="$4"
  [[ -d "${repo_dir}/.git" ]] || return 0

  if [[ "${fetch}" == true ]]; then
    git -C "${repo_dir}" fetch --quiet --prune || \
      printf '%s: fetch失敗（キャッシュされたリモート情報で判定します）\n' "${label}"
  fi

  local upstream
  if ! upstream="$(git -C "${repo_dir}" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null)"; then
    printf '%s: upstream未設定のためスキップ\n' "${label}"
    return 0
  fi

  local ahead
  ahead="$(git -C "${repo_dir}" rev-list --count "${upstream}..HEAD")"
  if [[ "${ahead}" -eq 0 ]]; then
    printf '%s: pushする変更なし\n' "${label}"
    return 0
  fi

  local changed blocked=() line
  changed="$(git -C "${repo_dir}" diff --name-only "${upstream}..HEAD")"
  while IFS= read -r line; do
    [[ -n "${line}" ]] || continue
    _path_in_list "${line}" "${targets}" || blocked+=("${line}")
  done <<< "${changed}"

  if (( ${#blocked[@]} > 0 )); then
    printf '%s: 自動commit対象外のファイルを含む %s 件のcommitがあるため push しません\n' \
      "${label}" "${ahead}"
    printf '    %s\n' "${blocked[@]}"
    printf '  手動で確認して push してください（git -C %s push）\n' "${repo_dir}"
    return 1
  fi

  git -C "${repo_dir}" push
  printf '%s: %s commit(s) を push しました\n' "${label}" "${ahead}"
}

_push() {
  local fetch=true

  while (( $# > 0 )); do
    case "$1" in
      --no-fetch) fetch=false ;;
      -h|--help)
        printf 'Usage: dots push [--no-fetch]\n'
        return 0
        ;;
      *) _error "unknown push option: $1" ;;
    esac
    shift
  done

  local result=0
  _push_repo "dotfiles" "${DOTFILES_DIR}" "$(_commit_targets_dotfiles)" "${fetch}" || result=1
  _push_repo "dotfiles-private" "${PRIVATE_DIR}" "$(_commit_targets_private)" "${fetch}" || result=1
  return "${result}"
}

_update() {
  _require_no_args "$@"

  case "$(uname -s)" in
    Darwin)
      bash "${DOTFILES_DIR}/scripts/update-dotfiles.sh"
      zsh "${DOTFILES_DIR}/scripts/update-macos.zsh"
      ;;
    Linux)
      bash "${DOTFILES_DIR}/scripts/update-dotfiles.sh"
      bash "${DOTFILES_DIR}/scripts/update-rpi-homebridge.sh"
      ;;
    *) _error "unsupported OS: $(uname -s)" ;;
  esac
}

# diff 系ハンドラの共通ラッパー。終了コード1（差分あり）は正常終了として扱い、
# --exit-code が指定された場合に備えて DOTS_DIFF_FOUND に記録する。
# 2 以上（想定外の失敗）は従来どおり握りつぶさず、そのまま表示だけする。
DOTS_DIFF_FOUND=0
_diff_run() {
  local rc=0
  "$@" || rc=$?
  (( rc != 1 )) || DOTS_DIFF_FOUND=1
  return 0
}

# --backup-dir DIR と --dry-run だけを受け付ける動詞（dock/shortcuts の apply・prune）用。
# 結果は PARSED_BACKUP_DIR / PARSED_DRY_RUN / PARSED_NO_PRUNE に入る。
_parse_backup_dry_run() {
  PARSED_BACKUP_DIR=""
  PARSED_DRY_RUN=false
  PARSED_NO_PRUNE=false

  while (( $# > 0 )); do
    case "$1" in
      --backup-dir)
        (( $# >= 2 )) || _error "--backup-dir requires a directory"
        PARSED_BACKUP_DIR="$2"
        shift 2
        ;;
      --dry-run) PARSED_DRY_RUN=true; shift ;;
      --no-prune) PARSED_NO_PRUNE=true; shift ;;
      *) _error "unknown option: $1" ;;
    esac
  done
}

_brew() {
  local action="${1:-}" backup_dir full=false no_prune=false dry_run=false
  [[ -n "${action}" ]] || _error "usage: dots brew {apply|diff|sync|merge|prune|cache}"
  shift

  case "${action}" in
    apply)
      backup_dir=""
      while (( $# > 0 )); do
        case "$1" in
          --full)
            full=true
            shift
            ;;
          --no-prune)
            no_prune=true
            shift
            ;;
          --dry-run)
            dry_run=true
            shift
            ;;
          --backup-dir)
            (( $# >= 2 )) || _error "--backup-dir requires a directory"
            backup_dir="$2"
            shift 2
            ;;
          *) _error "unknown brew apply option: $1" ;;
        esac
      done

      local brew_args=(--force)
      [[ "${full}" == true ]] || brew_args+=(--diff-only)
      [[ "${no_prune}" == false ]] || brew_args+=(--no-cleanup)

      if [[ "${dry_run}" == true ]]; then
        if [[ "${full}" == false && ! -f "${DOTFILES_DIR}/macos/Brewfile.cache" ]]; then
          _error "Brewfile.cache がありません。先に dots brew cache を実行してください"
        fi
        printf '[dry-run] Brewfile-pin の差分:\n'
        _diff_run bash "${DOTFILES_DIR}/macos/diff_brewpin.sh"
        bash "${DOTFILES_DIR}/macos/apply_brewfile.sh" "${brew_args[@]}" --dry-run
        return 0
      fi

      if [[ "${full}" == false && ! -f "${DOTFILES_DIR}/macos/Brewfile.cache" ]]; then
        bash "${DOTFILES_DIR}/macos/update_brewcache.sh"
      fi
      bash "${DOTFILES_DIR}/macos/apply_brewpin.sh"
      if [[ "${full}" == false ]] && bash "${DOTFILES_DIR}/macos/diff_brewfile.sh" && \
        bash "${DOTFILES_DIR}/macos/diff_brewpin.sh"; then
        printf '差分なし: Brewfile / Brewfile-pin はすでに適用済みです。\n'
        return 0
      fi
      if [[ -n "${backup_dir}" ]]; then
        mkdir -p "${backup_dir}"
        brew bundle dump --force --file="${backup_dir}/Brewfile" 2>/dev/null && \
          printf '  BACKUP  %s\n' "${backup_dir}/Brewfile" || true
      fi
      bash "${DOTFILES_DIR}/macos/apply_brewfile.sh" "${brew_args[@]}"
      bash "${DOTFILES_DIR}/macos/update_brewcache.sh"
      bash "${DOTFILES_DIR}/macos/update_brewpin_cache.sh"
      ;;
    prune)
      backup_dir=""
      while (( $# > 0 )); do
        case "$1" in
          --dry-run)
            dry_run=true
            shift
            ;;
          --backup-dir)
            (( $# >= 2 )) || _error "--backup-dir requires a directory"
            backup_dir="$2"
            shift 2
            ;;
          *) _error "unknown brew prune option: $1" ;;
        esac
      done

      if [[ "${dry_run}" == true ]]; then
        bash "${DOTFILES_DIR}/macos/apply_brewfile.sh" --prune-only --dry-run
        return 0
      fi
      if [[ -n "${backup_dir}" ]]; then
        mkdir -p "${backup_dir}"
        brew bundle dump --force --file="${backup_dir}/Brewfile" 2>/dev/null && \
          printf '  BACKUP  %s\n' "${backup_dir}/Brewfile" || true
      fi
      bash "${DOTFILES_DIR}/macos/apply_brewfile.sh" --prune-only --force
      bash "${DOTFILES_DIR}/macos/update_brewcache.sh"
      ;;
    diff)
      _diff_run bash "${DOTFILES_DIR}/macos/diff_brewfile.sh" "$@"
      _diff_run bash "${DOTFILES_DIR}/macos/diff_brewpin.sh" "$@"
      ;;
    sync)
      bash "${DOTFILES_DIR}/macos/sync_brewfile.sh" "$@"
      [[ " $* " == *" --dry-run "* ]] || bash "${DOTFILES_DIR}/macos/update_brewpin_cache.sh"
      ;;
    merge)
      bash "${DOTFILES_DIR}/macos/sync_brewfile.sh" --add-only "$@"
      [[ " $* " == *" --dry-run "* ]] || bash "${DOTFILES_DIR}/macos/update_brewpin_cache.sh"
      ;;
    cache)
      _require_no_args "$@"
      bash "${DOTFILES_DIR}/macos/update_brewcache.sh"
      bash "${DOTFILES_DIR}/macos/update_brewpin_cache.sh"
      ;;
    *) _error "unknown brew action: ${action}" ;;
  esac
}

_dock() {
  local action="${1:-}"
  [[ -n "${action}" ]] || _error "usage: dots dock {apply|diff|sync|merge|cache}"
  shift

  case "${action}" in
    apply)
      _parse_backup_dry_run "$@"
      if [[ "${PARSED_NO_PRUNE}" == true ]]; then
        _error "dots dock apply は --no-prune を受け付けません"
      fi
      if [[ "${PARSED_DRY_RUN}" == true ]]; then
        # apply は差分のある側を丸ごと再構築するため、変更予定は diff と同じになる
        printf '[dry-run] Dock・サイドバーの差分（apply はこれを再構築します）:\n'
        _diff_run bash "${DOTFILES_DIR}/macos/diff_dockfile.sh"
        return 0
      fi
      if bash "${DOTFILES_DIR}/macos/diff_dockfile.sh"; then
        printf '差分なし: Dock はすでに適用済みです。\n'
        return 0
      fi
      if [[ -n "${PARSED_BACKUP_DIR}" && -f "${PRIVATE_DIR}/macos/dockfile.cache" ]]; then
        mkdir -p "${PARSED_BACKUP_DIR}"
        cp "${PRIVATE_DIR}/macos/dockfile.cache" "${PARSED_BACKUP_DIR}/dockfile.cache"
        printf '  BACKUP  %s\n' "${PARSED_BACKUP_DIR}/dockfile.cache"
      fi
      bash "${DOTFILES_DIR}/macos/apply_dockfile.sh"
      ;;
    diff)
      _diff_run bash "${DOTFILES_DIR}/macos/diff_dockfile.sh" "$@"
      ;;
    sync)
      bash "${DOTFILES_DIR}/macos/sync_dockfile.sh" "$@"
      ;;
    merge)
      bash "${DOTFILES_DIR}/macos/sync_dockfile.sh" --merge "$@"
      ;;
    cache)
      _require_no_args "$@"
      bash "${DOTFILES_DIR}/macos/update_dockcache.sh"
      ;;
    *) _error "unknown dock action: ${action}" ;;
  esac
}

# _parse_backup_dry_run 済みの --backup-dir があれば、現在のアプリケーションショートカットを退避する。
_shortcuts_backup() {
  [[ -n "${PARSED_BACKUP_DIR}" ]] || return 0
  mkdir -p "${PARSED_BACKUP_DIR}"
  python3 "${DOTFILES_DIR}/macos/keyboard_shortcuts.py" capture \
    --output "${PARSED_BACKUP_DIR}/keyboard-shortcuts.plist"
  printf '  BACKUP  %s\n' "${PARSED_BACKUP_DIR}/keyboard-shortcuts.plist"
}

_shortcuts() {
  local action="${1:-}" args=()
  [[ "$(uname -s)" == "Darwin" ]] || _error "shortcuts is supported on macOS only"
  [[ -n "${action}" ]] || _error "usage: dots shortcuts {apply|diff|sync|merge|prune|cache}"
  shift

  case "${action}" in
    apply)
      _parse_backup_dry_run "$@"
      [[ "${PARSED_DRY_RUN}" == false ]] || args+=(--dry-run)
      [[ "${PARSED_NO_PRUNE}" == false ]] || args+=(--no-prune)
      if [[ "${PARSED_DRY_RUN}" == true ]]; then
        bash "${DOTFILES_DIR}/macos/apply_keyboard_shortcuts.sh" "${args[@]}"
        return 0
      fi
      if bash "${DOTFILES_DIR}/macos/diff_keyboard_shortcuts.sh"; then
        printf '差分なし: アプリケーションショートカットはすでに適用済みです。\n'
        return 0
      fi
      _shortcuts_backup
      bash "${DOTFILES_DIR}/macos/apply_keyboard_shortcuts.sh" ${args[@]+"${args[@]}"}
      ;;
    prune)
      _parse_backup_dry_run "$@"
      if [[ "${PARSED_NO_PRUNE}" == true ]]; then
        _error "dots shortcuts prune は --no-prune を受け付けません"
      fi
      if [[ "${PARSED_DRY_RUN}" == true ]]; then
        bash "${DOTFILES_DIR}/macos/prune_keyboard_shortcuts.sh" --dry-run
        return 0
      fi
      _shortcuts_backup
      bash "${DOTFILES_DIR}/macos/prune_keyboard_shortcuts.sh"
      ;;
    diff)
      _diff_run bash "${DOTFILES_DIR}/macos/diff_keyboard_shortcuts.sh" "$@"
      ;;
    sync)
      bash "${DOTFILES_DIR}/macos/sync_keyboard_shortcuts.sh" "$@"
      ;;
    merge)
      bash "${DOTFILES_DIR}/macos/merge_keyboard_shortcuts.sh" "$@"
      ;;
    cache)
      _require_no_args "$@"
      bash "${DOTFILES_DIR}/macos/update_keyboard_shortcuts_cache.sh"
      ;;
    *) _error "unknown shortcuts action: ${action}" ;;
  esac
}

_package_file() {
  local package="$1" action="${2:-}"
  [[ -n "${action}" ]] || _error "usage: dots ${package} {apply|diff|sync|merge|prune|cache}"
  shift 2

  # 共通オプション（--dry-run / --no-prune / --yes / --backup-dir）は動詞ゲートが検証済みで、
  # 各スクリプトへそのまま渡す。cache だけは引数を取らない。
  case "${action}" in
    apply)
      # 差分の有無はキャッシュではなく実状態で判定する（キャッシュが古いと削除を見落とすため）。
      # スクリプト自身が冪等なので、事前の diff による早期終了は行わない。
      bash "${DOTFILES_DIR}/${package}/apply_${package}file.sh" "$@"
      ;;
    diff)  _diff_run bash "${DOTFILES_DIR}/${package}/diff_${package}file.sh" "$@" ;;
    sync)  bash "${DOTFILES_DIR}/${package}/sync_${package}file.sh" "$@" ;;
    merge) bash "${DOTFILES_DIR}/${package}/sync_${package}file.sh" --add-only "$@" ;;
    prune) bash "${DOTFILES_DIR}/${package}/prune_${package}file.sh" "$@" ;;
    cache) _require_no_args "$@"; bash "${DOTFILES_DIR}/${package}/update_${package}cache.sh" ;;
    *) _error "unknown ${package} action: ${action}" ;;
  esac
}

_ghq() {
  local action="${1:-}"
  [[ -n "${action}" ]] || _error "usage: dots ghq {apply|diff|sync|merge|prune}"
  shift

  case "${action}" in
    diff)
      # 終了コード1は「差分あり」（他の diff と同様に正常終了）。2 以上のエラーは伝える。
      local rc=0
      bash "${DOTFILES_DIR}/ghq/keep-up-to-date.sh" diff "$@" || rc=$?
      (( rc != 1 )) || DOTS_DIFF_FOUND=1
      (( rc <= 1 )) || return "${rc}"
      ;;
    apply|prune|sync|merge)
      # 共通オプション（--dry-run / --no-prune / --yes）は動詞ゲートが検証済み
      bash "${DOTFILES_DIR}/ghq/keep-up-to-date.sh" "${action}" "$@"
      ;;
    *) _error "unknown ghq action: ${action}" ;;
  esac
}

_ai_agent() {
  local agent="$1" action="${2:-}"
  local mcp_only=false plugin_only=false skill_only=false only_count=0 no_prune=false
  [[ -n "${action}" ]] || _error "usage: dots ${agent} {apply|diff|prune} [--no-prune] [--mcp-only|--plugin-only|--skill-only]"
  shift 2

  [[ "${action}" == apply || "${action}" == diff || "${action}" == prune ]] || \
    _error "unknown ${agent} action: ${action} (apply/diff/prune are supported)"

  local arg
  for arg in "$@"; do
    case "${arg}" in
      --mcp-only) mcp_only=true ;;
      --plugin-only) plugin_only=true ;;
      --skill-only) skill_only=true ;;
      --no-prune) no_prune=true ;;
      *) _error "unknown ${agent} option: ${arg}" ;;
    esac
  done
  [[ "${mcp_only}" == true ]] && (( only_count++ )) || true
  [[ "${plugin_only}" == true ]] && (( only_count++ )) || true
  [[ "${skill_only}" == true ]] && (( only_count++ )) || true
  (( only_count <= 1 )) || _error "--mcp-only / --plugin-only / --skill-only は同時指定できない"
  [[ "${no_prune}" == false || "${action}" == apply ]] || _error "--no-prune は apply でだけ指定できる"

  local run_mcp=true run_plugin=true run_skill=true
  if (( only_count == 1 )); then
    run_mcp="${mcp_only}"
    run_plugin="${plugin_only}"
    run_skill="${skill_only}"
  fi

  if [[ "${run_mcp}" == true ]]; then
    echo "--- mcp ---"
    case "${action}" in
      diff) _diff_run bash "${DOTFILES_DIR}/ai/${agent}/mcp/diff.sh" ;;
      apply)
        bash "${DOTFILES_DIR}/ai/${agent}/mcp/apply.sh"
        [[ "${no_prune}" == true ]] || bash "${DOTFILES_DIR}/ai/${agent}/mcp/prune.sh"
        ;;
      prune) bash "${DOTFILES_DIR}/ai/${agent}/mcp/prune.sh" ;;
    esac
  fi
  if [[ "${run_plugin}" == true ]]; then
    echo "--- plugin ---"
    case "${action}" in
      diff) _diff_run bash "${DOTFILES_DIR}/ai/${agent}/plugin/diff.sh" ;;
      apply)
        bash "${DOTFILES_DIR}/ai/${agent}/plugin/apply.sh"
        [[ "${no_prune}" == true ]] || bash "${DOTFILES_DIR}/ai/${agent}/plugin/prune.sh"
        ;;
      prune) bash "${DOTFILES_DIR}/ai/${agent}/plugin/prune.sh" ;;
    esac
  fi
  if [[ "${run_skill}" == true ]]; then
    echo "--- skill ---"
    case "${action}" in
      diff) _diff_run bash "${DOTFILES_DIR}/ai/skills/diff.sh" "${agent}" ;;
      apply)
        bash "${DOTFILES_DIR}/ai/skills/apply.sh" "${agent}"
        [[ "${no_prune}" == true ]] || bash "${DOTFILES_DIR}/ai/skills/prune.sh" "${agent}"
        ;;
      prune) bash "${DOTFILES_DIR}/ai/skills/prune.sh" "${agent}" ;;
    esac
  fi
}

_ai() {
  local action="${1:-}"
  [[ -n "${action}" ]] || \
    _error "usage: dots ai {apply|diff|prune} [--no-prune] [--mcp-only|--plugin-only|--skill-only]"
  shift

  [[ "${action}" == apply || "${action}" == diff || "${action}" == prune ]] || \
    _error "unknown ai action: ${action} (apply/diff/prune are supported)"

  local agent
  for agent in claude codex; do
    printf '=== %s ===\n' "${agent}"
    _ai_agent "${agent}" "${action}" "$@"
    printf '\n'
  done
}

_copilot() {
  local action="${1:-}"
  [[ -n "${action}" ]] || _error "usage: dots copilot {apply|diff|prune} [--no-prune] [--mcp-only]"
  shift

  [[ "${action}" == apply || "${action}" == diff || "${action}" == prune ]] || \
    _error "unknown copilot action: ${action} (apply/diff/prune are supported)"
  local no_prune=false arg
  for arg in "$@"; do
    case "${arg}" in
      --mcp-only) ;;
      --no-prune) no_prune=true ;;
      *) _error "unknown copilot option: ${arg}" ;;
    esac
  done
  [[ "${no_prune}" == false || "${action}" == apply ]] || _error "--no-prune は apply でだけ指定できる"

  echo "--- mcp ---"
  case "${action}" in
    diff) _diff_run bash "${DOTFILES_DIR}/ai/copilot/mcp/diff.sh" ;;
    apply)
      bash "${DOTFILES_DIR}/ai/copilot/mcp/apply.sh"
      [[ "${no_prune}" == true ]] || bash "${DOTFILES_DIR}/ai/copilot/mcp/prune.sh"
      ;;
    prune) bash "${DOTFILES_DIR}/ai/copilot/mcp/prune.sh" ;;
  esac
}

_check_repo_summary() {
  local label="$1" dir="$2"
  [[ -d "${dir}/.git" ]] || return 0

  local parts=()
  if ! git -C "${dir}" diff --quiet 2>/dev/null || \
     ! git -C "${dir}" diff --cached --quiet 2>/dev/null; then
    parts+=("uncommitted changes")
  fi
  local unpushed
  unpushed="$(git -C "${dir}" log '@{u}..' --oneline 2>/dev/null | wc -l | tr -d ' ')"
  if [[ "${unpushed}" -gt 0 ]]; then
    parts+=("${unpushed} commits unpushed")
  fi

  (( ${#parts[@]} > 0 )) || return 0
  local joined
  joined="$(IFS=' / '; echo "${parts[*]}")"
  printf '⚠ %s: %s (dots status で確認)\n' "${label}" "${joined}"
  return 1
}

_check_links_summary() {
  local output broken missing
  output="$(bash "${DOTFILES_DIR}/scripts/check.sh" 2>&1)" || true
  broken="$(printf '%s\n' "${output}" | grep -oE 'BROKEN=[0-9]+' | cut -d= -f2)"
  missing="$(printf '%s\n' "${output}" | grep -oE 'NOT LINKED=[0-9]+' | cut -d= -f2)"
  [[ "${broken:-0}" -gt 0 || "${missing:-0}" -gt 0 ]] || return 0
  printf '⚠ links: %s broken / %s not linked (make check で確認)\n' "${broken:-0}" "${missing:-0}"
  return 1
}

# scripts/install.sh が make install / dots update のたびに、シンボリンク化
# できない既存ファイルを ~/.dotfiles-backup/<timestamp>/ へ退避する。放置すると
# 無期限に増え続けるため、溜まっている件数を知らせる（削除は破壊的操作の
# ため対象外。ユーザー自身が中身を確認して rm -rf すること）。
_check_backup_summary() {
  local backup_dir="${HOME}/.dotfiles-backup" count
  [[ -d "${backup_dir}" ]] || return 0
  count="$(find "${backup_dir}" -mindepth 1 -maxdepth 1 -type d | wc -l | tr -d ' ')"
  [[ "${count:-0}" -gt 0 ]] || return 0
  printf '⚠ backup: %s件が %s に蓄積（中身を確認し、不要なら rm -rf で削除）\n' "${count}" "${backup_dir}"
  return 1
}

_check_sudo_touch_id_summary() {
  [[ "$(uname -s)" == "Darwin" ]] || return 0

  local sudo_pam="/etc/pam.d/sudo"
  local sudo_local_pam="/etc/pam.d/sudo_local"

  if [[ ! -r "${sudo_pam}" ]] || \
     ! awk '$1 == "auth" && $2 == "include" && $3 == "sudo_local" { found = 1 } END { exit !found }' \
       "${sudo_pam}"; then
    printf '⚠ sudo Touch ID: %s が sudo_local を読み込んでいません\n' "${sudo_pam}"
    return 1
  fi

  if [[ ! -r "${sudo_local_pam}" ]] || \
     ! awk '$1 == "auth" && $2 == "sufficient" && $3 == "pam_tid.so" { found = 1 } END { exit !found }' \
       "${sudo_local_pam}"; then
    printf '⚠ sudo Touch ID: %s で pam_tid.so が有効ではありません\n' "${sudo_local_pam}"
    return 1
  fi
}

_check_script_summary() {
  local label="$1" hint="$2"
  shift 2
  local output
  output="$("$@" --summary 2>/dev/null)" || true
  [[ -n "${output}" ]] || return 0
  printf '⚠ %s: %s (%s)\n' "${label}" "${output}" "${hint}"
  return 1
}

_check_summary() {
  local found=0

  _check_links_summary || found=1
  _check_backup_summary || found=1
  _check_sudo_touch_id_summary || found=1
  _check_repo_summary "dotfiles" "${DOTFILES_DIR}" || found=1
  _check_repo_summary "dotfiles-private" "${PRIVATE_DIR}" || found=1

  _check_script_summary "brew" "dots brew diff で確認" \
    bash "${DOTFILES_DIR}/macos/diff_brewfile.sh" || found=1
  _check_script_summary "brew pin" "dots brew diff で確認" \
    bash "${DOTFILES_DIR}/macos/diff_brewpin.sh" || found=1
  _check_script_summary "npm" "dots npm diff で確認" \
    bash "${DOTFILES_DIR}/npm/diff_npmfile.sh" || found=1
  _check_script_summary "pipx" "dots pipx diff で確認" \
    bash "${DOTFILES_DIR}/pipx/diff_pipxfile.sh" || found=1
  _check_script_summary "ghq keep-up-to-date" "dots ghq diff で確認" \
    bash "${DOTFILES_DIR}/ghq/keep-up-to-date.sh" diff || found=1
  _check_script_summary "dock" "dots dock diff で確認" \
    bash "${DOTFILES_DIR}/macos/diff_dockfile.sh" || found=1
  _check_script_summary "application shortcuts" "dots shortcuts diff で確認" \
    bash "${DOTFILES_DIR}/macos/diff_keyboard_shortcuts.sh" || found=1

  local agent
  for agent in claude codex; do
    if [[ "${agent}" == codex ]] && ! command -v codex >/dev/null 2>&1; then
      continue
    fi
    if [[ -f "${DOTFILES_DIR}/ai/${agent}/mcp/servers.json" ]]; then
      _check_script_summary "${agent} mcp" "dots ${agent} diff --mcp-only で確認" \
        bash "${DOTFILES_DIR}/ai/${agent}/mcp/diff.sh" || found=1
    fi
    if [[ -f "${DOTFILES_DIR}/ai/${agent}/plugin/plugins.json" ]]; then
      _check_script_summary "${agent} plugin" "dots ${agent} diff --plugin-only で確認" \
        bash "${DOTFILES_DIR}/ai/${agent}/plugin/diff.sh" || found=1
    fi
    if [[ -f "${DOTFILES_DIR}/ai/skills/external.json" ]]; then
      _check_script_summary "${agent} skill" "dots ${agent} diff --skill-only で確認" \
        bash "${DOTFILES_DIR}/ai/skills/diff.sh" "${agent}" || found=1
    fi
  done

  if command -v copilot >/dev/null 2>&1 && [[ -f "${DOTFILES_DIR}/ai/copilot/mcp/servers.json" ]]; then
    _check_script_summary "copilot mcp" "dots copilot diff で確認" \
      bash "${DOTFILES_DIR}/ai/copilot/mcp/diff.sh" || found=1
  fi

  return "${found}"
}

_check_verbose() {
  echo "=========================================="
  echo " Checking symlinks (make check) ..."
  echo "=========================================="
  bash "${DOTFILES_DIR}/scripts/check.sh" || true
  echo ""

  echo "=========================================="
  echo " Checking dotfiles / dotfiles-private status ..."
  echo "=========================================="
  _status || true
  echo ""

  echo "=========================================="
  echo " Checking ~/.dotfiles-backup accumulation ..."
  echo "=========================================="
