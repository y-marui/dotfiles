#!/usr/bin/env zsh
# shellcheck shell=bash
# ghq-status: ghq 管理リポジトリの git 状態・dev-charter・keep-up-to-date をテーブル表示
#
# 使い方:
#   ghq-status [options]
#
# オプション:
#   -f, --filter PATTERN          リポジトリパスが正規表現 PATTERN にマッチするものだけを対象にする
#   -a, --all                     branch が保護ブランチ（リポジトリの .gitattributes の
#                                 repo-protected-branches）かつ git status が
#                                 clean かつ BRANCHES/DEV-CHARTER がハイライトされていない
#                                 リポジトリも表示する（デフォルトでは非表示）
#   -p, --paths-only              異常のあるリポジトリ（デフォルト表示される行）の
#                                 フルパスだけを1行ずつ出力する。テーブル表示はせず、
#                                 -a は無視する（常に異常のあるリポジトリのみ）。
#                                 他コマンドからパイプで使うためのもの
#   --ignore-charter-outdated     DEV-CHARTER が古いことによるハイライト・強制表示を無視する
#   --no-ignore-charter-outdated  DEV-CHARTER が古い場合にハイライト・強制表示する（無視しない）
#   -h, --help                    ヘルプを表示
#
# --ignore-charter-outdated / --no-ignore-charter-outdated を省略した場合のデフォルトは
# git config local.status-ignore-charter-outdated（true/false）に従う。
#
# ブランチ方針（.gitattributes）:
#   * repo-main-branch=develop
#   * repo-protected-branches=main,develop
#   * repo-remote-only-branches=lite
# repo-protected-branches はローカル・origin双方、repo-remote-only-branches はoriginだけに
# 存在することを期待する。属性未設定時だけ local.repo-main-branch、
# local.repo-protected-branches、local.repo-remote-only-branches をfallbackとして使う。
# 旧 git-sweep-main / git-sweep-protected 属性と
# local.status-allowed-remote-branch（glob・複数可）も互換fallbackとして読み取る。
#
# その他のgit config / 環境変数:
#   local.status-ignore-charter-outdated true/false
#       DEV-CHARTER 列が古い（charter_latest より古い）場合の赤色ハイライトと、
#       -a 無指定時の強制表示（quiet row 扱いにしない挙動）を無視するかどうかの
#       デフォルト値。CLI の --ignore-charter-outdated / --no-ignore-charter-outdated
#       で都度上書きできる。git config が一切未設定の場合のスクリプト側フォールバックは
#       false（従来通りハイライト・強制表示する）だが、dotfiles 配布の
#       git/gitconfig（[local] セクション）でデフォルト true（無視する）を設定済み。
#   GHQ_STATUS_JOBS
#       リポジトリ情報を並列取得するワーカー数。デフォルトは8。
#
# BRANCHES 列はローカル/originの実測数を表示する。main+developがprotected、liteが
# remote-onlyなら正常値は1+1/1+2。数だけでなくブランチ名と配置も検証するため、
# liteがローカルにもある、または別名ブランチに置き換わった場合もハイライトする。

# shellcheck disable=SC2296  # ${(m)#} ${(f)} は zsh 固有の構文
# shellcheck disable=SC2053  # ${~pat} は zsh の glob 展開フラグで意図的に unquote している
# shellcheck disable=SC2034  # ${~br_pat} 内で参照されるが shellcheck(bash) は検出できない

unsetopt BG_NICE

_GHQ_STATUS_TMP_DIR=''
_GHQ_STATUS_TMP_PREFIX=''

_cleanup_status_tmp() {
  [[ -n "$_GHQ_STATUS_TMP_DIR" && -n "$_GHQ_STATUS_TMP_PREFIX" &&
     "$_GHQ_STATUS_TMP_DIR" == "$_GHQ_STATUS_TMP_PREFIX"* ]] || return 0
  command rm -rf -- "$_GHQ_STATUS_TMP_DIR"
  _GHQ_STATUS_TMP_DIR=''
}

_collect_repo() {
  local repo="$1" root="$2"
  local rel branch staged=0 unstaged=0 untracked=0 stashed=0 ahead=0 behind=0 status_str
  local main_branch protected_raw remote_only_raw base is_protected p
  local status_output attrs_output config_output refs_output line key value xy ref sym origin_head='' main_name=main
  local br_name br_pat expected policy_ok=1 legacy_remote_extra=0 matched
  local local_br origin_br br_str charter_ver keep_val expected_br
  typeset -A attrs config_values
  typeset -a protected_list remote_only_list legacy_remote_patterns local_branch_names origin_branch_names

  rel="${repo#"$root/"}"

  # status、branch、upstream差分、stashを1回の走査で取得する。
  status_output="$(git -C "$repo" status --porcelain=v2 --branch --show-stash \
    --ahead-behind --untracked-files=all 2>/dev/null || true)"
  while IFS= read -r line; do
    case "$line" in
      '# branch.head '*)
        branch="${line#\# branch.head }"
        [[ "$branch" == '(detached)' ]] && branch=HEAD
        ;;
      '# branch.ab +'*)
        value="${line#\# branch.ab +}"
        ahead="${value%% *}"
        behind="${value##* -}"
        ;;
      '# stash '*)
        stashed="${line#\# stash }"
        ;;
      '1 '*|'2 '*|'u '*)
        xy="${line[3,4]}"
        [[ "${xy[1]}" != . ]] && (( staged++ ))
        [[ "${xy[2]}" != . ]] && (( unstaged++ ))
        ;;
      '? '*) (( untracked++ )) ;;
    esac
  done <<< "$status_output"
  [[ -n "$branch" ]] || branch='?'

  # リポジトリ属性は属性ごとではなく1回のGit呼び出しで取得する。
  attrs_output="$(git -C "$repo" check-attr \
    repo-main-branch git-sweep-main repo-protected-branches git-sweep-protected \
    repo-remote-only-branches -- . 2>/dev/null || true)"
  while IFS= read -r line; do
    [[ "$line" == *': '*': '* ]] || continue
    value="${line##*: }"
    key="${line#*: }"
    key="${key%%:*}"
    attrs[$key]="$value"
  done <<< "$attrs_output"

  # fallback設定も1回で取得し、同じキーが複数あれば従来通り最後の値を使う。
  config_output="$(git -C "$repo" config --get-regexp \
    '^local\.(repo-main-branch|repo-protected-branches|repo-remote-only-branches|status-allowed-remote-branch|keep-up-to-date)$' \
    2>/dev/null || true)"
  while IFS= read -r line; do
    [[ "$line" == *' '* ]] || continue
    key="${line%% *}"
    value="${line#* }"
    if [[ "$key" == local.status-allowed-remote-branch ]]; then
      legacy_remote_patterns+=("$value")
    else
      config_values[$key]="$value"
    fi
  done <<< "$config_output"

  # ローカル・originブランチとorigin/HEADを1回で取得する。
  refs_output="$(git -C "$repo" for-each-ref --format='%(refname)%09%(symref)' \
    refs/heads refs/remotes/origin 2>/dev/null || true)"
  while IFS= read -r line; do
    [[ "$line" == *$'\t'* ]] || continue
    ref="${line%%$'\t'*}"
    sym="${line#*$'\t'}"
    case "$ref" in
      refs/heads/*) local_branch_names+=("${ref#refs/heads/}") ;;
      refs/remotes/origin/HEAD)
        [[ -n "$sym" ]] && origin_head="${sym#refs/remotes/origin/}"
        ;;
      refs/remotes/origin/*) origin_branch_names+=("${ref#refs/remotes/origin/}") ;;
    esac
  done <<< "$refs_output"

  main_branch="${attrs[repo-main-branch]:-}"
  [[ -n "$main_branch" && "$main_branch" != unspecified ]] || main_branch="${attrs[git-sweep-main]:-}"
  [[ -n "$main_branch" && "$main_branch" != unspecified ]] || main_branch="${config_values[local.repo-main-branch]:-}"
  if [[ -z "$main_branch" && -n "$origin_head" && ${origin_branch_names[(Ie)$origin_head]} -gt 0 ]]; then
    main_branch="$origin_head"
  fi
  [[ -n "$main_branch" ]] || main_branch=main

  protected_raw="${attrs[repo-protected-branches]:-}"
  [[ -n "$protected_raw" && "$protected_raw" != unspecified ]] || protected_raw="${attrs[git-sweep-protected]:-}"
  [[ -n "$protected_raw" && "$protected_raw" != unspecified ]] || protected_raw="${config_values[local.repo-protected-branches]:-}"
  if [[ -n "$protected_raw" && "$protected_raw" != unspecified ]]; then
    protected_list=("${(@s:,:)protected_raw}")
  else
    protected_list=("$main_branch")
    if [[ "$main_branch" != main ]] && {
      (( ${local_branch_names[(Ie)$main_name]} )) || (( ${origin_branch_names[(Ie)$main_name]} ))
    }; then
      protected_list+=(main)
    fi
  fi
  protected_list=("${(u)protected_list[@]}")
  (( ${protected_list[(Ie)$main_branch]} )) || protected_list+=("$main_branch")

  remote_only_raw="${attrs[repo-remote-only-branches]:-}"
  [[ -n "$remote_only_raw" && "$remote_only_raw" != unspecified ]] || remote_only_raw="${config_values[local.repo-remote-only-branches]:-}"
  if [[ -n "$remote_only_raw" && "$remote_only_raw" != unspecified ]]; then
    remote_only_list=("${(@s:,:)remote_only_raw}")
    remote_only_list=("${(u)remote_only_list[@]}")
    legacy_remote_patterns=()
  else
    remote_only_list=()
  fi

  base=${#protected_list}
  is_protected=0
  for p in "${protected_list[@]}"; do
    [[ "$branch" == "$p" ]] && { is_protected=1; break; }
  done

  status_str=''
  (( staged    > 0 )) && status_str+=" +${staged}"
  (( unstaged  > 0 )) && status_str+=" !${unstaged}"
  (( untracked > 0 )) && status_str+=" ?${untracked}"
  (( stashed   > 0 )) && status_str+=" *${stashed}"
  (( ahead     > 0 )) && status_str+=" ⇡${ahead}"
  (( behind    > 0 )) && status_str+=" ⇣${behind}"
  status_str="${status_str# }"
  [[ -n "$status_str" ]] || status_str='✓'

  local_br=${#local_branch_names[@]}
  origin_br=${#origin_branch_names[@]}
  for expected in "${protected_list[@]}"; do
    (( ${local_branch_names[(Ie)$expected]} )) || policy_ok=0
    (( ${origin_branch_names[(Ie)$expected]} )) || policy_ok=0
  done
  for expected in "${remote_only_list[@]}"; do
    (( ${local_branch_names[(Ie)$expected]} )) && policy_ok=0
    (( ${origin_branch_names[(Ie)$expected]} )) || policy_ok=0
  done
  for br_name in "${local_branch_names[@]}"; do
    (( ${protected_list[(Ie)$br_name]} )) || policy_ok=0
  done
  for br_name in "${origin_branch_names[@]}"; do
    matched=0
    (( ${protected_list[(Ie)$br_name]} || ${remote_only_list[(Ie)$br_name]} )) && matched=1
    if (( ! matched )); then
      for br_pat in "${legacy_remote_patterns[@]}"; do
        if [[ "$br_name" == ${~br_pat} ]]; then
          matched=1
          (( legacy_remote_extra++ ))
          break
        fi
      done
    fi
    (( matched )) || policy_ok=0
  done

  local remote_only_expected=$(( ${#remote_only_list[@]} + legacy_remote_extra ))
  local base_extra=$(( base - 1 ))
  local local_extra_actual=$(( local_br - 1 ))
  local origin_extra_actual=$(( origin_br - 1 ))
  if (( base_extra > 0 )); then
    br_str="1+${local_extra_actual}/1+${origin_extra_actual}"
    expected_br="1\+${base_extra}/1\+$(( base_extra + remote_only_expected ))"
  else
    br_str="${local_br}/${origin_br}"
    expected_br="1/$(( 1 + remote_only_expected ))"
  fi

  if [[ -r "$repo/docs/dev-charter/VERSION" ]]; then
    charter_ver="$(<"$repo/docs/dev-charter/VERSION")"
    local charter_variant='full'
    if [[ -r "$repo/docs/dev-charter/CHARTER_INDEX.md" ]]; then
      local marker
      marker="$(head -1 "$repo/docs/dev-charter/CHARTER_INDEX.md" | grep -oE '\([a-z0-9_-]+\)$')"
      [[ -n "$marker" ]] && charter_variant="${marker//[()]/}"
    fi
    charter_ver="${charter_ver} (${charter_variant})"
  fi
  [[ -n "$charter_ver" ]] || charter_ver='-'

  keep_val="${config_values[local.keep-up-to-date]:-}"
  [[ "$keep_val" == true ]] && keep_val=keep || keep_val=skip

  printf '%s\0' "${rel%/*}" "${rel##*/}" "$branch" "$status_str" "$br_str" \
    "$charter_ver" "$keep_val" "$expected_br" "$is_protected" "$policy_ok" "$repo"
}

_pad() {
  local str="$1" w="$2"
  (( ${(m)#str} > w )) && str="${str[1,$(( w - 1 ))]}…"
  printf '%s%*s' "$str" $(( w - ${(m)#str} )) ''
}

_rule() {
  local n="$1" ch="$2" out='' i
  for (( i = 0; i < n; i++ )); do out+="$ch"; done
  printf '%s' "$out"
}

# branch が保護ブランチ（main+develop 運用なら develop も含む）かつ git status が
# clean かつ BRANCHES/DEV-CHARTER がハイライト対象でない（=注目すべき情報がない）
# 行かどうかを判定する
_is_quiet_row() {
  local status_val="$1" br="$2" charter="$3" is_protected="$4" expected_br="$5" policy_ok="$6"
  [[ "$is_protected" != 1 ]] && return 1
  [[ "$status_val" != "✓" ]] && return 1
  [[ "$policy_ok" != 1 ]] && return 1
  [[ ! "$br" =~ ^${expected_br}$ ]] && return 1
  # charter は "VERSION (variant)" 形式なので、比較は VERSION 部分だけで行う
  # （末尾の " (full)"/" (lite)" を含めた文字列比較だと、VERSION が完全一致
  # していても suffix の有無で "<" が真になり得るため）
  [[ "$ignore_charter" != 1 && -n "$charter_latest" && "$charter" != "-" && "${charter%% \(*}" < "$charter_latest" ]] && return 1
  return 0
}

_row() {
  local _branch_color=''
  [[ "$9" != 1 ]] && _branch_color=$'\033[31m'
  local _status_color=''
  [[ "$3" != "✓" ]] && _status_color=$'\033[31m'
  printf '│ '; _pad "$1" "$w_repo"
  printf ' │ %s' "$_branch_color"; _pad "$2" "$w_branch"; printf '\033[0m'
  printf ' │ %s' "$_status_color"; _pad "$3" "$w_status"; printf '\033[0m'
  local _bc=''
  [[ ! "$4" =~ ^${7}$ || "$8" != 1 ]] && _bc=$'\033[31m'
  printf ' │ %s' "$_bc"; _pad "$4" "$w_br"; printf '\033[0m'
  local _cc=''
  [[ "$ignore_charter" != 1 && -n "$charter_latest" && "$5" != "-" && "${5%% \(*}" < "$charter_latest" ]] && _cc=$'\033[31m'
  printf ' │ %s' "$_cc"; _pad "$5" "$w_charter"; printf '\033[0m'
  local _kc=''
  case "$6" in keep) _kc=$'\033[32m' ;; skip) _kc=$'\033[90m' ;; esac
  printf ' │ %s' "$_kc"; _pad "$6" "$w_keep"; printf '\033[0m │\n'
}

_header() {
  printf '│ \033[1m'; _pad "$1" "$w_repo"
  printf '\033[0m │ \033[1m'; _pad "$2" "$w_branch"
  printf '\033[0m │ \033[1m'; _pad "$3" "$w_status"
  printf '\033[0m │ \033[1m'; _pad "$4" "$w_br"
  printf '\033[0m │ \033[1m'; _pad "$5" "$w_charter"
  printf '\033[0m │ \033[1m'; _pad "$6" "$w_keep"
  printf '\033[0m │\n'
}

main() {
  local filter="$1"
  local show_all="$2"
  local ignore_charter_arg="$3"
  local paths_only="$4"
  local root
  root="$(ghq root)"

  if [[ -n "$ignore_charter_arg" ]]; then
    ignore_charter="$ignore_charter_arg"
  else
    ignore_charter=0
    [[ "$(git config --bool local.status-ignore-charter-outdated 2>/dev/null)" == "true" ]] && ignore_charter=1
  fi

  local charter_repo
  charter_repo="$(ghq list -p 2>/dev/null | grep -iE '/dev-charter$' | head -1)"
  charter_latest=""
  # ローカルの checkout 中ブランチではなく main の VERSION を基準にする
  [[ -n "$charter_repo" ]] && charter_latest="$(git -C "$charter_repo" show main:VERSION 2>/dev/null)"
  # DEV-CHARTER 列は charter_latest（main の VERSION）より古い場合のみ赤くする。
  # lite ブランチは publish-lite.yml が main とは独立したタイミングで VERSION を
  # 打ち直すため、lite 導入先の VERSION が main より新しくなることがある
  # （その場合は要更新ではないので赤くしない、単純な不一致判定にはしない）

  typeset -a all_groups all_repo_names all_branches all_statuses all_brs all_charters all_keeps all_bases all_protected all_policy_ok all_paths
  typeset -a repo_list worker_pids
  repo_list=("${(@f)$(ghq list -p | sort -fV | grep -iE -- "$filter")}")

  local jobs="${GHQ_STATUS_JOBS:-8}"
  [[ "$jobs" =~ ^[1-9][0-9]*$ ]] || { print -u2 "error: GHQ_STATUS_JOBS must be a positive integer"; return 1; }

  local tmp_base="${TMPDIR:-/tmp}"
  tmp_base="${tmp_base%/}"
  _GHQ_STATUS_TMP_PREFIX="$tmp_base/ghq-status."
  _GHQ_STATUS_TMP_DIR="$(mktemp -d "${_GHQ_STATUS_TMP_PREFIX}XXXXXX")" || return 1
  trap '_cleanup_status_tmp; exit 130' HUP INT TERM
  trap _cleanup_status_tmp EXIT

  local i repo pid
  for (( i = 1; i <= ${#repo_list}; i++ )); do
    repo="${repo_list[$i]}"
    _collect_repo "$repo" "$root" > "$_GHQ_STATUS_TMP_DIR/$i" &
    worker_pids+=("$!")
    if (( ${#worker_pids} >= jobs )); then
      for pid in "${worker_pids[@]}"; do wait "$pid" || return 1; done
      worker_pids=()
    fi
  done
  for pid in "${worker_pids[@]}"; do wait "$pid" || return 1; done

  local group repo_name branch status_str br_str charter_ver keep_val expected_br is_protected policy_ok repo_path
  for (( i = 1; i <= ${#repo_list}; i++ )); do
    {
      IFS= read -r -d $'\0' group
      IFS= read -r -d $'\0' repo_name
      IFS= read -r -d $'\0' branch
      IFS= read -r -d $'\0' status_str
      IFS= read -r -d $'\0' br_str
      IFS= read -r -d $'\0' charter_ver
      IFS= read -r -d $'\0' keep_val
      IFS= read -r -d $'\0' expected_br
      IFS= read -r -d $'\0' is_protected
      IFS= read -r -d $'\0' policy_ok
      IFS= read -r -d $'\0' repo_path
    } < "$_GHQ_STATUS_TMP_DIR/$i"
    all_groups+=("$group")
    all_repo_names+=("$repo_name")
    all_branches+=("$branch")
    all_statuses+=("$status_str")
    all_brs+=("$br_str")
    all_charters+=("$charter_ver")
    all_keeps+=("$keep_val")
    all_bases+=("$expected_br")
    all_protected+=("$is_protected")
    all_policy_ok+=("$policy_ok")
    all_paths+=("$repo_path")
  done
  _cleanup_status_tmp
  trap - EXIT HUP INT TERM

  if [[ "$show_all" != 1 || "$paths_only" == 1 ]]; then
    typeset -a q_groups q_repo_names q_branches q_statuses q_brs q_charters q_keeps q_bases q_protected q_policy_ok q_paths
    for (( i = 1; i <= ${#all_groups}; i++ )); do
      _is_quiet_row "${all_statuses[$i]}" "${all_brs[$i]}" "${all_charters[$i]}" "${all_protected[$i]}" "${all_bases[$i]}" "${all_policy_ok[$i]}" && continue
      q_groups+=("${all_groups[$i]}")
      q_repo_names+=("${all_repo_names[$i]}")
      q_branches+=("${all_branches[$i]}")
      q_statuses+=("${all_statuses[$i]}")
      q_brs+=("${all_brs[$i]}")
      q_charters+=("${all_charters[$i]}")
      q_keeps+=("${all_keeps[$i]}")
      q_bases+=("${all_bases[$i]}")
      q_protected+=("${all_protected[$i]}")
      q_policy_ok+=("${all_policy_ok[$i]}")
      q_paths+=("${all_paths[$i]}")
    done
    all_groups=("${q_groups[@]}")
    all_repo_names=("${q_repo_names[@]}")
    all_branches=("${q_branches[@]}")
    all_statuses=("${q_statuses[@]}")
    all_brs=("${q_brs[@]}")
    all_charters=("${q_charters[@]}")
    all_keeps=("${q_keeps[@]}")
    all_bases=("${q_bases[@]}")
    all_protected=("${q_protected[@]}")
    all_policy_ok=("${q_policy_ok[@]}")
    all_paths=("${q_paths[@]}")
  fi

  if [[ "$paths_only" == 1 ]]; then
    local p
    for p in "${all_paths[@]}"; do
      printf '%s\n' "$p"
    done
    return 0
  fi

  local term_width=${COLUMNS:-$(tput cols 2>/dev/null || echo 80)}

  typeset -a seen_groups
  for (( i = 1; i <= ${#all_groups}; i++ )); do
    (( ${seen_groups[(Ie)${all_groups[$i]}]} )) || seen_groups+=("${all_groups[$i]}")
  done

  typeset -a g_names g_branches g_statuses g_brs g_charters g_keeps g_bases g_policy_ok g_protected
  local w_repo w_repo_max w_branch w_status w_br w_charter w_keep w_repo_expanded
  local r1 r2 r3 r4 r5 r6 g j

  for g in "${seen_groups[@]}"; do
    g_names=(); g_branches=(); g_statuses=(); g_brs=(); g_charters=(); g_keeps=(); g_bases=(); g_policy_ok=(); g_protected=()
    w_repo=4; w_branch=6; w_status=10; w_br=8; w_charter=11; w_keep=4

    for (( i = 1; i <= ${#all_groups}; i++ )); do
      [[ "${all_groups[$i]}" != "$g" ]] && continue
      g_names+=("${all_repo_names[$i]}")
      g_branches+=("${all_branches[$i]}")
      g_statuses+=("${all_statuses[$i]}")
      g_brs+=("${all_brs[$i]}")
      g_charters+=("${all_charters[$i]}")
      g_keeps+=("${all_keeps[$i]}")
      g_bases+=("${all_bases[$i]}")
      g_policy_ok+=("${all_policy_ok[$i]}")
      g_protected+=("${all_protected[$i]}")
      (( ${(m)#all_repo_names[$i]} > w_repo    )) && w_repo=${(m)#all_repo_names[$i]}
      (( ${(m)#all_branches[$i]}   > w_branch  )) && w_branch=${(m)#all_branches[$i]}
      (( ${(m)#all_statuses[$i]}   > w_status  )) && w_status=${(m)#all_statuses[$i]}
      (( ${(m)#all_brs[$i]}        > w_br      )) && w_br=${(m)#all_brs[$i]}
      (( ${(m)#all_charters[$i]}   > w_charter )) && w_charter=${(m)#all_charters[$i]}
      (( ${(m)#all_keeps[$i]}      > w_keep    )) && w_keep=${(m)#all_keeps[$i]}
    done

    w_repo_max=$w_repo
    (( w_repo > 20 )) && w_repo=20
    w_repo_expanded=$(( term_width - 19 - w_branch - w_status - w_br - w_charter - w_keep ))
    (( w_repo_expanded > w_repo )) && w_repo=$(( w_repo_expanded < w_repo_max ? w_repo_expanded : w_repo_max ))
    r1="$(_rule $(( w_repo    + 2 )) '─')"
    r2="$(_rule $(( w_branch  + 2 )) '─')"
    r3="$(_rule $(( w_status  + 2 )) '─')"
    r4="$(_rule $(( w_br      + 2 )) '─')"
    r5="$(_rule $(( w_charter + 2 )) '─')"
    r6="$(_rule $(( w_keep    + 2 )) '─')"

    printf '%s\n' "${g//\// / }"
    printf '┌%s┬%s┬%s┬%s┬%s┬%s┐\n' "$r1" "$r2" "$r3" "$r4" "$r5" "$r6"
    _header 'REPO' 'BRANCH' 'GIT STATUS' 'BRANCHES' 'DEV-CHARTER' 'KEEP'
    printf '├%s┼%s┼%s┼%s┼%s┼%s┤\n' "$r1" "$r2" "$r3" "$r4" "$r5" "$r6"

    for (( j = 1; j <= ${#g_names}; j++ )); do
      _row "${g_names[$j]}" "${g_branches[$j]}" "${g_statuses[$j]}" "${g_brs[$j]}" "${g_charters[$j]}" "${g_keeps[$j]}" "${g_bases[$j]}" "${g_policy_ok[$j]}" "${g_protected[$j]}"
      if (( j < ${#g_names} )); then
        printf '├%s┼%s┼%s┼%s┼%s┼%s┤\n' "$r1" "$r2" "$r3" "$r4" "$r5" "$r6"
      fi
    done

    printf '└%s┴%s┴%s┴%s┴%s┴%s┘\n' "$r1" "$r2" "$r3" "$r4" "$r5" "$r6"
    printf '\n'
  done
}

FILTER=''
SHOW_ALL=0
IGNORE_CHARTER=''
PATHS_ONLY=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    -f|--filter)
      (( $# < 2 )) && { print -u2 "error: --filter requires an argument"; exit 1; }
      FILTER="$2"; shift 2 ;;
    -a|--all)  SHOW_ALL=1; shift ;;
    -p|--paths-only) PATHS_ONLY=1; shift ;;
    --ignore-charter-outdated)    IGNORE_CHARTER=1; shift ;;
    --no-ignore-charter-outdated) IGNORE_CHARTER=0; shift ;;
    -h|--help) sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *)         print -u2 "error: unknown option: $1"; exit 1 ;;
  esac
done

main "$FILTER" "$SHOW_ALL" "$IGNORE_CHARTER" "$PATHS_ONLY"
