#!/usr/bin/env bash
set -euo pipefail

# dockutil がなければスキップ
command -v dockutil &>/dev/null || exit 0

# dotfiles の場所はこのフックの位置（git/hooks-private/）から解決する。
# リポジトリのパスから導出すると、worktree など別パスにある private repo で壊れる。
DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

# dock-cache を更新
bash "${DOTFILES_DIR}/macos/update_dockcache.sh" 2>/dev/null || true

# dock diff チェック（警告のみ・ブロックしない）
if ! bash "${DOTFILES_DIR}/macos/diff_dockfile.sh" 2>/dev/null; then
  echo "⚠️  dockfile と現在の Dock に差分があります。" >&2
  echo "    dots dock sync を実行することを検討してください。" >&2
fi
exit 0
