# ホスト固有設定（ローカルのみ）
host/*
!host/.gitignore

# Private Gist 取得用の認証情報
scripts/.env

# Claude Code プロジェクトローカル設定
.claude/

# Antigravity が生成するプロジェクトローカル MCP 設定
.agents/mcp_config.json

# グローバル gitignore の [Bb]in/ を上書き除外
!bin/

# macOS
.DS_Store
macos/Brewfile.local
macos/Brewfile.cache
npm/npmfile.cache
pipx/pipxfile.cache

# バックアップファイル
*.backup.*
