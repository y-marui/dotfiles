#compdef obsidian-project-home

_obsidian-project-home() {
  local -a options
  options=(
    'check:validate every Project Home mapping'
    'ensure:resolve, or create a stub Project Home for an allowed owner'
    '--repo=[repository directory]:directory:_files -/'
    '--vault=[Obsidian Vault directory]:directory:_files -/'
    '--description=[description for a created Project Home]:text:'
    '(-h --help)'{-h,--help}'[show help]'
  )
  _arguments -S $options
}

_obsidian-project-home "$@"
