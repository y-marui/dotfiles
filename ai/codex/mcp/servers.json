[
  {
    "name": "github",
    "type": "http",
    "url": "https://api.githubcopilot.com/mcp/",
    "headers": {
      "Authorization": {
        "cmd": ["gh", "auth", "token"],
        "prefix": "Bearer "
      }
    }
  },
  {
    "name": "github-copilot",
    "type": "http",
    "url": "https://api.githubcopilot.com/mcp/x/copilot",
    "headers": {
      "Authorization": {
        "cmd": ["gh", "auth", "token"],
        "prefix": "Bearer "
      }
    }
  },
  {
    "name": "claude-code",
    "type": "stdio",
    "command": "claude",
    "args": ["mcp", "serve"]
  }
]
