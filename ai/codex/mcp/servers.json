[
  {
    "name": "github",
    "type": "http",
    "url": "https://api.githubcopilot.com/mcp/",
    "headers": {
      "Authorization": {
        "cmd": ["gh", "auth", "token"],
        "prefix": "Bearer "
      }
    }
  },
  {
    "name": "github-copilot",
    "type": "http",
    "url": "https://api.githubcopilot.com/mcp/x/copilot",
    "headers": {
      "Authorization": {
        "cmd": ["gh", "auth", "token"],
        "prefix": "Bearer "
      }
    }
  },
  {
    "name": "claude-code",
    "type": "stdio",
    "command": "claude",
    "args": ["mcp", "serve"]
  },
  {
    "name": "computer-use",
    "type": "stdio",
    "command": "./Codex Computer Use.app/Contents/SharedSupport/SkyComputerUseClient.app/Contents/MacOS/SkyComputerUseClient",
    "args": ["mcp"]
  },
  {
    "name": "openaiDeveloperDocs",
    "type": "http",
    "url": "https://developers.openai.com/mcp"
  },
  {
    "name": "raindrop",
    "type": "stdio",
    "command": "npx",
    "args": [
      "-y",
      "mcp-remote",
      "https://api.raindrop.io/rest/v2/ai/mcp"
    ]
  }
]
