{
  "agentPushNotifEnabled": true,
  "defaultMode": "plan",
  "enabledPlugins": {
    "commit-commands@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "${DOTFILES_DIR}/scripts/run_quiet_hook.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ]
  },
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Bash(diff:*)",
      "Bash(find:*)",
      "Bash(gh:*)",
      "Bash(git-sweep:*)",
      "Bash(git:*)",
      "Bash(grep:*)",
      "Bash(make:*)",
      "Bash(pandoc:*)",
      "Bash(pre-commit:*)",
      "Bash(run-quiet gh:*)",
      "Bash(run-quiet git:*)",
      "Bash(run-quiet make:*)",
      "Bash(run-quiet pre-commit:*)",
      "Bash(run-quiet shellcheck:*)",
      "Bash(shellcheck:*)",
      "Bash(wait)",
      "Bash(which:*)",
      "Skill(commit-commands:commit-push-pr:*)",
      "Skill(commit-commands:commit:*)",
      "Skill(pr-review-toolkit:review-pr)",
      "Skill(update-config)",
      "WebSearch",
      "mcp__github__issue_read",
      "mcp__github__pull_request_read"
    ]
  },
  "statusLine": {
    "command": "$HOME/.claude/hooks/status.sh",
    "type": "command"
  },
  "theme": "light",
  "tui": "fullscreen"
}
