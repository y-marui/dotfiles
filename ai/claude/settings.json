{
  "agentPushNotifEnabled": true,
  "defaultMode": "plan",
  "enabledPlugins": {
    "commit-commands@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "${DOTFILES_DIR}/scripts/run_quiet_hook.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ]
  },
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Bash(diff:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(pandoc:*)",
      "Bash(run-quiet diff:*)",
      "Bash(run-quiet find:*)",
      "Bash(run-quiet grep:*)",
      "Bash(run-quiet pandoc:*)",
      "Bash(run-quiet wait:*)",
      "Bash(run-quiet which:*)",
      "Bash(wait:*)",
      "Bash(which:*)",
      "WebSearch"
    ]
  },
  "statusLine": {
    "command": "$HOME/.claude/hooks/status.sh",
    "type": "command"
  },
  "theme": "light",
  "tui": "fullscreen"
}
