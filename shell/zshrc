# 10. ツール初期化
# --------------------------------------------------------

# pyenv                                                   # [共通]
if command -v pyenv > /dev/null; then                     # [共通]
  eval "$(pyenv init - zsh)"                              # [共通]
fi                                                        # [共通]

# rbenv                                                   # [共通]
if command -v rbenv > /dev/null; then                     # [共通]
  eval "$(rbenv init -)"                                  # [共通]
fi                                                        # [共通]

# plenv                                                   # [共通]
if command -v plenv > /dev/null; then                     # [共通]
  eval "$(plenv init -)"                                  # [共通]
fi                                                        # [共通]

# gh CLI 補完
if command -v gh &>/dev/null; then
  eval "$(gh completion -s zsh)"
fi

# --------------------------------------------------------
# 11. Powerlevel10k テーマ
# --------------------------------------------------------
[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh

# --------------------------------------------------------
# 12. ローカル設定（シークレット等 → ~/.zshrc.local に記載）
# --------------------------------------------------------
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

# --------------------------------------------------------
# 13. ホスト固有設定（$DOTFILES_DIR/host/<hostname>.zsh）（.zshrc.local で DOTFILES_DIR が確定した後）
# --------------------------------------------------------
[[ -f "$DOTFILES_DIR/host/$(hostname -s).zsh" ]] && \
  source "$DOTFILES_DIR/host/$(hostname -s).zsh"

# --------------------------------------------------------
# 14. dots check のLaunchAgentキャッシュを表示
# 外部コマンドを実行せず、シェル起動をブロックしない。
# --------------------------------------------------------
_dots_check_summary="${XDG_CACHE_HOME:-$HOME/.cache}/dots/check-summary"
if [[ -s "${_dots_check_summary}" ]]; then
  while IFS= read -r _dots_check_line; do
    print -r -- $'\e[33m'"${_dots_check_line}"$'\e[39m'
  done < "${_dots_check_summary}"
fi
unset _dots_check_summary _dots_check_line

# --------------------------------------------------------
# 15. iTerm2 Shell Integration
# --------------------------------------------------------
# iTerm2 Shell Integration は iTerm2 直下のシェルだけで読み込む。
# Zellij 内では Zellij と Powerlevel10k が端末描画を管理するため、iTerm2 の
# prompt hook / OSC 制御シーケンスを重ねるとプロンプトが重複描画される。
if [[ "$TERM_PROGRAM" == "iTerm.app" && -z "$ZELLIJ" ]]; then
  if [[ -f ~/.iterm2_shell_integration.zsh ]]; then
    source ~/.iterm2_shell_integration.zsh
  else
    echo "Install Shell Integration on iTerm2."
  fi
fi
