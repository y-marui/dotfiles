# 5. zsh オプション
# --------------------------------------------------------
setopt IGNOREEOF # Ctrl+D でのログアウトを防ぐ

# --------------------------------------------------------
# 6. bash 形式の補完を有効化
# --------------------------------------------------------
autoload -Uz colors && colors
if (( $+functions[compdef] )); then
  autoload -U bashcompinit && bashcompinit
fi

# --------------------------------------------------------
# 7. sshz コマンド（Zellij 統合 SSH、Zellij 内のみ有効）
# --------------------------------------------------------
# Zellij 内で sshz を実行すると新しいペイン/タブを作成して SSH を起動する。
# 接続先ではデフォルトで zellij auto-attach（NO_ZELLIJ='' を渡す）。
# デフォルトは新規タブで開く。
# --same: 現在のタブに縦分割ペインで開く。
# --no-zellij: 接続先の zellij auto-attach を無効化（NO_ZELLIJ=1 を渡す）。
# iTerm2 の場合は osascript でタブ/ペインを開く。それ以外は Zellij コマンドを使う。
if [[ -n "$ZELLIJ" ]]; then
  function sshz() {
    local new_tab=true
    local no_zellij=false
    local args=()
    for arg in "$@"; do
      case "$arg" in
        --new)       new_tab=true ;;
        --same)      new_tab=false ;;
        --no-zellij) no_zellij=true ;;
        *)           args+=("$arg") ;;
      esac
    done

    local no_zellij_env="NO_ZELLIJ=''"
    $no_zellij && no_zellij_env="NO_ZELLIJ=1"

    # ホスト名を探し、リモートコマンドの有無を判定する
    # 値を取る SSH オプション: -b -c -D -E -e -F -I -i -J -L -l -m -o -p -Q -R -S -W -w
    local skip_next=false
    local host=""
    local has_remote_cmd=false
    for arg in "${args[@]}"; do
      if $skip_next; then
        skip_next=false
        continue
      fi
      if [[ "$arg" == -[bcDEeFIiJLlmopQRSWw] ]]; then
        skip_next=true
        continue
      fi
      [[ "$arg" == -* ]] && continue
      if [[ -z "$host" ]]; then
        host="$arg"
      else
        has_remote_cmd=true
        break
      fi
    done

    # リモートコマンドあり → インタラクティブではないので直接実行
    if $has_remote_cmd; then
      command ssh "${args[@]}"
      return
    fi

    # zellij action new-tab/run が作るペインは呼び出し元の $TERM を継承しないことがあり、
    # 空のTERMがそのままSSH先へ転送されてプロンプト等が壊れるため明示的に渡す。
    local cmd="env $no_zellij_env TERM=${TERM:-xterm-256color} command ssh$(printf ' %q' "${args[@]}")"

    if [[ "$TERM_PROGRAM" == "iTerm.app" ]]; then
      if $new_tab; then
        osascript <<EOF
tell application "iTerm2"
  tell current window
    create tab with profile "No Zellij"
    tell current session
      write text "$cmd; exit"
    end tell
  end tell
end tell
EOF
      else
        osascript <<EOF
tell application "iTerm2"
  tell current session of current window
    set newSession to (split vertically with profile "No Zellij")
  end tell
  tell newSession
    write text "$cmd; exit"
  end tell
end tell
EOF
      fi
    else
      if $new_tab; then
        zellij action new-tab --name "ssh:${host}" --close-on-exit -- sh -c "$cmd"
      else
        zellij run --name "ssh:${host}" --close-on-exit -- sh -c "$cmd"
      fi
    fi
  }

  # sshz のカスタムオプション補完（既存の _ssh 補完に追加）
  function _sshz() {
    local -a wrapper_opts
    wrapper_opts=(
      '--new:新規タブで接続する（デフォルト）'
      '--same:現在のタブに縦分割ペインで接続する'
      '--no-zellij:接続先でZellijを自動起動しない'
    )

    # ラッパーオプション自体の補完
    _describe -t sshz-opts 'sshz options' wrapper_opts

    # 現在のワードがオプションなら _ssh への委譲はしない
    [[ "${words[CURRENT]}" == --* ]] && return

    # _ssh にカスタムフラグを見せないよう除外し、words[1] を ssh に置き換えて委譲
    local -a filtered_words=('ssh')
    local i new_current=1
    for (( i=2; i<=${#words[@]}; i++ )); do
      if [[ "${words[$i]}" != --new && "${words[$i]}" != --same && "${words[$i]}" != --no-zellij ]]; then
        filtered_words+=("${words[$i]}")
        [[ $i -le $CURRENT ]] && (( new_current++ ))
      fi
    done
    words=("${filtered_words[@]}")
    CURRENT=$new_current
    service=ssh _ssh
  }
  compdef _sshz sshz
fi

# --------------------------------------------------------
# 8. エイリアス
# --------------------------------------------------------
if [[ "$OSTYPE" == darwin* ]]; then
  alias ls='/bin/ls -G'    # macOS: 色つき表示
else
  alias ls='ls --color=auto'  # Linux（GNU coreutils）: 色つき表示（-G は意味が違うため使わない）
fi
# pyenv と brew の PATH 衝突回避 + Brewfile.cache 自動更新
function brew() {
  local brewfile_pin="$DOTFILES_DIR/macos/Brewfile-pin"
  local pinned_packages=""
  local pin_diff=""
  local brew_status=0
  if [[ -f "$brewfile_pin" ]]; then
    pinned_packages="$(sed -nE 's/^(brew|cask) "([^"]+)".*/\2/p' "$brewfile_pin" | paste -sd ',' -)"
  fi
  if [[ -n "$pinned_packages" ]]; then
    print -P "%F{yellow}⚠ brew: 一時的なpinが有効です: ${pinned_packages} (dots brew diff で確認)%f" >&2
  fi
  pin_diff="$(bash "$DOTFILES_DIR/macos/diff_brewpin.sh" --summary 2>/dev/null || true)"
  if [[ -n "$pin_diff" ]]; then
    print -P "%F{yellow}⚠ brew pin: ${pin_diff} (dots brew apply で同期)%f" >&2
  fi

  env PATH="${PATH//${PYENV_ROOT}/bin:/}" brew "$@" || brew_status=$?
  [[ $brew_status -eq 0 ]] || return "$brew_status"
  case "${1:-}" in
    install|uninstall|tap|untap|upgrade)
      bash "$DOTFILES_DIR/macos/update_brewcache.sh" 2>/dev/null || true
      bash "$DOTFILES_DIR/macos/update_brewpin_cache.sh" 2>/dev/null || true
      ;;
    pin|unpin)
      bash "$DOTFILES_DIR/macos/update_brewpin_cache.sh" 2>/dev/null || true
      ;;
  esac
}

# npm グローバルパッケージ操作時に npmfile.cache 自動更新
function npm() {
  command npm "$@"
  case "$1" in
    install|uninstall|update)
      if [[ "${2:-}" == "-g" || "${2:-}" == "--global" ]]; then
        bash "$DOTFILES_DIR/npm/update_npmcache.sh" 2>/dev/null || true
      fi
      ;;
  esac
}

# --------------------------------------------------------
# 9. カスタム関数
# --------------------------------------------------------

# ghq のビルトインサブコマンドにないものは、PATH 上の ghq-<sub>
# （bin/unix の ghq-check 等）に git 的な流儀でディスパッチする。
function ghq() {
  case "$1" in
    get|clone|list|rm|root|create|migrate|help|h|"")
      command ghq "$@";;
    *)
      if command -v "ghq-$1" > /dev/null 2>&1; then
        local sub="$1"
        shift
        "ghq-$sub" "$@"
      else
        command ghq "$@"
      fi;;
  esac
}

# ghq + fzf でリポジトリ移動
compdef _g g
function g() {
  case "$1" in
    root)
      git config ghq.root;;
    *)
      local target
      target="$(ghq list -p | sort -fV | fzf)"
      echo "$target"
      if [ -n "$target" ]; then
        cd "$target"
        local _survey
        _survey=$(git-survey 2>/dev/null) || true
        if [[ -n "$_survey" ]]; then
          echo
          echo "$_survey"
        fi
        local _missing=()
        while IFS= read -r _f; do
          [[ -e "${_f%.example}" ]] || _missing+=("${_f%.example}")
        done < <(git ls-files | grep '^[^/]*\.example$' 2>/dev/null)
        if [[ ${#_missing[@]} -gt 0 ]]; then
          echo
          echo "Missing (*.example exists but * does not):"
          printf '  %s\n' "${_missing[@]}"
        fi
      fi;;
  esac
}
function _g() { _values '' 'root' }

# cd 後に自動で ls
# .claude/ があるディレクトリへ移動した場合は permissions の整理要否も通知する
# （claude-perms は bin/unix、実際の整理・移管はユーザーが判断してコマンドを実行する）
function cd() {
  builtin cd "$@" && ls
  local cd_status=$?
  if [[ $cd_status -eq 0 && -d .claude ]] && (( $+commands[claude-perms] )); then
    claude-perms check .
  fi
  return $cd_status
}

# ディレクトリによって code / code-insiders を切り替え
function code() {
  local target
  target="$(pwd)"
  if [[ -n "$1" ]]; then
    target="$(builtin cd "$1"; pwd)"
  fi
  if [[ "$target" =~ "$(ghq root)/github.com/y-muen/*" ]]; then
    command code-insiders "$@"
  else
    command code "$@"
  fi
}

# pip は禁止: pipx（コマンド）または uv（開発）を使う
function pip() {
  echo "pip は使用禁止です。pipx または uv を使ってください。" >&2
  return 1
}

# git commit/push 等での --no-verify は禁止: フックのエラーは修正すること。
# -n は commit のときだけ --no-verify の短縮形（push の -n は --dry-run、
# log/merge の -n は別の意味）なので、commit サブコマンド限定で拾う。
# 注: フルパス（/usr/bin/git 等）や IDE 統合からの呼び出しはこの関数を経由
# しないため回避され得る。強制力の本体ではなく、うっかり防止のためのもの。
function git() {
  if [[ "$1" == "commit" ]]; then
    local arg
    for arg in "${@:2}"; do
      case "$arg" in
        --) break ;;
        --no-verify|-n)
          echo "git commit --no-verify は使用禁止です。フックのエラーは修正してください。" >&2
          return 1
          ;;
      esac
    done
  fi
  local arg
  for arg in "$@"; do
    if [[ "$arg" == "--no-verify" ]]; then
      echo "git --no-verify は使用禁止です。フックのエラーは修正してください。" >&2
      return 1
    fi
  done
  command git "$@"
}

# claude-rc: リモートで claude remote-control を起動
# デスクトップの ghq リポジトリを fzf で選択し、
# リモートの zellij 新タブで claude remote-control を起動する。
#
# 使い方: claude-rc <hostname> [-w|-s|--session]
#   (なし)          same-dir モード（デフォルト）
#   -w, --worktree  worktree モード
#   -s, --session   session モード（1セッションのみ）
function claude-rc() {
  local host="${1:?Usage: claude-rc <hostname> [-w|--worktree] [-s|--session]}"
  local spawn="same-dir"

  case "${2:-}" in
    -w|--worktree) spawn="worktree" ;;
    -s|--session)  spawn="session"  ;;
  esac

  local target session
  target="$(ssh "$host" "zsh -lc 'ghq list --full-path'" 2>/dev/null | sort -fV | fzf --prompt="claude-rc [$host]> ")"
  [[ -z "$target" ]] && return

  session="$(ssh "$host" "hostname -s")"
  local name="claude:$(basename "$target")"
  [[ "$spawn" != "same-dir" ]] && name="$name[$spawn]"

  ssh "$host" "zellij --session '$session' action new-tab \
    --name '$name' \
    --cwd '$target' \
    -- claude remote-control --spawn='$spawn'"
}

function _claude-rc() {
  _arguments \
    '1:hostname:_ssh_hosts' \
    '2:spawn mode:((-w\:worktree\ mode -s\:session\ mode --worktree\:worktree\ mode --session\:session\ mode))'
}
compdef _claude-rc claude-rc

function claude() {
  git rev-parse --git-dir > /dev/null 2>&1 && git pull
  command claude "$@"
  git rev-parse --git-dir > /dev/null 2>&1 && git-sweep
}

