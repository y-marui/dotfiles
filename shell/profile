# ~/.profile / shell/profile
# sh 互換構文のみ。全シェル（zsh/bash）共通の環境変数・PATH。
# shellcheck shell=sh

# --------------------------------------------------------
# DOTFILES_DIR（bash / zsh 共通）
# --------------------------------------------------------
export DOTFILES_DIR="${DOTFILES_DIR:-${HOME}/dotfiles}"

# --------------------------------------------------------
# Editors / Pager
# --------------------------------------------------------
export EDITOR='vim'
export VISUAL='vim'
export PAGER='less'

# --------------------------------------------------------
# Language
# --------------------------------------------------------
export LANG='ja_JP.UTF-8'

# --------------------------------------------------------
# Less
# --------------------------------------------------------
export LESS='-R'
if [ -x "$(command -v src-hilite-lesspipe.sh)" ]; then
  export LESSOPEN="| src-hilite-lesspipe.sh %s"
fi

# --------------------------------------------------------
# Python (pyenv)
# --------------------------------------------------------
export PYENV_ROOT="$HOME/.pyenv"
export PYENV_VIRTUALENV_DISABLE_PROMPT=1
export PYTHONPYCACHEPREFIX="$HOME/.config/pycache"
export PIP_REQUIRE_VIRTUALENV=true

# --------------------------------------------------------
# PATH
# --------------------------------------------------------
export PATH="$HOME/.rbenv/shims:$PATH"
export PATH="$HOME/.nodebrew/current/bin:$PATH"

# dotfiles-managed commands (including the pinned Zellij) take precedence over
# Homebrew and manually installed system binaries.
export PATH="$HOME/.local/bin:$HOME/.local/bin/dotfiles:$PATH"

# --------------------------------------------------------
# macOS / private / machine-local overrides
# --------------------------------------------------------
# macOS共通のPATH・コンパイラ設定は public の `macos/profile` からリンクする。
# 個人設定は dotfiles-private から ~/.profile.private へリンクする。
# shellcheck disable=SC1091
[ -r "$HOME/.profile.macos" ] && . "$HOME/.profile.macos"
# shellcheck disable=SC1091
[ -r "$HOME/.profile.private" ] && . "$HOME/.profile.private"
# shellcheck disable=SC1091
[ -r "$HOME/.profile.local" ] && . "$HOME/.profile.local"
